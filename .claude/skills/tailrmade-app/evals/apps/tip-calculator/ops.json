   "comment": "Rounds each share up to the cent so the group never comes up short."
  }
 },
 {
  "tool": "set_socket_value",
  "input": {
   "node_id": "ai-node-6",
   "socket_name": "Code",
   "value": "(bill, tipPercent, people) => {\n  // A non-breaking space keeps each line's height, so the card does not jump when results go.\n  const blank = ' ';\n  const amount = Number(bill);\n  const count = Math.floor(Number(people));\n  if (!(amount > 0)) {\n    return { each: blank, tip: blank, total: blank, note: 'Enter the bill to see the split.' };\n  }\n  if (!(count >= 1)) {\n    return { each: blank, tip: blank, total: blank, note: 'Split it between at least one person.' };\n  }\n  const tip = amount * (Number(tipPercent) || 0) / 100;\n  const total = amount + tip;\n  const each = Math.ceil(Math.round(total / count * 1e6) / 1e4) / 100;\n  const exact = Math.abs(each * count - total) < 0.005;\n  return {\n    each: each.toFixed(2),\n    tip: tip.toFixed(2),\n    total: total.toFixed(2),\n    note: exact ? blank : 'Rounded up to the cent, so everyone pays the same.',\n  };\n}"
  }
 },
