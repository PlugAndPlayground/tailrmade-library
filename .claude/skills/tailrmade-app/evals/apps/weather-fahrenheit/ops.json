   "input": {
    "node_id": "weather-values",
    "socket_name": "Code",
    "value": "(place, forecast, fahrenheit) => {\n  // A non-breaking space keeps each line's height, so the centered page does not move.\n  const blank = ' ';\n  if (!place?.name) {\n    return { title: 'City not found', condition: 'Try another spelling.', temperatureLabel: blank, temperature: blank, feelsLikeLabel: blank, feelsLike: blank, wind: blank };\n  }\n  const { current, current_units: units } = forecast;\n  const degrees = (celsius) => (fahrenheit && celsius != null ? Math.round((celsius * 9 / 5 + 32) * 10) / 10 : celsius);\n  const unit = (name) => (fahrenheit ? '°F' : name ?? '');\n  // Weather codes from the Open-Meteo documentation.\n  const conditions = { 0: 'Clear sky', 1: 'Mainly clear', 2: 'Partly cloudy', 3: 'Overcast', 45: 'Fog', 48: 'Fog', 51: 'Light drizzle', 53: 'Drizzle', 55: 'Heavy drizzle', 56: 'Freezing drizzle', 57: 'Freezing drizzle', 61: 'Light rain', 63: 'Rain', 65: 'Heavy rain', 66: 'Freezing rain', 67: 'Freezing rain', 71: 'Light snow', 73: 'Snow', 75: 'Heavy snow', 77: 'Snow grains', 80: 'Light showers', 81: 'Showers', 82: 'Heavy showers', 85: 'Snow showers', 86: 'Snow showers', 95: 'Thunderstorm', 96: 'Thunderstorm with hail', 99: 'Thunderstorm with hail' };\n  return {\n    title: `${place.country} • ${place.name}`,\n    condition: conditions[current?.weather_code] ?? blank,\n    temperatureLabel: `Temperature (${unit(units?.temperature_2m)})`,\n    temperature: degrees(current?.temperature_2m) ?? blank,\n    feelsLikeLabel: `Feels like (${unit(units?.apparent_temperature)})`,\n    feelsLike: degrees(current?.apparent_temperature) ?? blank,\n    wind: current ? `Wind ${current.wind_speed_10m} ${units?.wind_speed_10m ?? ''}` : blank,\n  };\n}"
   }
  },
