 {
  "tool": "set_node_comment",
  "input": {
   "node_id": "ai-node-9",
   "comment": "Reads the currency from the answer, not the dropdowns, so the page never labels an old rate with a new currency."
  }
 },
 {
  "tool": "set_socket_value",
  "input": {
   "node_id": "ai-node-9",
   "socket_name": "Code",
   "value": "(amount, from, to, answer) => {\n  // A non-breaking space keeps each line's height, so the card does not jump when results go.\n  const blank = ' ';\n  const value = Number(amount);\n  // The sandbox has no locale data, so toLocaleString would not round or group.\n  const format = (number) => number.toFixed(2).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n  const answered = typeof answer?.rates === 'object' && answer.rates !== null;\n  if (from === to) {\n    return { result: value > 0 ? `${format(value)} ${to}` : blank, rate: `1 ${from} = 1 ${to}`, note: value > 0 ? 'Same currency on both sides.' : 'Enter an amount to convert.' };\n  }\n  // The page opens once the first request is done, so no rate here means it failed.\n  if (!answered) {\n    return { result: blank, rate: blank, note: 'Could not get the rate. Press the button to try again.' };\n  }\n  const code = Object.keys(answer.rates)[0];\n  const rate = Number(answer.rates[code]);\n  if (!(rate > 0)) {\n    return { result: blank, rate: blank, note: 'Could not get the rate. Press the button to try again.' };\n  }\n  if (answer.base !== from || code !== to) {\n    return { result: blank, rate: blank, note: `Press the button to get the rate for ${from} to ${to}.` };\n  }\n  return {\n    result: value > 0 ? `${format(value * rate)} ${to}` : blank,\n    rate: `1 ${from} = ${rate} ${to}`,\n    note: value > 0 ? `Rate from ${answer.date ?? 'the latest update'}.` : 'Enter an amount to convert.',\n  };\n}"
  }
 },
