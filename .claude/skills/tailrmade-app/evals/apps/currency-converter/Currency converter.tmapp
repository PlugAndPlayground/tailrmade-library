      {
        "id": "ai-node-7",
        "name": "Rate address",
        "type": "customfunction",
        "x": 390,
        "y": 1485,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(from, to) => {\n  const target = from === to ? (from === 'USD' ? 'EUR' : 'USD') : to;\n  return `https://api.frankfurter.dev/v1/latest?base=${from}&symbols=${target}`;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "from",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "to",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "An HTTP node always sends, so the same currency twice still gets a valid address. The page handles that case without using the answer."
      },
      {
        "id": "ai-node-8",
        "name": "Get the rate",
        "type": "httpnode",
        "x": 1190,
        "y": 2573,
        "width": 160,
        "height": 184,
        "socketArray": [
          {
            "socketType": "in",
            "name": "URL",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "Headers",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {}
          },
          {
            "socketType": "in",
            "name": "Method",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Get\",\"value\":\"Get\"},{\"text\":\"Post\",\"value\":\"Post\"},{\"text\":\"Put\",\"value\":\"Put\"},{\"text\":\"Patch\",\"value\":\"Patch\"},{\"text\":\"Delete\",\"value\":\"Delete\"}],\"showAsButtons\":true}}",
            "data": "Get"
          },
          {
            "socketType": "in",
            "name": "Body",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {},
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Send Through Companion",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false
          },
          {
            "socketType": "trigger",
            "name": "Trigger 1",
            "dataType": "{\"class\":\"TriggerType\"}"
          },
          {
            "socketType": "out",
            "name": "Content",
            "dataType": "{\"class\":\"JSONType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": false,
          "interval": false
        },
        "comment": "Runs when the app opens, then only when you press the button, to stay under the API's rate limit. The address comes from the dropdowns, so it keeps its network warning."
      },
      {
        "id": "ai-node-9",
        "name": "Convert the amount",
        "type": "customfunction",
        "x": 1650,
        "y": 3357,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(amount, from, to, answer) => {\n  // A non-breaking space keeps each line's height, so the card does not jump when results go.\n  const blank = ' ';\n  const value = Number(amount);\n  // The sandbox has no locale data, so toLocaleString would not round or group.\n  const format = (number) => number.toFixed(2).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n  const answered = typeof answer?.rates === 'object' && answer.rates !== null;\n  if (from === to) {\n    return { result: value > 0 ? `${format(value)} ${to}` : blank, rate: `1 ${from} = 1 ${to}`, note: value > 0 ? 'Same currency on both sides.' : 'Enter an amount to convert.' };\n  }\n  // The page opens once the first request is done, so no rate here means it failed.\n  if (!answered) {\n    return { result: blank, rate: blank, note: 'Could not get the rate. Press the button to try again.' };\n  }\n  const code = Object.keys(answer.rates)[0];\n  const rate = Number(answer.rates[code]);\n  if (!(rate > 0)) {\n    return { result: blank, rate: blank, note: 'Could not get the rate. Press the button to try again.' };\n  }\n  if (answer.base !== from || code !== to) {\n    return { result: blank, rate: blank, note: `Press the button to get the rate for ${from} to ${to}.` };\n  }\n  return {\n    result: value > 0 ? `${format(value * rate)} ${to}` : blank,\n    rate: `1 ${from} = ${rate} ${to}`,\n    note: value > 0 ? `Rate from ${answer.date ?? 'the latest update'}.` : 'Enter an amount to convert.',\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "amount",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "from",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "to",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "answer",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Reads the currency from the answer, not the dropdowns, so the page never labels an old rate with a new currency."
      },
      {
        "id": "ai-node-10",
        "name": "Converted amount",
        "type": "text",
        "x": 1950,
        "y": 3357,
        "width": 240,
        "height": 80,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Content",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "{{r.result}}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Variant",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"display\",\"value\":\"display\"},{\"text\":\"h1\",\"value\":\"h1\"},{\"text\":\"h2\",\"value\":\"h2\"},{\"text\":\"h3\",\"value\":\"h3\"},{\"text\":\"body\",\"value\":\"body\"},{\"text\":\"caption\",\"value\":\"caption\"},{\"text\":\"label\",\"value\":\"label\"},{\"text\":\"stat\",\"value\":\"stat\"}],\"showAsButtons\":false}}",
            "data": "h1",
            "visible": false
          },
          {
