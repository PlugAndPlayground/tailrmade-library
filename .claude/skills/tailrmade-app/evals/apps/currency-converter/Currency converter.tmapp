{
  "id": "Default/Currency converter",
  "location": "Default",
  "name": "Currency converter",
  "access": "private",
  "graphData": {
    "version": 7,
    "graphSettings": {
      "showExecutionVisualisation": true,
      "viewportCenterPosition": {
        "x": -694,
        "y": 1918
      },
      "viewportScale": 0.122,
      "defaultUISurfaceNodeId": "ai-node-13",
      "theme": {
        "mode": "dark"
      }
    },
    "overlay": {
      "dashboard": {
        "visible": true,
        "fullscreen": false,
        "maximized": false,
        "widthPercentage": 52,
        "locked": false
      }
    },
    "nodes": [
      {
        "id": "ai-node-1",
        "name": "Start here",
        "type": "label",
        "x": 0,
        "y": 0,
        "width": 2995,
        "height": 285,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1280,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Input",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "This page is a Tailrmade app.\nFollow the numbers: the currencies build an address, the button sends it, and the answer fills the page.\nMain page on the right shows the result."
          },
          {
            "socketType": "in",
            "name": "Font size",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":100,\"stepSize\":1,\"showDetails\":false,\"presetValues\":[{\"text\":\"Small\",\"value\":12},{\"text\":\"Normal\",\"value\":16},{\"text\":\"H5\",\"value\":20},{\"text\":\"H4\",\"value\":24},{\"text\":\"H3\",\"value\":28},{\"text\":\"H2\",\"value\":32},{\"text\":\"H1\",\"value\":40}]}}",
            "data": 64,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Text alignment",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Left\",\"value\":\"left\"},{\"text\":\"Center\",\"value\":\"center\"},{\"text\":\"Right\",\"value\":\"right\"}],\"showAsButtons\":true}}",
            "data": "Left",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Font weight",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Regular\",\"value\":\"400\"},{\"text\":\"Bold\",\"value\":\"700\"}],\"showAsButtons\":true}}",
            "data": "Regular",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Text color",
            "dataType": "{\"class\":\"ColorType\"}",
            "data": {
              "r": 12,
              "g": 12,
              "b": 12,
              "a": 1
