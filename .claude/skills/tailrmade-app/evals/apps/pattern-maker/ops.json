 {
  "tool": "set_socket_value",
  "input": {
   "node_id": "ai-node-6",
   "socket_name": "Code",
   "value": "(petals, rings, twist, theme) => {\n  const rgb = (color, fallback) => {\n    const hex = /^#([0-9a-f]{6})/i.exec(String(color ?? ''));\n    const digits = hex ? hex[1] : fallback;\n    return [0, 2, 4].map((at) => parseInt(digits.slice(at, at + 2), 16) / 255);\n  };\n  const tokens = theme?.tokens ?? {};\n  return {\n    petals: { value: Number(petals) || 2, type: 'f32' },\n    rings: { value: Number(rings) || 1, type: 'f32' },\n    twist: { value: Number(twist) || 0, type: 'f32' },\n    ink: { value: rgb(tokens.primary, '888888'), type: 'vec3<f32>' },\n    accent: { value: rgb(tokens.secondary, 'bbbbbb'), type: 'vec3<f32>' },\n    paper: { value: rgb(tokens['background.paper'], '222222'), type: 'vec3<f32>' },\n  };\n}"
  }
 },
