 {
  "tool": "set_socket_value",
  "input": {
   "node_id": "ai-node-7",
   "socket_name": "WebGL Fragment",
   "value": "in vec2 UV;\nuniform float petals;\nuniform float rings;\nuniform float twist;\nuniform vec3 ink;\nuniform vec3 accent;\nuniform vec3 paper;\n\nvoid main() {\n    vec2 p = UV * 2.0 - 1.0;\n    float radius = length(p);\n    float angle = atan(p.y, p.x) + twist * radius;\n    float wave = sin(angle * petals) * 0.5 + 0.5;\n    float band = sin(radius * rings * 6.2832 + wave * 3.1416) * 0.5 + 0.5;\n    vec3 color = mix(ink, accent, wave);\n    color = mix(paper, color, smoothstep(0.35, 0.65, band));\n    color = mix(color, paper, smoothstep(0.96, 1.0, radius));\n    gl_FragColor = vec4(color, 1.0);\n}\n"
  }
 },
