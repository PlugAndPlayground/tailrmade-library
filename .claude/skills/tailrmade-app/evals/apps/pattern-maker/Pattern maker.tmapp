      {
        "id": "ai-node-6",
        "name": "Shader settings",
        "type": "customfunction",
        "x": 500,
        "y": 2117,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(petals, rings, twist, theme) => {\n  const rgb = (color, fallback) => {\n    const hex = /^#([0-9a-f]{6})/i.exec(String(color ?? ''));\n    const digits = hex ? hex[1] : fallback;\n    return [0, 2, 4].map((at) => parseInt(digits.slice(at, at + 2), 16) / 255);\n  };\n  const tokens = theme?.tokens ?? {};\n  return {\n    petals: { value: Number(petals) || 2, type: 'f32' },\n    rings: { value: Number(rings) || 1, type: 'f32' },\n    twist: { value: Number(twist) || 0, type: 'f32' },\n    ink: { value: rgb(tokens.primary, '888888'), type: 'vec3<f32>' },\n    accent: { value: rgb(tokens.secondary, 'bbbbbb'), type: 'vec3<f32>' },\n    paper: { value: rgb(tokens['background.paper'], '222222'), type: 'vec3<f32>' },\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "petals",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "rings",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "twist",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "theme",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Turns the sliders and the theme's colours into the values the shader reads. The colours update on load, not on a live preset switch."
      },
      {
        "id": "ai-node-7",
        "name": "Pattern picture",
        "type": "shader",
        "x": 1260,
        "y": 2877,
        "width": 160,
        "height": 232,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Uniforms",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "Images",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "in",
            "name": "WebGL Vertex",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "\nin vec2 aPosition;\nin vec2 aUV;\nout vec2 UV;\n\nuniform mat3 uProjectionMatrix;\nuniform mat3 uWorldTransformMatrix;\n\nuniform mat3 uTransformMatrix;\n\n\nvoid main() {\n    mat3 mvp = uProjectionMatrix * uWorldTransformMatrix * uTransformMatrix;\n    gl_Position = vec4((mvp * vec3(aPosition, 1.0)).xy, 0.0, 1.0);\n\n    UV = aUV;\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "WebGL Fragment",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "in vec2 UV;\nuniform float petals;\nuniform float rings;\nuniform float twist;\nuniform vec3 ink;\nuniform vec3 accent;\nuniform vec3 paper;\n\nvoid main() {\n    vec2 p = UV * 2.0 - 1.0;\n    float radius = length(p);\n    float angle = atan(p.y, p.x) + twist * radius;\n    float wave = sin(angle * petals) * 0.5 + 0.5;\n    float band = sin(radius * rings * 6.2832 + wave * 3.1416) * 0.5 + 0.5;\n    vec3 color = mix(ink, accent, wave);\n    color = mix(paper, color, smoothstep(0.35, 0.65, band));\n    color = mix(color, paper, smoothstep(0.96, 1.0, radius));\n    gl_FragColor = vec4(color, 1.0);\n}\n"
          },
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 640
          },
          {
            "socketType": "in",
            "name": "Height",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 640
          },
          {
            "socketType": "in",
            "name": "Angle",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":-180,\"maxValue\":180,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Scale",
            "dataType": "{\"class\":\"TwoDVectorType\"}",
            "data": {
              "x": 1,
              "y": 1
            },
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Offset",
            "dataType": "{\"class\":\"TwoDVectorType\"}",
            "data": {
              "x": 0,
              "y": 0
            },
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Texture",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "out",
            "name": "Graphics",
            "dataType": "{\"class\":\"DeferredPixiType\"}"
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false,
          "intervalFrequency": 16
        },
        "version": 2,
        "comment": "Draws on the GPU, so the app needs no main-thread code and has no risk warning."
      },
