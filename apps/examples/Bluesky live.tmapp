      {
        "id": "ai-node-15",
        "name": "Feed text",
        "type": "customfunction",
        "x": 2520,
        "y": 3045,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(posts, words) => {\n  const watched = String(words ?? '').split(',').map((word) => word.trim()).filter(Boolean);\n  if (watched.length === 0) return 'Type a word to watch.';\n  const shown = (Array.isArray(posts) ? posts : []).filter((post) => post && post.stamp).slice(-12).reverse();\n  if (shown.length === 0) return `Waiting for a post that mentions ${watched.join(', ')} …`;\n  // Post text is read as Markdown, so escape it before marking the words.\n  const escapeMarkdown = (text) => text.replace(/\\s+/g, ' ').replace(/([\\\\`*_{}[\\]()#+\\-.!|<>~])/g, '\\\\$1');\n  const escapePattern = (text) => text.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  return shown\n    .map((post) => {\n      let text = escapeMarkdown(post.text.trim());\n      for (const word of post.words) {\n        text = text.replace(new RegExp(`\\\\b(${escapePattern(escapeMarkdown(word))})\\\\b`, 'gi'), '[$1]{.secondary}');\n      }\n      return `**${post.time} UTC** · [Open on Bluesky](${post.url})\\n${text}`;\n    })\n    .join('\\n\\n');\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "posts",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "words",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Builds Markdown for the Text node: post text is escaped so stray symbols show as written, then the watched words are marked."
      },
