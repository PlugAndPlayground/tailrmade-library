      {
        "id": "ai-node-3",
        "name": "Bluesky posts",
        "type": "websocketnode",
        "x": 340,
        "y": 805,
        "width": 160,
        "height": 208,
        "socketArray": [
          {
            "socketType": "in",
            "name": "URL",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "wss://jetstream2.us-east.bsky.network/subscribe?wantedCollections=app.bsky.feed.post"
          },
          {
            "socketType": "in",
            "name": "Enabled",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "in",
            "name": "Message",
            "dataType": "{\"class\":\"AnyType\"}",
            "data": null
          },
          {
            "socketType": "in",
            "name": "Send",
            "dataType": "{\"class\":\"TriggerType\",\"type\":{\"triggerType\":\"positiveFlank\",\"customFunctionString\":\"sendCurrentMessage\",\"showDetails\":false}}",
            "data": 0
          },
          {
            "socketType": "out",
            "name": "Content",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "out",
            "name": "Connected",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "out",
            "name": "Error",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 2,
        "comment": "Jetstream is a public, keyless feed of everything posted on Bluesky, about 50 posts a second. The URL asks for posts only. Each message runs everything downstream, so keep that part light."
      },
      {
        "id": "ai-node-4",
        "name": "Posts seen",
