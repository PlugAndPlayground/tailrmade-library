      },
      {
        "id": "ai-node-6",
        "name": "Match the words",
        "type": "customfunction",
        "x": 1460,
        "y": 1613,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(message, words) => {\n  // Only new posts count; Jetstream also sends deletes and account events.\n  const record = message?.commit?.record;\n  if (message?.kind !== 'commit' || message.commit.operation !== 'create' || !record?.text) return { stamp: 0 };\n  // Skip posts their authors labelled as adult or graphic.\n  if (record.labels?.values?.length) return { stamp: 0 };\n  const escape = (word) => word.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  const watched = String(words ?? '').split(',').map((word) => word.trim()).filter(Boolean);\n  const found = watched.filter((word) => new RegExp(`\\\\b${escape(word)}\\\\b`, 'i').test(record.text));\n  // stamp only grows, so it can fire the Add triggers downstream; 0 means no match.\n  if (found.length === 0) return { stamp: 0 };\n  return {\n    stamp: message.time_us,\n    time: String(record.createdAt ?? '').slice(11, 19),\n    url: `https://bsky.app/profile/${message.did}/post/${message.commit.rkey}`,\n    text: record.text,\n    words: found,\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "message",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "words",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Runs for every post, in the sandbox. A match carries the post's time_us as stamp, which only grows, so it can fire the Add triggers below."
      },
      {
        "id": "ai-node-7",
        "name": "Match stamp",
        "type": "customfunction",
        "x": 1760,
        "y": 1613,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(match) => Number(match?.stamp) || 0",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "match",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Runs after Match the words has filled the list's Input, so the list always adds the post that matched."
      },
      {
        "id": "ai-node-8",
        "name": "Matching posts",
        "type": "arraystate",
        "x": 2060,
        "y": 1613,
        "width": 160,
        "height": 184,
        "socketArray": [
          {
            "socketType": "in",
            "name": "MaxSize",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":100,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 12
          },
          {
            "socketType": "in",
            "name": "Input",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "State",
            "dataType": "{\"class\":\"ArrayType\"}",
            "data": [],
            "visible": false
          },
          {
            "socketType": "trigger",
            "name": "Add",
            "dataType": "{\"class\":\"TriggerType\",\"type\":{\"triggerType\":\"positiveFlank\",\"customFunctionString\":\"add\",\"showDetails\":false}}"
          },
          {
            "socketType": "trigger",
            "name": "Remove",
            "dataType": "{\"class\":\"TriggerType\",\"type\":{\"triggerType\":\"positiveFlank\",\"customFunctionString\":\"remove\",\"showDetails\":false}}",
            "data": 0
