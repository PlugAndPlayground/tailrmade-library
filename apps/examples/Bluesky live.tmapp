      {
        "id": "ai-node-13",
        "name": "Connection text",
        "type": "customfunction",
        "x": 2520,
        "y": 2829,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(enabled, connected, error) => {\n  if (!enabled) return '[Paused]{.warning} · Switch Live on to reconnect.';\n  if (connected) return '[Live]{.success} · Posts arrive as they are written.';\n  if (error) return '[Not connected]{.error} · Bluesky could not be reached. Switch Live off and on to try again.';\n  return 'Connecting …';\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
