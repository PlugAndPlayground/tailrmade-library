      },
      {
        "id": "ai-node-10",
        "name": "Slow down count",
        "type": "throttledebounce",
        "x": 2520,
        "y": 2661,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "In",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "in",
            "name": "Update",
            "dataType": "{\"class\":\"TriggerType\",\"type\":{\"triggerType\":\"positiveFlank\",\"customFunctionString\":\"updateDebounceFunction\",\"showDetails\":false}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Wait",
            "dataType": "{\"class\":\"NumberType\"}",
            "data": 500,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Max Wait",
            "dataType": "{\"class\":\"NumberType\"}",
            "data": 500,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Leading",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Trailing",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": true,
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Out",
            "dataType": "{\"class\":\"AnyType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "The count changes 50 times a second; twice a second is enough to read."
      },
      {
        "id": "ai-node-11",
        "name": "Count text",
        "type": "customfunction",
        "x": 2820,
        "y": 2661,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(seen, matched) => {\n  // The sandbox has no locale data, so group the digits by hand.\n  const group = (n) => String(Math.round(Number(n) || 0)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n  return `**${group(seen)}** posts seen · **${group(matched)}** matched`;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "seen",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "matched",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-12",
        "name": "Count",
        "type": "text",
        "x": 3200,
        "y": 2661,
        "width": 240,
        "height": 80,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Content",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "Variant",
