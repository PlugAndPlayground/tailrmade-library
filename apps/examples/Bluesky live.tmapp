            "socketType": "out",
            "name": "State",
            "dataType": "{\"class\":\"NumberType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "Counts every message: its Add trigger fires on each arrival."
      },
