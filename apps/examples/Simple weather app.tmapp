      {
        "id": "best-match",
        "name": "Best match",
        "type": "customfunction",
        "x": 1890,
        "y": 840,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(geo) => geo?.results?.[0] ?? { latitude: 0, longitude: 0 }",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "geo",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "The forecast node always sends its request, so a city without a match gets valid coordinates. Weather values then shows \"City not found\" instead of that answer."
      },
      {
        "id": "weather-values",
        "name": "Weather values",
        "type": "customfunction",
        "x": 3558,
        "y": 2603,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(place, forecast) => {\n  // A non-breaking space keeps each line's height, so the centered page does not move.\n  const blank = ' ';\n  if (!place?.name) {\n    return { title: 'City not found', condition: 'Try another spelling.', temperatureLabel: blank, temperature: blank, feelsLikeLabel: blank, feelsLike: blank, wind: blank };\n  }\n  const { current, current_units: units } = forecast;\n  // Weather codes from the Open-Meteo documentation.\n  const conditions = { 0: 'Clear sky', 1: 'Mainly clear', 2: 'Partly cloudy', 3: 'Overcast', 45: 'Fog', 48: 'Fog', 51: 'Light drizzle', 53: 'Drizzle', 55: 'Heavy drizzle', 56: 'Freezing drizzle', 57: 'Freezing drizzle', 61: 'Light rain', 63: 'Rain', 65: 'Heavy rain', 66: 'Freezing rain', 67: 'Freezing rain', 71: 'Light snow', 73: 'Snow', 75: 'Heavy snow', 77: 'Snow grains', 80: 'Light showers', 81: 'Showers', 82: 'Heavy showers', 85: 'Snow showers', 86: 'Snow showers', 95: 'Thunderstorm', 96: 'Thunderstorm with hail', 99: 'Thunderstorm with hail' };\n  return {\n    title: `${place.country} • ${place.name}`,\n    condition: conditions[current?.weather_code] ?? blank,\n    temperatureLabel: `Temperature (${units?.temperature_2m ?? ''})`,\n    temperature: current?.temperature_2m ?? blank,\n    feelsLikeLabel: `Feels like (${units?.apparent_temperature ?? ''})`,\n    feelsLike: current?.apparent_temperature ?? blank,\n    wind: current ? `Wind ${current.wind_speed_10m} ${units?.wind_speed_10m ?? ''}` : blank,\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "place",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "forecast",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
