ocketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Off value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "On value", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Show the pairs", "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3}, {"id": "ai-node-12", "name": "App link", "type": "widgettextfield", "x": 0, "y": 3134, "width": 220, "height": 120, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"StringType\"}", "data": "https://tailrmade.app/?loadGraph=publicUser;;Secret%20Santa;;Default", "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "App link", "visible": false}, {"socketType": "in", "name": "Placeholder", "dataType": "{\"class\":\"StringType\"}", "data": "https://", "visible": false}, {"socketType": "in", "name": "Helper Text", "dataType": "{\"class\":\"StringType\"}", "data": "Links point here. Change it if you share your own copy of this app.", "visible": false}, {"socketType": "in", "name": "Type", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"text\"},{\"text\":\"password\"}],\"showAsButtons\":true}}", "data": "text", "visible": false}, {"socketType": "in", "name": "Multiline", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Rows", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":10,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 3, "visible": false}, {"socketType": "in", "name": "Max Length", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 0, "visible": false}, {"socketType": "in", "name": "Required", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Commit", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"While typing\"},{\"text\":\"Rate limited\"},{\"text\":\"After pause\"},{\"text\":\"Enter or blur\"}],\"showAsButtons\":true}}", "data": "While typing", "visible": false}, {"socketType": "in", "name": "Commit Delay", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":5000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 400, "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "comment": "Where the links point. Change it when the app is published somewhere else, such as your own copy."}, {"id": "ai-node-13", "name": "Make the links", "type": "customfunction", "x": 920, "y": 2350, "width": 160, "height": 208, "socketArray": [{"socketType": "in", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "data": "(draw, greeting, budget, when, showPairs, appAddress) => {\n  // Each link carries only its own envelope, scrambled so a glance\n  // (or a base64 decoder) doesn't spoil it. It isn't encryption.\n  const KEY = 'one-good-gift';\n  const B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-.';\n  const utf8 = (s) => {\n    const out = [];\n    for (let i = 0; i < s.length; i++) {\n      let c = s.charCodeAt(i);\n      if (c >= 0xd800 && c < 0xdc00 && i + 1 < s.length) { c = 0x10000 + ((c - 0xd800) << 10) + (s.charCodeAt(++i) - 0xdc00); }\n      if (c < 0x80) out.push(c);\n      else if (c < 0x800) out.push(0xc0 | (c >> 6), 0x80 | (c & 63));\n      else if (c < 0x10000) out.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));\n      else out.push(0xf0 | (c >> 18), 0x80 | ((c >> 12) & 63), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));\n    }\n    return out;\n  };\n  const seal = (obj) => {\n    const bytes = utf8(JSON.stringify(obj)).map((b, i) => b ^ KEY.charCodeAt(i % KEY.length));\n    let s = '';\n    for (let i = 0; i < bytes.length; i += 3) {\n      const n = (bytes[i] << 16) | ((bytes[i + 1] || 0) << 8) | (bytes[i + 2] || 0);\n      s += B64[(n >> 18) & 63] + B64[(n >> 12) & 63];\n      if (i + 1 < bytes.length) s += B64[(n >> 6) & 63];\n      if (i + 2 < bytes.length) s += B64[n & 63];\n    }\n    return s;\n  };\n  if (!draw || !draw.ok) {\n    const lines = ['**' + ((draw && draw.message) || 'Add names to draw.') + '**'];\n    ((draw && draw.notes) || []).forEach((x) => lines.push('- ' + x));\n    return lines.join('\\n');\n  }\n  const base = String(appAddress || '').trim().split('#')[0];\n  if (!/^https?:\\/\\/\\S+$/i.test(base)) {\n    return '**Paste the app\\'s share link into App link below. It starts with https://**';\n  }\n  const extras = { m: String(greeting || '').trim(), b: String(budget || '').trim(), d: String(when || '').trim() };\n  const lines = ['**\u2713 ' + draw.message + '**'];\n  (draw.notes || []).forEach((x) => lines.push('- ' + x));\n  lines.push('');\n  draw.pairs.forEach((p) => {\n    const url = base + '#santa=' + seal({ v: 1, f: p.from, t: p.to, m: extras.m, b: extras.b, d: extras.d });\n    const text = 'Hi ' + p.from + ', your Secret Santa envelope is here. Open it when nobody is looking: ' + url;\n    const mail = 'mailto:?subject=' + encodeURIComponent('Your Secret Santa envelope') + '&body=' + encodeURIComponent(text);\n    const who = showPairs ? '**' + p.from + '** \u2192 ' + p.to : '**' + p.from + '**';\n    lines.push(who + ' \u00b7 [Link](' + url + ') \u00b7 [Email](' + mail + ')');\n  });\n  return lines.join('\\n');\n}", "visible": false}, {"socketType": "in", "name": "Main Thread", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "draw", "dataType": "{\"class\":\"JSONType\"}"}, {"socketType": "in", "name": "greeting", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "budget", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "when", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "showPairs", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "appAddress", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "OutData", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "visible": false}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3, "comment": "One link per giver. Each link carries only that person's envelope, scrambled so it can't be read at a glance. It isn't encryption."}, {"id": "ai-node-14", "name": "Links to send", "type": "text", "x": 1220, "y": 2350, "width": 240, "height": 80, "socketArray": [{"socketType": "in", "name": "Content", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "Variant", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"display\",\"value\":\"display\"},{\"text\":\"h1\",\"value\":\"h1\"},{\"text\":\"h2\",\"value\":\"h2\"},{\"text\":\"h3\",\"value\":\"h3\"},{\"text\":\"body\",\"value\":\"body\"},{\"text\":\"caption\",\"value\":\"caption\"},{\"text\":\"label\",\"value\":\"label\"},{\"text\":\"stat\",\"value\":\"stat\"}],\"showAsButtons\":false}}", "data": "body", "visible": false}, {"socketType": "in", "name": "Tone", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"default\",\"value\":\"default\"},{\"text\":\"muted\",\"value\":\"muted\"},{\"text\":\"primary\",\"value\":\"primary\"},{\"text\":\"secondary\",\"value\":\"secondary\"},{\"text\":\"success\",\"value\":\"success\"},{\"text\":\"warning\",\"value\":\"warning\"},{\"text\":\"error\",\"value\":\"error\"}],\"showAsButtons\":false}}", "data": "default", "visible": false}, {"socketType": "in", "name": "Alignment", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"left\",\"value\":\"left\"},{\"text\":\"center\",\"value\":\"center\"},{\"text\":\"right\",\"value\":\"right\"},{\"text\":\"justify\",\"value\":\"justify\"}],\"showAsButtons\":false}}", "data": "left", "visible": false}, {"socketType": "in", "name": "Custom styles", "dataType": "{\"class\":\"JSONType\"}", "data": {}, "visible": false}, {"socketType": "out", "name": "Output", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}}, {"id": "ai-node-15", "name": "Envelope in the link", "type": "urlparameter", "x": 0, "y": 3886.0, "width": 160, "height": 136, "socketArray": [{"socketType": "in", "name": "Key", "dataType": "{\"class\":\"StringType\"}", "data": "santa"}, {"socketType": "in", "name": "Default", "dataType": "{\"class\":\"AnyType\"}", "data": ""}, {"socketType": "out", "name": "Value", "dataType": "{\"class\":\"AnyType\"}"}, {"socketType": "out", "name": "Found", "dataType": "{\"class\":\"BooleanType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "comment": "Reads #santa=... from the address. Found switches the page from organizer to envelope."}, {"id": "ai-node-16", "name": "No envelope", "type": "not", "x": 340, "y": 3886.0, "width": 115, "height": 40, "socketArray": [{"socketType": "in", "name": "A", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "Inverted", "dataType": "{\"class\":\"BooleanType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 4}, {"id": "ai-node-17", "name": "Open my envelope", "type": "widgetswitch", "x": 0, "y": 4102.0, "width": 200, "height": 104, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Off value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "On value", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Open my envelope", "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3}, {"id": "ai-node-18", "name": "Open the envelope", "type": "customfunction", "x": 1155, "y": 3854, "width": 160, "height": 232, "socketArray": [{"socketType": "in", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "data": "(sealed, found, opened, preview, greeting, budget, when) => {\n  // Reverses the scrambling in \"Make the links\". Without a link it can show\n  // a preview envelope with example names, built from the organizer's inputs.\n  const KEY = 'one-good-gift';\n  const B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-.';\n  const blank = '\u00a0';\n  const fail = { ok: false, title: 'This envelope is damaged', intro: 'The link may have been cut off when it was copied. Ask the organizer to send it again.', name: blank, details: blank };\n  const show = (e, intro) => {\n    const details = [];\n    if (e.b) details.push('**Budget:** ' + e.b);\n    if (e.d) details.push('**When:** ' + e.d);\n    if (e.m) details.push('', '> ' + e.m.split('\\n').join('\\n> '));\n    return {\n      ok: true,\n      title: 'Hi ' + e.f + ' \ud83c\udf85',\n      intro: intro || 'This envelope is for ' + e.f + ' only. Make sure nobody is looking over your shoulder, then open it.',\n      name: opened ? e.t : '\u00b7 \u00b7 \u00b7',\n      details: details.length ? details.join('\\n') : blank,\n    };\n  };\n  if (!found) {\n    if (!preview) return { ok: false, title: blank, intro: blank, name: blank, details: blank };\n    const sample = { f: 'Alex', t: 'Sam', m: String(greeting || '').trim(), b: String(budget || '').trim(), d: String(when || '').trim() };\n    return show(sample);\n  }\n  try {\n    const s = String(sealed || '').trim();\n    const bytes = [];\n    for (let i = 0; i < s.length; i += 4) {\n      const c = [0, 1, 2, 3].map((k) => (i + k < s.length ? B64.indexOf(s[i + k]) : 0));\n      if (c.some((x) => x < 0)) return fail;\n      const n = (c[0] << 18) | (c[1] << 12) | (c[2] << 6) | c[3];\n      bytes.push((n >> 16) & 255);\n      if (i + 2 < s.length) bytes.push((n >> 8) & 255);\n      if (i + 3 < s.length) bytes.push(n & 255);\n    }\n    const next = (i) => (bytes[i] ^ KEY.charCodeAt(i % KEY.length)) & 63;\n    let text = '';\n    for (let i = 0; i < bytes.length; i++) {\n      const b = bytes[i] ^ KEY.charCodeAt(i % KEY.length);\n      let c;\n      if (b < 0x80) c = b;\n      else if (b < 0xe0) { c = ((b & 31) << 6) | next(++i); }\n      else if (b < 0xf0) { c = (b & 15) << 12; c |= next(++i) << 6; c |= next(++i); }\n      else { c = (b & 7) << 18; c |= next(++i) << 12; c |= next(++i) << 6; c |= next(++i); }\n      text += String.fromCodePoint(c);\n    }\n    const e = JSON.parse(text);\n    if (!e || !e.f || !e.t) return fail;\n    return show(e);\n  } catch (err) {\n    return fail;\n  }\n}", "visible": false}, {"socketType": "in", "name": "Main Thread", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "sealed", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "found", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "opened", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "preview", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "greeting", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "budget", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "when", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "OutData", "dataType": "{\"class\":\"JSONType\"}"}, {"socketType": "out", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "visible": false}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3, "comment": "Unscrambles the envelope. A cut-off link shows a friendly message instead of an error."}, {"id": "ai-node-27", "name": "Preview an envelope", "type": "widgetswitch", "x": 0, "y": 4286.0, "width": 200, "height": 104, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Off value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "On value", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Preview an envelope", "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3}, {"id": "ai-node-19", "name": "Hello", "type": "text", "x": 1455, "y": 3854, "width": 240, "height": 80, "socketArray": [{"socketType": "in", "name": "Content", "dataType": "{\"class\":\"StringType\"}", "data": "{{e.title}}", "visible": false}, {"socketType": "in", "name": "Variant", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"display\",\"value\":\"display\"},{\"text\":\"h1\",\"value\":\"h1\"},{\"text\":\"h2\",\"value\":\"h2\"},{\"text\":\"h3\",\"value\":\"h3\"},{\"text\":\"body\",\"value\":\"body\"},{\"text\":\"caption\",\"value\":\"caption\"},{\"text\":\"label\",\"value\":\"label\"},{\"text\":\"stat\",\"value\":\"stat\"}],\"showAsButtons\":false}}", "data": "h1", "visible": false}, {"socketType": "in", "name": "Tone", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"default\",\"value\":\"default\"},{\"text\":\"muted\",\"value\":\"muted\"},{\"text\":\"primary\",\"value\":\"primary\"},{\"text\":\"secondary\",\"value\":\"secondary\"},{\"text\":\"success\",\"value\":\"success\"},{\"text\":\"warning\",\"value\":\"warning\"},{\"text\":\"error\",\"value\":\"error\"}],\"showAsButtons\":false}}", "data": "default", "visible": false}, {"socketType": "in", "name": "Alignment", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"left\",\"value\":\"left\"},{\"text\":\"center\",\"value\":\"center\"},{\"text\":\"right\",\"value\":\"right\"},{\"text\":\"justify\",\"value\":\"justify\"}],\"showAsButtons\":false}}", "data": "center", "visible": false}, {"socketType": "in", "name": "Custom styles", "dataType": "{\"class\":\"JSONType\"}", "data": {}, "visible": false}, {"socketType": "in", "name": "e", "dataType": "{\"class\":\"AnyType\"}"}, {"socketType": "out", "name": "Output", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}}, {"id": "ai-nod