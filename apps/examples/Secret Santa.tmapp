{"id": "Default/Secret Santa", "location": "Default", "name": "Secret Santa", "access": "private", "graphData": {"version": 12, "graphSettings": {"showExecutionVisualisation": true, "viewportCenterPosition": {"x": -732, "y": 2739}, "viewportScale": 0.1, "defaultUISurfaceNodeId": "ai-node-26", "theme": {"mode": "system"}}, "overlay": {"dashboard": {"visible": true, "fullscreen": true, "maximized": false, "widthPercentage": 52, "locked": false}}, "nodes": [{"id": "ai-node-1", "name": "Start here", "type": "label", "x": 0, "y": 0, "width": 3794, "height": 358, "socketArray": [{"socketType": "in", "name": "Width", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1280,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 0, "visible": false}, {"socketType": "in", "name": "Input", "dataType": "{\"class\":\"StringType\"}", "data": "Secret Santa\nThe top half is the organizer's page: names and rules make one draw, and each person gets a link holding only their own envelope.\nThe bottom half opens that envelope when the app is opened from such a link.\nThe page on the right shows whichever half applies."}, {"socketType": "in", "name": "Font size", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":100,\"stepSize\":1,\"showDetails\":false,\"presetValues\":[{\"text\":\"Small\",\"value\":12},{\"text\":\"Normal\",\"value\":16},{\"text\":\"H5\",\"value\":20},{\"text\":\"H4\",\"value\":24},{\"text\":\"H3\",\"value\":28},{\"text\":\"H2\",\"value\":32},{\"text\":\"H1\",\"value\":40}]}}", "data": 64, "visible": false}, {"socketType": "in", "name": "Text alignment", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Left\",\"value\":\"left\"},{\"text\":\"Center\",\"value\":\"center\"},{\"text\":\"Right\",\"value\":\"right\"}],\"showAsButtons\":true}}", "data": "Left", "visible": false}, {"socketType": "in", "name": "Font weight", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Regular\",\"value\":\"400\"},{\"text\":\"Bold\",\"value\":\"700\"}],\"showAsButtons\":true}}", "data": "Regular", "visible": false}, {"socketType": "in", "name": "Text color", "dataType": "{\"class\":\"ColorType\"}", "data": {"r": 12, "g": 12, "b": 12, "a": 1}, "visible": false}, {"socketType": "in", "name": "Background color", "dataType": "{\"class\":\"ColorType\"}", "data": {"r": 255, "g": 255, "b": 255, "a": 1}, "visible": false}, {"socketType": "out", "name": "Output", "dataType": "{\"class\":\"StringType\"}", "visible": false}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}", "visible": false}], "updateBehaviour": {"load": true, "update": true, "interval": false}}, {"id": "ai-node-2", "name": "Names", "type": "widgettextfield", "x": 0, "y": 878, "width": 220, "height": 120, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"StringType\"}", "data": "Grandma Amara\nGrandpa Kenji\nLucía\nMateo\nPriya\nYusuf\nNoa", "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Names, one per line", "visible": false}, {"socketType": "in", "name": "Placeholder", "dataType": "{\"class\":\"StringType\"}", "data": "Lucía\nMateo\nPriya", "visible": false}, {"socketType": "in", "name": "Helper Text", "dataType": "{\"class\":\"StringType\"}", "data": "", "visible": false}, {"socketType": "in", "name": "Type", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"text\"},{\"text\":\"password\"}],\"showAsButtons\":true}}", "data": "text", "visible": false}, {"socketType": "in", "name": "Multiline", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Rows", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":10,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 10, "visible": false}, {"socketType": "in", "name": "Max Length", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 0, "visible": false}, {"socketType": "in", "name": "Required", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Commit", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"While typing\"},{\"text\":\"Rate limited\"},{\"text\":\"After pause\"},{\"text\":\"Enter or blur\"}],\"showAsButtons\":true}}", "data": "While typing", "visible": false}, {"socketType": "in", "name": "Commit Delay", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":5000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 400, "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}}, {"id": "ai-node-3", "name": "Rules", "type": "widgettextfield", "x": 0, "y": 1078, "width": 220, "height": 120, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"StringType\"}", "data": "Lucía <> Mateo\nPriya > Yusuf", "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Who shouldn't draw whom", "visible": false}, {"socketType": "in", "name": "Placeholder", "dataType": "{\"class\":\"StringType\"}", "data": "Lucía <> Mateo", "visible": false}, {"socketType": "in", "name": "Helper Text", "dataType": "{\"class\":\"StringType\"}", "data": "\"Lucía <> Mateo\": not each other. \"Priya > Yusuf\": Priya doesn't give to Yusuf.", "visible": false}, {"socketType": "in", "name": "Type", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"text\"},{\"text\":\"password\"}],\"showAsButtons\":true}}", "data": "text", "visible": false}, {"socketType": "in", "name": "Multiline", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Rows", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":10,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 5, "visible": false}, {"socketType": "in", "name": "Max Length", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 0, "visible": false}, {"socketType": "in", "name": "Required", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Commit", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"While typing\"},{\"text\":\"Rate limited\"},{\"text\":\"After pause\"},{\"text\":\"Enter or blur\"}],\"showAsButtons\":true}}", "data": "While typing", "visible": false}, {"socketType": "in", "name": "Commit Delay", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":5000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 400, "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}}, {"id": "ai-node-4", "name": "Prevent swaps", "type": "widgetswitch", "x": 0, "y": 1278, "width": 200, "height": 104, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Off value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "On value", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Prevent swaps", "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3, "comment": "Not on the page, always on. Only matters if One big circle is switched off here."}, {"id": "ai-node-5", "name": "One big circle", "type": "widgetswitch", "x": 0, "y": 1462, "width": 200, "height": 104, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Off value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "On value", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "One big circle", "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3, "comment": "Not on the page, always on: one loop through everyone. The small print on the Exclude tab explains it."}, {"id": "ai-node-7", "name": "Draw", "type": "customfunction", "x": 920, "y": 878, "width": 160, "height": 184, "socketArray": [{"socketType": "in", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "data": "(names, rules, noSwaps, oneCircle, drawNumber) => {\n  // Names: one per line (commas work too). A name typed twice counts once.\n  const people = [];\n  const byKey = {};\n  const notes = [];\n  String(names || '').split(/[\\n,;]/).map((s) => s.trim()).filter(Boolean).forEach((n) => {\n    const k = n.toLowerCase();\n    if (byKey[k]) { notes.push(n + ' is listed twice, so they count once.'); return; }\n    byKey[k] = n;\n    people.push(n);\n  });\n  // Rules: \"A <> B\" = not each other, \"A > B\" = A doesn't give to B.\n  const blocked = {};\n  people.forEach((p) => { blocked[p] = {}; blocked[p][p] = true; });\n  let kept = 0;\n  String(rules || '').split('\\n').map((s) => s.trim()).filter(Boolean).forEach((line) => {\n    const oneWay = line.indexOf('<>') < 0;\n    const parts = line.split(oneWay ? '>' : '<>').map((s) => s.trim()).filter(Boolean);\n    if (parts.length !== 2) { notes.push('\"' + line + '\" isn\\'t a rule. Write \"Lucía <> Mateo\" or \"Priya > Yusuf\".'); return; }\n    const a = byKey[parts[0].toLowerCase()];\n    const b = byKey[parts[1].toLowerCase()];\n    const missing = [a ? '' : parts[0], b ? '' : parts[1]].filter(Boolean);\n    if (missing.length) { notes.push(missing.join(' and ') + ' in \"' + line + '\" isn\\'t in the list, so that rule is skipped.'); return; }\n    blocked[a][b] = true;\n    if (!oneWay) blocked[b][a] = true;\n    kept += 1;\n  });\n  const n = people.length;\n  if (n < 3) {\n    return { ok: false, count: n, kept, notes, pairs: [], message: 'Add at least three names to draw.' };\n  }\n  // Same names, rules and draw number give the same draw.\n  let h = 2166136261;\n  const seedText = people.join('|') + '#' + drawNumber;\n  for (let i = 0; i < seedText.length; i++) { h ^= seedText.charCodeAt(i); h = Math.imul(h, 16777619); }\n  let t = h >>> 0;\n  const random = () => {\n    t = (t + 0x6d2b79f5) | 0;\n    let r = Math.imul(t ^ (t >>> 15), 1 | t);\n    r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;\n    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;\n  };\n  const shuffle = (list) => {\n    const a = list.slice();\n    for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(random() * (i + 1)); const x = a[i]; a[i] = a[j]; a[j] = x; }\n    return a;\n  };\n  const allowed = {};\n  people.forEach((g) => { allowed[g] = people.filter((r) => !blocked[g][r]); });\n  const to = {};\n  let steps = 0;\n  let found = false;\n  if (oneCircle) {\n    // One loop through everyone: A gives to B, B to C ... the last back to A.\n    const start = shuffle(people)[0];\n    const used = {};\n    used[start] = true;\n    const extend = (current, length) => {\n      if (++steps > 200000) return false;\n      if (length === n) {\n        if (blocked[current][start]) return false;\n        to[current] = start;\n        return true;\n      }\n      const options = shuffle(allowed[current]).filter((r) => !used[r]);\n      for (let i = 0; i < options.length; i++) {\n        const r = options[i];\n        used[r] = true; to[current] = r;\n        if (extend(r, length + 1)) return true;\n        used[r] = false; delete to[current];\n      }\n      return false;\n    };\n    found = extend(start, 1);\n  } else {\n    // Hardest givers first, then try receivers in random order.\n    const order = shuffle(people).sort((a, b) => allowed[a].length - allowed[b].length);\n    const taken = {};\n    const place = (i) => {\n      if (i === n) return true;\n      if (++steps > 200000) return false;\n      const g = order[i];\n      const options = shuffle(allowed[g]);\n      for (let k = 0; k < options.length; k++) {\n        const r = options[k];\n        if (taken[r] || (noSwaps && to[r] === g)) continue;\n        to[g] = r; taken[r] = true;\n        if (place(i + 1)) return true;\n        taken[r] = false; delete to[g];\n      }\n      return false;\n    };\n    found = place(0);\n  }\n  if (!found) {\n    return { ok: false, count: n, kept, notes, pairs: [], message: 'No draw fits these rules. Remove a rule or add someone.' };\n  }\n  const pairs = people.map((g) => ({ from: g, to: to[g] }));\n  const ruleText = kept === 1 ? '1 rule' : kept + ' rules';\n  return {\n    ok: true, count: n, kept, notes, pairs,\n    message: n + ' people, ' + n + ' gifts' + (kept ? ', ' + ruleText + ' kept' : '') + '.',\n  };\n}", "visible": false}, {"socketType": "in", "name": "Main Thread", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "names", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "rules", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "noSwaps", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "oneCircle", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "drawNumber", "dataType": "{\"class\":\"NumberType\"}"}, {"socketType": "out", "name": "OutData", "dataType": "{\"class\":\"JSONType\"}"}, {"socketType": "out", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "visible": false}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3, "comment": "Pairs everyone up within the rules. The same names, rules and draw number always give the same draw, so the links stay valid while you send them."}, {"id": "ai-node-8", "name": "Budget", "type": "widgettextfield", "x": 0, "y": 2350, "width": 220, "height": 120, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"StringType\"}", "data": "up to €20, or make something", "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Budget", "visible": false}, {"socketType": "in", "name": "Placeholder", "dataType": "{\"class\":\"StringType\"}", "data": "€20", "visible": false}, {"socketType": "in", "name": "Helper Text", "dataType": "{\"class\":\"StringType\"}", "data": "", "visible": false}, {"socketType": "in", "name": "Type", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"text\"},{\"text\":\"password\"}],\"showAsButtons\":true}}", "data": "text", "visible": false}, {"socketType": "in", "name": "Multiline", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Rows", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":10,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 3, "visible": false}, {"socketType": "in", "name": "Max Length", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 0, "visible": false}, {"socketType": "in", "name": "Required", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Commit", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"While typing\"},{\"text\":\"Rate limited\"},{\"text\":\"After pause\"},{\"text\":\"Enter or blur\"}],\"showAsButtons\":true}}", "data": "While typing", "visible": false}, {"socketType": "in", "name": "Commit Delay", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":5000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 400, "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}}, {"id": "ai-node-9", "name": "When", "type": "widgettextfield", "x": 0, "y": 2550, "width": 220, "height": 120, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"StringType\"}", "data": "Saturday, after dinner", "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "When we unwrap", "visible": false}, {"socketType": "in", "name": "Placeholder", "dataType": "{\"class\":\"StringType\"}", "data": "Saturday, after dinner", "visible": false}, {"socketType": "in", "name": "Helper Text", "dataType": "{\"class\":\"StringType\"}", "data": "", "visible": false}, {"socketType": "in", "name": "Type", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"text\"},{\"text\":\"password\"}],\"showAsButtons\":true}}", "data": "text", "visible": false}, {"socketType": "in", "name": "Multiline", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Rows", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":10,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 3, "visible": false}, {"socketType": "in", "name": "Max Length", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 0, "visible": false}, {"socketType": "in", "name": "Required", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Commit", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"While typing\"},{\"text\":\"Rate limited\"},{\"text\":\"After pause\"},{\"text\":\"Enter or blur\"}],\"showAsButtons\":true}}", "data": "While typing", "visible": false}, {"socketType": "in", "name": "Commit Delay", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":5000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 400, "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}}, {"id": "ai-node-10", "name": "Greeting", "type": "widgettextfield", "x": 0, "y": 2750, "width": 220, "height": 120, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"StringType\"}", "data": "Fewer, better gifts this year. Pick something that fits the person, not the price tag.", "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "A few words for everyone", "visible": false}, {"socketType": "in", "name": "Placeholder", "dataType": "{\"class\":\"StringType\"}", "data": "Enter text...", "visible": false}, {"socketType": "in", "name": "Helper Text", "dataType": "{\"class\":\"StringType\"}", "data": "", "visible": false}, {"socketType": "in", "name": "Type", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"text\"},{\"text\":\"password\"}],\"showAsButtons\":true}}", "data": "text", "visible": false}, {"socketType": "in", "name": "Multiline", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Rows", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":10,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 3, "visible": false}, {"socketType": "in", "name": "Max Length", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 0, "visible": false}, {"socketType": "in", "name": "Required", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Commit", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"While typing\"},{\"text\":\"Rate limited\"},{\"text\":\"After pause\"},{\"text\":\"Enter or blur\"}],\"showAsButtons\":true}}", "data": "While typing", "visible": false}, {"socketType": "in", "name": "Commit Delay", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":5000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 400, "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}}, {"id": "ai-node-11", "name": "Show the pairs", "type": "widgetswitch", "x": 0, "y": 2950, "width": 200, "height": 104, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Off value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "On value", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Show the pairs", "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3}, {"id": "ai-node-13", "name": "Make the links", "type": "customfunction", "x": 920, "y": 2350, "width": 160, "height": 208, "socketArray": [{"socketType": "in", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "data": "(draw, greeting, budget, when, showPairs, appAddress) => {\n  // Each link carries only its own envelope, scrambled so a glance\n  // (or a base64 decoder) doesn't spoil it. It isn't encryption.\n  const KEY = 'one-good-gift';\n  const B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-.';\n  const utf8 = (s) => {\n    const out = [];\n    for (let i = 0; i < s.length; i++) {\n      let c = s.charCodeAt(i);\n      if (c >= 0xd800 && c < 0xdc00 && i + 1 < s.length) { c = 0x10000 + ((c - 0xd800) << 10) + (s.charCodeAt(++i) - 0xdc00); }\n      if (c < 0x80) out.push(c);\n      else if (c < 0x800) out.push(0xc0 | (c >> 6), 0x80 | (c & 63));\n      else if (c < 0x10000) out.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));\n      else out.push(0xf0 | (c >> 18), 0x80 | ((c >> 12) & 63), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));\n    }\n    return out;\n  };\n  const seal = (obj) => {\n    const bytes = utf8(JSON.stringify(obj)).map((b, i) => b ^ KEY.charCodeAt(i % KEY.length));\n    let s = '';\n    for (let i = 0; i < bytes.length; i += 3) {\n      const n = (bytes[i] << 16) | ((bytes[i + 1] || 0) << 8) | (bytes[i + 2] || 0);\n      s += B64[(n >> 18) & 63] + B64[(n >> 12) & 63];\n      if (i + 1 < bytes.length) s += B64[(n >> 6) & 63];\n      if (i + 2 < bytes.length) s += B64[n & 63];\n    }\n    return s;\n  };\n  // No draw, no links: \"Sum up the draw\" says why.\n  if (!draw || !draw.ok) return ' ';\n  // The app's own address once it's published; before that, the published example,\n  // which opens any envelope because each link carries everything it shows.\n  const published = 'https://tailrmade.app/?loadGraph=publicUser;;Secret%20Santa;;Default';\n  const base = String(appAddress || '').trim().split('#')[0] || published;\n  const extras = { m: String(greeting || '').trim(), b: String(budget || '').trim(), d: String(when || '').trim() };\n  const lines = [];\n  draw.pairs.forEach((p) => {\n    const url = base + '#santa=' + seal({ v: 1, f: p.from, t: p.to, m: extras.m, b: extras.b, d: extras.d });\n    const who = showPairs ? '**' + p.from + '** → ' + p.to : '**' + p.from + '**';\n    lines.push(who + ' · [Link](' + url + ')');\n  });\n  return lines.join('\\n');\n}", "visible": false}, {"socketType": "in", "name": "Main Thread", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "draw", "dataType": "{\"class\":\"JSONType\"}"}, {"socketType": "in", "name": "greeting", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "budget", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "when", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "showPairs", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "appAddress", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "OutData", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "visible": false}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3, "comment": "One link per giver. Each link carries only that person's envelope, scrambled so it can't be read at a glance. It isn't encryption."}, {"id": "ai-node-14", "name": "Links to send", "type": "text", "x": 1220, "y": 2350, "width": 240, "height": 80, "socketArray": [{"socketType": "in", "name": "Content", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "Variant", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"display\",\"value\":\"display\"},{\"text\":\"h1\",\"value\":\"h1\"},{\"text\":\"h2\",\"value\":\"h2\"},{\"text\":\"h3\",\"value\":\"h3\"},{\"text\":\"body\",\"value\":\"body\"},{\"text\":\"caption\",\"value\":\"caption\"},{\"text\":\"label\",\"value\":\"label\"},{\"text\":\"stat\",\"value\":\"stat\"}],\"showAsButtons\":false}}", "data": "body", "visible": false}, {"socketType": "in", "name": "Tone", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"default\",\"value\":\"default\"},{\"text\":\"muted\",\"value\":\"muted\"},{\"text\":\"primary\",\"value\":\"primary\"},{\"text\":\"secondary\",\"value\":\"secondary\"},{\"text\":\"success\",\"value\":\"success\"},{\"text\":\"warning\",\"value\":\"warning\"},{\"text\":\"error\",\"value\":\"error\"}],\"showAsButtons\":false}}", "data": "default", "visible": false}, {"socketType": "in", "name": "Alignment", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"left\",\"value\":\"left\"},{\"text\":\"center\",\"value\":\"center\"},{\"text\":\"right\",\"value\":\"right\"},{\"text\":\"justify\",\"value\":\"justify\"}],\"showAsButtons\":false}}", "data": "left", "visible": false}, {"socketType": "in", "name": "Custom styles", "dataType": "{\"class\":\"JSONType\"}", "data": {}, "visible": false}, {"socketType": "out", "name": "Output", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}}, {"id": "ai-node-15", "name": "Envelope in the link", "type": "urlparameter", "x": 0, "y": 3886, "width": 160, "height": 160, "socketArray": [{"socketType": "in", "name": "Key", "dataType": "{\"class\":\"StringType\"}", "data": "santa"}, {"socketType": "in", "name": "Default", "dataType": "{\"class\":\"AnyType\"}", "data": ""}, {"socketType": "out", "name": "Value", "dataType": "{\"class\":\"AnyType\"}"}, {"socketType": "out", "name": "Found", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "App link", "dataType": "{\"class\":\"StringType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "comment": "Reads #santa=... from the address. Found switches the page from organizer to envelope. App link is where the links point once the app is published."}, {"id": "ai-node-16", "name": "No envelope", "type": "not", "x": 340, "y": 3886, "width": 115, "height": 40, "socketArray": [{"socketType": "in", "name": "A", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "Inverted", "dataType": "{\"class\":\"BooleanType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 4}, {"id": "ai-node-17", "name": "Open my envelope", "type": "widgetswitch", "x": 0, "y": 4102, "width": 200, "height": 104, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Off value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "On value", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Open my envelope", "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3}, {"id": "ai-node-18", "name": "Open the envelope", "type": "customfunction", "x": 1155, "y": 3854, "width": 160, "height": 208, "socketArray": [{"socketType": "in", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "data": "(sealed, found, opened, greeting, budget, when) => {\n  // Reverses the scrambling in \"Make the links\". Without a link it shows a\n  // preview envelope with example names, built from the organizer's inputs.\n  const KEY = 'one-good-gift';\n  const B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-.';\n  const blank = ' ';\n  const fail = { ok: false, title: 'This envelope is damaged', intro: 'The link may have been cut off when it was copied. Ask the organizer to send it again.', name: blank, details: blank };\n  const show = (e, intro) => {\n    const details = [];\n    if (e.b) details.push('**Budget:** ' + e.b);\n    if (e.d) details.push('**When:** ' + e.d);\n    if (e.m) details.push('', '> ' + e.m.split('\\n').join('\\n> '));\n    return {\n      ok: true,\n      title: 'Hi ' + e.f + ' 🎅',\n      intro: intro || 'This envelope is for ' + e.f + ' only. Make sure nobody is looking over your shoulder, then open it.',\n      name: opened ? e.t : '· · ·',\n      details: details.length ? details.join('\\n') : blank,\n    };\n  };\n  if (!found) {\n    const sample = { f: 'Alex', t: 'Sam', m: String(greeting || '').trim(), b: String(budget || '').trim(), d: String(when || '').trim() };\n    return show(sample);\n  }\n  try {\n    const s = String(sealed || '').trim();\n    const bytes = [];\n    for (let i = 0; i < s.length; i += 4) {\n      const c = [0, 1, 2, 3].map((k) => (i + k < s.length ? B64.indexOf(s[i + k]) : 0));\n      if (c.some((x) => x < 0)) return fail;\n      const n = (c[0] << 18) | (c[1] << 12) | (c[2] << 6) | c[3];\n      bytes.push((n >> 16) & 255);\n      if (i + 2 < s.length) bytes.push((n >> 8) & 255);\n      if (i + 3 < s.length) bytes.push(n & 255);\n    }\n    const next = (i) => (bytes[i] ^ KEY.charCodeAt(i % KEY.length)) & 63;\n    let text = '';\n    for (let i = 0; i < bytes.length; i++) {\n      const b = bytes[i] ^ KEY.charCodeAt(i % KEY.length);\n      let c;\n      if (b < 0x80) c = b;\n      else if (b < 0xe0) { c = ((b & 31) << 6) | next(++i); }\n      else if (b < 0xf0) { c = (b & 15) << 12; c |= next(++i) << 6; c |= next(++i); }\n      else { c = (b & 7) << 18; c |= next(++i) << 12; c |= next(++i) << 6; c |= next(++i); }\n      text += String.fromCodePoint(c);\n    }\n    const e = JSON.parse(text);\n    if (!e || !e.f || !e.t) return fail;\n    return show(e);\n  } catch (err) {\n    return fail;\n  }\n}", "visible": false}, {"socketType": "in", "name": "Main Thread", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "sealed", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "found", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "opened", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "greeting", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "budget", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "when", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "OutData", "dataType": "{\"class\":\"JSONType\"}"}, {"socketType": "out", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "visible": false}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3, "comment": "Unscrambles the envelope. A cut-off link shows a friendly message instead of an error."}, {"id": "ai-node-19", "name": "Hello", "type": "text", "x": 1455, "y": 3854, "width": 240, "height": 80, "socketArray": [{"socketType": "in", "name": "Content", "dataType": "{\"class\":\"StringType\"}", "data": "{{e.title}}", "visible": false}, {"socketType": "in", "name": "Variant", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"display\",\"value\":\"display\"},{\"text\":\"h1\",\"value\":\"h1\"},{\"text\":\"h2\",\"value\":\"h2\"},{\"text\":\"h3\",\"value\":\"h3\"},{\"text\":\"body\",\"value\":\"body\"},{\"text\":\"caption\",\"value\":\"caption\"},{\"text\":\"label\",\"value\":\"label\"},{\"text\":\"stat\",\"value\":\"stat\"}],\"showAsButtons\":false}}", "data": "h1", "visible": false}, {"socketType": "in", "name": "Tone", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"default\",\"value\":\"default\"},{\"text\":\"muted\",\"value\":\"muted\"},{\"text\":\"prim