tomfunction", "x": 1455, "y": 4334, "width": 160, "height": 88, "socketArray": [{"socketType": "in", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "data": "(envelope) => (envelope && envelope.details) || '\u00a0'", "visible": false}, {"socketType": "in", "name": "Main Thread", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "envelope", "dataType": "{\"class\":\"JSONType\"}"}, {"socketType": "out", "name": "OutData", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "visible": false}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3}, {"id": "ai-node-23", "name": "Budget and greeting", "type": "text", "x": 1835, "y": 3854, "width": 240, "height": 80, "socketArray": [{"socketType": "in", "name": "Content", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "Variant", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"display\",\"value\":\"display\"},{\"text\":\"h1\",\"value\":\"h1\"},{\"text\":\"h2\",\"value\":\"h2\"},{\"text\":\"h3\",\"value\":\"h3\"},{\"text\":\"body\",\"value\":\"body\"},{\"text\":\"caption\",\"value\":\"caption\"},{\"text\":\"label\",\"value\":\"label\"},{\"text\":\"stat\",\"value\":\"stat\"}],\"showAsButtons\":false}}", "data": "body", "visible": false}, {"socketType": "in", "name": "Tone", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"default\",\"value\":\"default\"},{\"text\":\"muted\",\"value\":\"muted\"},{\"text\":\"primary\",\"value\":\"primary\"},{\"text\":\"secondary\",\"value\":\"secondary\"},{\"text\":\"success\",\"value\":\"success\"},{\"text\":\"warning\",\"value\":\"warning\"},{\"text\":\"error\",\"value\":\"error\"}],\"showAsButtons\":false}}", "data": "default", "visible": false}, {"socketType": "in", "name": "Alignment", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"le