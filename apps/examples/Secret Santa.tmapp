out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3}, {"id": "ai-node-5", "name": "One big circle", "type": "widgetswitch", "x": 0, "y": 1462, "width": 200, "height": 104, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Off value", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "On value", "dataType": "{\"class\":\"BooleanType\"}", "data": true, "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "One big circle", "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3}, {"id": "ai-node-6", "name": "Draw number", "type": "widgetslider", "x": 0, "y": 1646, "width": 200, "height": 104, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"NumberType\"}", "data": 1, "visible": false}, {"socketType": "in", "name": "Min", "dataType": "{\"class\":\"NumberType\"}", "data": 1, "visible": false}, {"socketType": "in", "name": "Max", "dataType": "{\"class\":\"NumberType\"}", "data": 20, "visible": false}, {"socketType": "in", "name": "Decimals", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":10,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 0, "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Draw {{value}} \u00b7 slide for a new one", "visible": false}, {"socketType": "in", "name": "Commit", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"While dragging\"},{\"text\":\"On release\"}],\"showAsButtons\":true}}", "data": "While dragging", "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"NumberType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3, "comment": "Each position is a different draw. Moving back to a number brings that draw back."}, {"id": "ai-node-7", "name": "Draw", "type": "customfunction", "x": 920, "y": 878, "width": 160, "height": 184, "socketArray": [{"socketType": "in", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "data": "(names, rules, noSwaps, oneCircle, drawNumber) => {\n  // Names: one per line (commas work too). A name typed twice counts once.\n  const people = [];\n  const byKey = {};\n  const notes = [];\n  String(names || '').split(/[\\n,;]/).map((s) => s.trim()).filter(Boolean).forEach((n) => {\n    const k = n.toLowerCase();\n    if (byKey[k]) { notes.push(n + ' is listed twice, so they count once.'); return; }\n    byKey[k] = n;\n    people.push(n);\n  });\n  // Rules: \"A <> B\" = not each other, \"A > B\" = A doesn't give to B.\n  const blocked = {};\n  people.forEach((p) => { blocked[p] = {}; blocked[p][p] = true; });\n  let kept = 0;\n  String(rules || '').split('\\n').map((s) => s.trim()).filter(Boolean).forEach((line) => {\n    const oneWay = line.indexOf('<>') < 0;\n    const parts = line.split(oneWay ? '>' : '<>').map((s) => s.trim()).filter(Boolean);\n    if (parts.length !== 2) { notes.push('\"' + line + '\" isn\\'t a rule. Write \"Luc\u00eda <> Mateo\" or \"Priya > Yusuf\".'); return; }\n    const a = byKey[parts[0].toLowerCase()];\n    const b = byKey[parts[1].toLowerCase()];\n    const missing = [a ? '' : parts[0], b ? '' : parts[1]].filter(Boolean);\n    if (missing.length) { notes.push(missing.join(' and ') + ' in \"' + line + '\" isn\\'t in the list, so that rule is skipped.'); return; }\n    blocked[a][b] = true;\n    if (!oneWay) blocked[b][a] = true;\n    kept += 1;\n  });\n  const n = people.length;\n  if (n < 3) {\n    return { ok: false, count: n, kept, notes, pairs: [], message: 'Add at least three names to draw.' };\n  }\n  // Same names, rules and draw number give the same draw.\n  let h = 2166136261;\n  const seedText = people.join('|') + '#' + drawNumber;\n  for (let i = 0; i < seedText.length; i++) { h ^= seedText.charCodeAt(i); h = Math.imul(h, 16777619); }\n  let t = h >>> 0;\n  const random = () => {\n    t = (t + 0x6d2b79f5) | 0;\n    let r = Math.imul(t ^ (t >>> 15), 1 | t);\n    r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;\n    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;\n  };\n  const shuffle = (list) => {\n    const a = list.slice();\n    for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(random() * (i + 1)); const x = a[i]; a[i] = a[j]; a[j] = x; }\n    return a;\n  };\n  const allowed = {};\n  people.forEach((g) => { allowed[g] = people.filter((r) => !blocked[g][r]); });\n  const to = {};\n  let steps = 0;\n  let found = false;\n  if (oneCircle) {\n    // One loop through everyone: A gives to B, B to C ... the last back to A.\n    const start = shuffle(people)[0];\n    const used = {};\n    used[start] = true;\n    const extend = (current, length) => {\n      if (++steps > 200000) return false;\n      if (length === n) {\n        if (blocked[current][start]) return false;\n        to[current] = start;\n        return true;\n      }\n      const options = shuffle(allowed[current]).filter((r) => !used[r]);\n      for (let i = 0; i < options.length; i++) {\n        const r = options[i];\n        used[r] = true; to[current] = r;\n        if (extend(r, length + 1)) return true;\n        used[r] = false; delete to[current];\n      }\n      return false;\n    };\n    found = extend(start, 1);\n  } else {\n    // Hardest givers first, then try receivers in random order.\n    const order = shuffle(people).sort((a, b) => allowed[a].length - allowed[b].length);\n    const taken = {};\n    const place = (i) => {\n      if (i === n) return true;\n      if (++steps > 200000) return false;\n      const g = order[i];\n      const options = shuffle(allowed[g]);\n      for (let k = 0; k < options.length; k++) {\n        const r = options[k];\n        if (taken[r] || (noSwaps && to[r] === g)) continue;\n        to[g] = r; taken[r] = true;\n        if (place(i + 1)) return true;\n        taken[r] = false; delete to[g];\n      }\n      return false;\n    };\n    found = place(0);\n  }\n  if (!found) {\n    return { ok: false, count: n, kept, notes, pairs: [], message: 'No draw fits these rules. Remove a rule or add someone.' };\n  }\n  const pairs = people.map((g) => ({ from: g, to: to[g] }));\n  const ruleText = kept === 1 ? '1 rule' : kept + ' rules';\n  return {\n    ok: true, count: n, kept, notes, pairs,\n    message: n + ' people, ' + n + ' gifts' + (kept ? ', ' + ruleText + ' kept' : '') + (oneCircle ? ', one big circle' : '') + '.',\n  };\n}", "visible": false}, {"socketType": "in", "name": "Main Thread", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "names", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "rules", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "in", "name": "noSwaps", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "oneCircle", "dataType": "{\"class\":\"BooleanType\"}"}, {"socketType": "in", "name": "drawNumber", "dataType": "{\"class\":\"NumberType\"}"}, {"socketType": "out", "name": "OutData", "dataType": "{\"class\":\"JSONType\"}"}, {"socketType": "out", "name": "Code", "dataType": "{\"class\":\"CodeType\"}", "visible": false}], "updateBehaviour": {"load": true, "update": true, "interval": false}, "version": 3, "comment": "Pairs everyone up within the rules. The same names, rules and draw number always give the same draw, so the links stay valid while you send them."}, {"id": "ai-node-8", "name": "Budget", "type": "widgettextfield", "x": 0, "y": 2350, "width": 220, "height": 120, "socketArray": [{"socketType": "in", "name": "Initial Value", "dataType": "{\"class\":\"StringType\"}", "data": "up to \u20ac20, or make something", "visible": false}, {"socketType": "in", "name": "Label", "dataType": "{\"class\":\"StringType\"}", "data": "Budget", "visible": false}, {"socketType": "in", "name": "Placeholder", "dataType": "{\"class\":\"StringType\"}", "data": "\u20ac20", "visible": false}, {"socketType": "in", "name": "Helper Text", "dataType": "{\"class\":\"StringType\"}", "data": "", "visible": false}, {"socketType": "in", "name": "Type", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"text\"},{\"text\":\"password\"}],\"showAsButtons\":true}}", "data": "text", "visible": false}, {"socketType": "in", "name": "Multiline", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Rows", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":10,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 3, "visible": false}, {"socketType": "in", "name": "Max Length", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 0, "visible": false}, {"socketType": "in", "name": "Required", "dataType": "{\"class\":\"BooleanType\"}", "data": false, "visible": false}, {"socketType": "in", "name": "Commit", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"While typing\"},{\"text\":\"Rate limited\"},{\"text\":\"After pause\"},{\"text\":\"Enter or blur\"}],\"showAsButtons\":true}}", "data": "While typing", "visible": false}, {"socketType": "in", "name": "Commit Delay", "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":5000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}", "data": 400, "visible": false}, {"socketType": "in", "name": "Color", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}", "data": "primary", "visible": false}, {"socketType": "in", "name": "Size", "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}", "data": "Inherit", "visible": false}, {"socketType": "out", "name": "Out", "dataType": "{\"class\":\"StringType\"}"}, {"socketType": "out", "name": "ReactUI", "dataType": "{\"class\":\"DeferredReactType\"}"}], "updateBehaviour": {"load": tru