      },
      {
        "id": "ai-node-7",
        "name": "Usual type",
        "type": "customfunction",
        "x": 760,
        "y": 2653,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(diary, lists) => {\n  // The form starts on the type you log most, so the usual case needs no tap.\n  const types = lists?.types ?? [];\n  const counts = {};\n  for (const entry of diary?.entries ?? []) {\n    if (types.includes(entry.type)) counts[entry.type] = (counts[entry.type] ?? 0) + 1;\n  }\n  const top = Object.keys(counts).sort((a, b) => counts[b] - counts[a])[0];\n  return top ?? types[0] ?? '';\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "diary",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "lists",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Starts the form on the type you log most, so the usual case is one tap."
      },
