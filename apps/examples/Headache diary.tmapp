            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(theme) => {\n  // Plotly draws outside the theme, so its colours come from the Theme node.\n  const tokens = theme?.tokens ?? {};\n  const text = tokens['text.secondary'] ?? tokens['text.primary'] ?? '#888';\n  const grid = tokens.divider ?? 'rgba(128,128,128,0.25)';\n  const font = tokens.fontFamily ?? tokens['typography.fontFamily'];\n  return {\n    barmode: 'stack',\n    paper_bgcolor: 'rgba(0,0,0,0)',\n    plot_bgcolor: 'rgba(0,0,0,0)',\n    font: { color: text, size: 12, ...(font ? { family: font } : {}) },\n    margin: { l: 28, r: 8, t: 8, b: 32 },\n    xaxis: { fixedrange: true, showgrid: false, linecolor: grid },\n    yaxis: { fixedrange: true, dtick: 1, rangemode: 'tozero', gridcolor: grid, zeroline: false },\n    legend: { orientation: 'h', x: 0, y: -0.18, font: { color: text } },\n    bargap: 0.35,\n  };\n}",
            "visible": false
