          "update": true,
          "interval": false
        },
        "comment": "Writes when New headache has run. Non-empty only is off everywhere, so deleting the last entry can store an empty list."
      },
      {
        "id": "ai-node-17",
        "name": "Right now text",
        "type": "customfunction",
        "x": 2300,
        "y": 4405,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(stored) => {\n  const entries = Array.isArray(stored?.entries) ? stored.entries : [];\n  // Names can be typed by the user and are read as Markdown, so escape them.\n  const escape = (text) => String(text).replace(/([\\\\`*_{}[\\]()#+\\-.!|<>~])/g, '\\\\$1');\n  const parse = (s) => {\n    const [d, t] = String(s).split('T');\n    const [y, m, day] = d.split('-').map(Number);\n    const [h, min] = (t ?? '0:0').split(':').map(Number);\n    return new Date(y, m - 1, day, h, min);\n  };\n  const pad = (n) => String(n).padStart(2, '0');\n  const now = new Date();\n  const open = [...entries].reverse().find((entry) => !entry.end);\n  if (open) {\n    const start = parse(open.start);\n    const minutes = Math.max(0, Math.round((now - start) / 60000));\n    const ago = minutes < 60 ? `${minutes} min` : `${Math.floor(minutes / 60)} h ${minutes % 60} min`;\n    const medicine = open.medicine ? `You took **${escape(open.medicine)}**. ` : 'No medicine logged. ';\n    const ask = open.medicine ? 'When it ends, say whether it helped and tap **It\\'s over**.' : 'Tap **It\\'s over** when it ends.';\n    return `[In progress]{.warning} **${escape(open.type)}**, ${open.intensity}/10, since ${pad(start.getHours())}:${pad(start.getMinutes())} (${ago})\\n${medicine}${ask}`;\n  }\n  if (entries.length === 0) return 'Nothing logged yet. When a headache starts, log it here.';\n  const last = parse(entries[entries.length - 1].end ?? entries[entries.length - 1].start);\n  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n  const days = Math.round((today - new Date(last.getFullYear(), last.getMonth(), last.getDate())) / 86400000);\n  const when = days === 0 ? 'today' : days === 1 ? 'yesterday' : `${days} days ago`;\n  return `[No headache right now]{.success}\\nThe last one ended ${when}.`;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "stored",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
