      {
        "id": "ai-node-32",
        "name": "Helped text",
        "type": "customfunction",
        "x": 3790,
        "y": 6309,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(diary) => {\n  // For each type: how often each medicine helped, only counting headaches with an answer.\n  const escape = (text) => String(text).replace(/([\\\\`*_{}[\\]()#+\\-.!|<>~])/g, '\\\\$1');\n  const parse = (s) => {\n    const [d, t] = String(s).split('T');\n    const [y, m, day] = d.split('-').map(Number);\n    const [h, min] = (t ?? '0:0').split(':').map(Number);\n    return new Date(y, m - 1, day, h, min);\n  };\n  const byType = {};\n  for (const entry of diary?.entries ?? []) {\n    const row = (byType[entry.type] = byType[entry.type] ?? { count: 0, hours: [], meds: {} });\n    row.count += 1;\n    if (entry.end) row.hours.push((parse(entry.end) - parse(entry.start)) / 3600000);\n    if (entry.medicine && entry.relief) {\n      const med = (row.meds[entry.medicine] = row.meds[entry.medicine] ?? { yes: 0, partly: 0, no: 0 });\n      med[entry.relief] = (med[entry.relief] ?? 0) + 1;\n    }\n  }\n  const types = Object.keys(byType).sort((a, b) => byType[b].count - byType[a].count);\n  const lines = [];\n  for (const type of types) {\n    const row = byType[type];\n    const hours = row.hours.length ? row.hours.reduce((s, n) => s + n, 0) / row.hours.length : 0;\n    const length = hours ? ` · about ${hours < 1 ? '<1' : Math.round(hours)} h each` : '';\n    lines.push(`**${escape(type)}** [${row.count}×${length}]{.muted}`);\n    const meds = Object.keys(row.meds).map((name) => {\n      const r = row.meds[name];\n      const total = r.yes + r.partly + r.no;\n      return { name, r, total, score: (r.yes + r.partly / 2) / total };\n    }).sort((a, b) => b.score - a.score);\n    if (meds.length === 0) {\n      lines.push('[No medicine with an answer yet]{.muted}');\n      continue;\n    }\n    for (const { name, r, total } of meds) {\n      const partly = r.partly ? ` [(partly ${r.partly})]{.muted}` : '';\n      lines.push(`${escape(name)} helped **${r.yes} of ${total}**${partly}`);\n    }\n  }\n  return lines.length ? lines.join('\\n') : 'Log a medicine and say whether it helped, and this fills in.';\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
