      {
        "id": "ai-node-29",
        "name": "Chart traces",
        "type": "customfunction",
        "x": 3790,
        "y": 5949,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(diary, theme) => {\n  // Headaches per week for the last eight weeks, one stacked colour per type.\n  const tokens = theme?.tokens ?? {};\n  const palette = [tokens.primary, tokens.secondary, tokens.success, tokens.warning, tokens.info, tokens.error].filter(Boolean);\n  const now = new Date();\n  const monday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - ((now.getDay() + 6) % 7) - 49);\n  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n  const weeks = [];\n  for (let i = 0; i < 8; i += 1) weeks.push(new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + i * 7));\n  const labels = weeks.map((w) => `${w.getDate()} ${months[w.getMonth()]}`);\n  const counts = {};\n  for (const entry of diary?.entries ?? []) {\n    const [y, m, d] = String(entry.start).slice(0, 10).split('-').map(Number);\n    const week = Math.floor((new Date(y, m - 1, d) - monday) / (7 * 86400000));\n    if (week < 0 || week > 7) continue;\n    counts[entry.type] = counts[entry.type] ?? new Array(8).fill(0);\n    counts[entry.type][week] += 1;\n  }\n  const types = Object.keys(counts).sort((a, b) => counts[b].reduce((s, n) => s + n, 0) - counts[a].reduce((s, n) => s + n, 0));\n  return types.map((type, i) => ({\n    type: 'bar',\n    name: type,\n    x: labels,\n    y: counts[type],\n    marker: palette.length ? { color: palette[i % palette.length] } : {},\n    hovertemplate: `%{y} × ${type}<extra>week of %{x}</extra>`,\n  }));\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "diary",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "theme",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
