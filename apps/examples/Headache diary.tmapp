      {
        "id": "ai-node-15",
        "name": "New headache",
        "type": "customfunction",
        "x": 1540,
        "y": 2485,
        "width": 160,
        "height": 232,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(stored, type, intensity, started, medicine, triggers) => {\n  // Runs only when Log headache is pressed, so \"now\" is the moment of the press.\n  const entries = Array.isArray(stored?.entries) ? stored.entries : [];\n  const now = new Date();\n  const pad = (n) => String(n).padStart(2, '0');\n  const stamp = (t) => `${t.getFullYear()}-${pad(t.getMonth() + 1)}-${pad(t.getDate())}T${pad(t.getHours())}:${pad(t.getMinutes())}`;\n  const hoursBack = { 'Just now': 0, '30 minutes ago': 0.5, '1 hour ago': 1, '2 hours ago': 2, '4 hours ago': 4 }[started];\n  let start = now;\n  if (hoursBack !== undefined) start = new Date(now.getTime() - hoursBack * 3600000);\n  if (started === 'This morning') start = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 8, 0);\n  if (started === 'Last night') start = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1, 22, 0);\n  if (start > now) start = now;\n  // A new headache closes any you forgot to end.\n  const closed = entries.map((entry) => (entry.end ? entry : { ...entry, end: stamp(now) }));\n  const entry = {\n    start: stamp(start),\n    type: String(type || 'Other'),\n    intensity: Math.min(10, Math.max(1, Math.round(Number(intensity)) || 5)),\n    medicine: medicine && medicine !== 'None' ? String(medicine) : '',\n    triggers: Array.isArray(triggers) ? triggers.map(String) : [],\n  };\n  return { entries: [...closed, entry] };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "stored",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "type",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "intensity",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "started",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "medicine",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "triggers",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "trigger",
            "name": "Trigger 1",
            "dataType": "{\"class\":\"TriggerType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": false,
          "update": false,
          "interval": false
        },
        "version": 3,
        "comment": "Runs only when Log headache is pressed, so the time is the moment of the press. Reads the stored diary, never the sample."
      },
      {
        "id": "ai-node-16",
        "name": "Save new headache",
        "type": "storagewrite",
        "x": 1840,
