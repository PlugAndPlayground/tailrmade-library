      {
        "id": "ai-node-44",
        "name": "Lists text",
        "type": "customfunction",
        "x": 6170,
        "y": 8613,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(lists) => {\n  const escape = (text) => String(text).replace(/([\\\\`*_{}[\\]()#+\\-.!|<>~])/g, '\\\\$1');\n  const join = (items) => (items?.length ? items.map(escape).join(', ') : '[none]{.muted}');\n  return `**Types:** ${join(lists?.types)}\\n**Medicines:** ${join(lists?.meds)}`;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
