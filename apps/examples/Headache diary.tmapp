      {
        "id": "ai-node-36",
        "name": "Recent text",
        "type": "customfunction",
        "x": 4990,
        "y": 7261,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(diary) => {\n  const escape = (text) => String(text).replace(/([\\\\`*_{}[\\]()#+\\-.!|<>~])/g, '\\\\$1');\n  const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];\n  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n  const parse = (s) => {\n    const [d, t] = String(s).split('T');\n    const [y, m, day] = d.split('-').map(Number);\n    const [h, min] = (t ?? '0:0').split(':').map(Number);\n    return new Date(y, m - 1, day, h, min);\n  };\n  const pad = (n) => String(n).padStart(2, '0');\n  const answers = { yes: 'helped', partly: 'helped partly', no: 'didn\\'t help' };\n  const lines = [...(diary?.entries ?? [])].reverse().slice(0, 6).map((entry) => {\n    const start = parse(entry.start);\n    const when = `**${weekdays[start.getDay()]} ${start.getDate()} ${months[start.getMonth()]}, ${pad(start.getHours())}:${pad(start.getMinutes())}**`;\n    const hours = entry.end ? (parse(entry.end) - start) / 3600000 : null;\n    const length = hours === null ? '[ongoing]{.warning}' : hours < 1 ? `${Math.max(1, Math.round(hours * 60))} min` : `${Math.round(hours)} h`;\n    const medicine = entry.medicine ? ` · ${escape(entry.medicine)}${entry.relief ? `, ${answers[entry.relief]}` : ''}` : '';\n    const triggers = entry.triggers?.length ? ` [· ${entry.triggers.map(escape).join(', ').toLowerCase()}]{.muted}` : '';\n    return `${when} · ${escape(entry.type)} ${entry.intensity}/10 · ${length}${medicine}${triggers}`;\n  });\n  return lines.length ? lines.join('\\n') : 'Nothing logged yet.';\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "diary",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
