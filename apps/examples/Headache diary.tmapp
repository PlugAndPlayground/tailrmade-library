{
  "id": "Default/Headache diary",
  "location": "Default",
  "name": "Headache diary",
  "access": "private",
  "graphData": {
    "version": 7,
    "graphSettings": {
      "showExecutionVisualisation": true,
      "viewportCenterPosition": {
        "x": -914,
        "y": 4674
      },
      "viewportScale": 0.061,
      "defaultUISurfaceNodeId": "ai-node-51",
      "theme": {
        "mode": "dark"
      }
    },
    "overlay": {
      "dashboard": {
        "visible": true,
        "fullscreen": false,
        "maximized": false,
        "widthPercentage": 52,
        "locked": false
      }
    },
    "nodes": [
      {
        "id": "ai-node-1",
        "name": "Start here",
        "type": "label",
        "x": 0,
        "y": 0,
        "width": 4114,
        "height": 285,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1280,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Input",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "This page is a Tailrmade app.\nFollow the numbers: the diary is read from this browser's storage, each button writes a changed copy back, and the page reads what is stored.\nMain page on the right shows the result."
          },
          {
            "socketType": "in",
            "name": "Font size",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":100,\"stepSize\":1,\"showDetails\":false,\"presetValues\":[{\"text\":\"Small\",\"value\":12},{\"text\":\"Normal\",\"value\":16},{\"text\":\"H5\",\"value\":20},{\"text\":\"H4\",\"value\":24},{\"text\":\"H3\",\"value\":28},{\"text\":\"H2\",\"value\":32},{\"text\":\"H1\",\"value\":40}]}}",
            "data": 64,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Text alignment",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Left\",\"value\":\"left\"},{\"text\":\"Center\",\"value\":\"center\"},{\"text\":\"Right\",\"value\":\"right\"}],\"showAsButtons\":true}}",
            "data": "Left",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Font weight",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Regular\",\"value\":\"400\"},{\"text\":\"Bold\",\"value\":\"700\"}],\"showAsButtons\":true}}",
            "data": "Regular",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Text color",
            "dataType": "{\"class\":\"ColorType\"}",
            "data": {
              "r": 12,
              "g": 12,
              "b": 12,
              "a": 1
            },
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Background color",
            "dataType": "{\"class\":\"ColorType\"}",
            "data": {
              "r": 255,
              "g": 255,
              "b": 255,
              "a": 1
            },
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Output",
            "dataType": "{\"class\":\"StringType\"}",
            "visible": false
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        }
      },
      {
        "id": "ai-node-2",
        "name": "Read diary",
        "type": "storageread",
        "x": 0,
        "y": 1485,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Storage type",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Cloud\",\"disabled\":true},{\"text\":\"IndexedDB\"},{\"text\":\"Local storage\"}],\"showAsButtons\":true}}",
            "data": "IndexedDB",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Location",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "Headache diary example"
          },
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "entries"
          },
          {
            "socketType": "in",
            "name": "Fallback value",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {}
          },
          {
            "socketType": "in",
            "name": "Show Toast Notification",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Value",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Error",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "All headaches, as { entries: [...] } in IndexedDB. It re-reads by itself after every write to this key, so everything below always shows what is stored."
      },
      {
        "id": "ai-node-3",
        "name": "Read lists",
        "type": "storageread",
        "x": 0,
        "y": 1725,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Storage type",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Cloud\",\"disabled\":true},{\"text\":\"IndexedDB\"},{\"text\":\"Local storage\"}],\"showAsButtons\":true}}",
            "data": "IndexedDB",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Location",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "Headache diary example"
          },
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "lists"
          },
          {
            "socketType": "in",
            "name": "Fallback value",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {}
          },
          {
            "socketType": "in",
            "name": "Show Toast Notification",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Value",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Error",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "Your own headache types and medicines. Empty until you change them, so the presets are used."
      },
      {
        "id": "ai-node-4",
        "name": "Lists",
        "type": "customfunction",
        "x": 300,
        "y": 1485,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(stored) => {\n  // Your own lists win; until you change them, the presets are used.\n  const presets = {\n    types: ['Tension', 'Migraine', 'Migraine with aura', 'Cluster', 'Sinus'],\n    meds: ['Ibuprofen', 'Paracetamol', 'Aspirin', 'Naproxen', 'Sumatriptan'],\n  };\n  const list = (value) => (Array.isArray(value) ? value.map(String) : null);\n  const types = list(stored?.types) ?? presets.types;\n  const meds = list(stored?.meds) ?? presets.meds;\n  return { types, meds };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "stored",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Presets until you change them. Logged headaches keep their names, so removing a type never changes old entries."
      },
      {
        "id": "ai-node-5",
        "name": "Diary or sample",
        "type": "customfunction",
        "x": 300,
        "y": 1653,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(stored) => {\n  const entries = Array.isArray(stored?.entries) ? stored.entries : [];\n  if (entries.length > 0) return { sample: false, entries };\n  // Nothing logged yet: eight weeks of made-up headaches, so the insights have something to show.\n  // They are never stored.\n  const now = new Date();\n  const pad = (n) => String(n).padStart(2, '0');\n  const stamp = (t) => `${t.getFullYear()}-${pad(t.getMonth() + 1)}-${pad(t.getDate())}T${pad(t.getHours())}:${pad(t.getMinutes())}`;\n  const plan = [\n    [52, 16, 'Tension', 3, 'Paracetamol', 'partly', 3, ['Screen time']],\n    [48, 7, 'Migraine', 6, 'Sumatriptan', 'yes', 4, ['Poor sleep', 'Weather']],\n    [44, 11, 'Tension', 4, 'Ibuprofen', 'yes', 2, ['Stress']],\n    [40, 19, 'Migraine', 8, 'Ibuprofen', 'no', 10, ['Alcohol']],\n    [37, 12, 'Tension', 5, 'Ibuprofen', 'yes', 3, ['Stress', 'Skipped meal']],\n    [33, 15, 'Tension', 3, '', '', 1, ['Screen time']],\n    [31, 9, 'Migraine', 7, 'Sumatriptan', 'partly', 7, ['Period', 'Poor sleep']],\n    [27, 17, 'Sinus', 5, 'Ibuprofen', 'partly', 6, ['Weather']],\n    [24, 14, 'Tension', 4, 'Paracetamol', 'no', 5, ['Stress', 'Too little water']],\n    [20, 10, 'Migraine', 5, 'Sumatriptan', 'yes', 4, ['Poor sleep']],\n    [19, 8, 'Migraine', 6, 'Ibuprofen', 'no', 9, ['Poor sleep', 'Weather']],\n    [16, 16, 'Tension', 4, 'Ibuprofen', 'yes', 2, ['Screen time']],\n    [12, 21, 'Migraine with aura', 8, 'Sumatriptan', 'yes', 6, ['Alcohol', 'Poor sleep']],\n    [9, 13, 'Tension', 5, 'Paracetamol', 'partly', 4, ['Stress']],\n    [6, 18, 'Tension', 3, '', '', 2, ['Skipped meal']],\n    [5, 7, 'Migraine', 7, 'Sumatriptan', 'yes', 5, ['Poor sleep']],\n    [2, 15, 'Tension', 4, 'Ibuprofen', 'yes', 3, ['Stress', 'Screen time']],\n  ];\n  const sample = plan.map(([back, hour, type, intensity, medicine, relief, hours, triggers]) => {\n    const start = new Date(now.getFullYear(), now.getMonth(), now.getDate() - back, hour, 0);\n    const end = new Date(start.getTime() + hours * 3600000);\n    return { start: stamp(start), end: stamp(end), type, intensity, medicine, relief, triggers };\n  });\n  return { sample: true, entries: sample };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "stored",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "With nothing logged yet, this makes up eight weeks of headaches so the insights are not empty. They are never stored."
      },
      {
        "id": "ai-node-6",
        "name": "Type options",
        "type": "customfunction",
        "x": 760,
        "y": 2485,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(lists) => lists?.types ?? []",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "lists",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
