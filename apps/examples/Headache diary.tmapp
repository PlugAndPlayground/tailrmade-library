      {
        "id": "ai-node-26",
        "name": "Summary text",
        "type": "customfunction",
        "x": 3790,
        "y": 5781,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(diary) => {\n  const entries = diary?.entries ?? [];\n  const escape = (text) => String(text).replace(/([\\\\`*_{}[\\]()#+\\-.!|<>~])/g, '\\\\$1');\n  const lead = diary?.sample ? '[Sample diary]{.secondary}: log your first headache and it is replaced by yours.\\n' : '';\n  const now = new Date();\n  const from = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 29);\n  const parse = (s) => {\n    const [y, m, d] = String(s).slice(0, 10).split('-').map(Number);\n    return new Date(y, m - 1, d);\n  };\n  const recent = entries.filter((entry) => parse(entry.start) >= from);\n  if (recent.length === 0) return `${lead}No headaches in the last 30 days.`;\n  const days = new Set(recent.map((entry) => entry.start.slice(0, 10))).size;\n  const medicineDays = new Set(recent.filter((entry) => entry.medicine).map((entry) => entry.start.slice(0, 10))).size;\n  const average = (recent.reduce((sum, entry) => sum + Number(entry.intensity || 0), 0) / recent.length).toFixed(1).replace(/\\.0$/, '');\n  const counts = {};\n  for (const entry of recent) counts[entry.type] = (counts[entry.type] ?? 0) + 1;\n  const top = Object.keys(counts).sort((a, b) => counts[b] - counts[a])[0];\n  const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`;\n  // Pain medicine on 10 or more days a month is the usual threshold for medication-overuse headache.\n  const overuse = medicineDays >= 10\n    ? '\\n[Medicine on 10 or more days a month]{.warning} can itself cause headaches (medication-overuse headache). Worth raising with your doctor.'\n    : '';\n  return `${lead}**${plural(days, 'headache day')}** in the last 30 · average **${average}/10** · mostly **${escape(top)}** · medicine on **${plural(medicineDays, 'day')}**${overuse}`;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "diary",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
