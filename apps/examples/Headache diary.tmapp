            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(stored, helped) => {\n  // Runs only when It's over is pressed. Ends the newest open headache.\n  const entries = Array.isArray(stored?.entries) ? [...stored.entries] : [];\n  const pad = (n) => String(n).padStart(2, '0');\n  const now = new Date();\n  const stamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;\n  for (let i = entries.length - 1; i >= 0; i -= 1) {\n    if (entries[i].end) continue;\n    // Not sure stores no answer.\n    const answer = { Yes: 'yes', Partly: 'partly', No: 'no' }[helped] ?? '';\n    entries[i] = { ...entries[i], end: stamp, relief: entries[i].medicine ? answer : '' };\n    break;\n  }\n  return { entries };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
