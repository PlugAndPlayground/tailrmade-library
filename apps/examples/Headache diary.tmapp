            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "trigger",
            "name": "Execute",
            "dataType": "{\"class\":\"TriggerType\"}",
            "data": 0
          },
          {
            "socketType": "out",
            "name": "Success",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "out",
            "name": "Error",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
