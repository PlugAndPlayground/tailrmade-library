      {
        "id": "ai-node-49",
        "name": "Lists with change",
        "type": "customfunction",
        "x": 6560,
        "y": 8773,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(lists, name, action) => {\n  // Stores only the two lists; Lists adds the presets back when they are missing.\n  // Runs only when Save change is pressed. Matching ignores case, so \"ibuprofen\" finds Ibuprofen.\n  const types = [...(lists?.types ?? [])];\n  const meds = [...(lists?.meds ?? [])];\n  const clean = String(name ?? '').replace(/\\s+/g, ' ').trim().slice(0, 40);\n  if (!clean) return { types, meds };\n  const same = (item) => item.toLowerCase() === clean.toLowerCase();\n  if (action === 'Add as a type' && !types.some(same)) types.push(clean);\n  if (action === 'Add as a medicine' && !meds.some(same)) meds.push(clean);\n  if (action === 'Remove') return { types: types.filter((item) => !same(item)), meds: meds.filter((item) => !same(item)) };\n  return { types, meds };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "lists",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "name",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "action",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "trigger",
            "name": "Trigger 1",
            "dataType": "{\"class\":\"TriggerType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": false,
          "update": false,
          "interval": false
        },
        "version": 3,
        "comment": "Runs only when Save change is pressed."
      },
