      {
        "id": "ai-node-34",
        "name": "Triggers text",
        "type": "customfunction",
        "x": 3790,
        "y": 6477,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(diary) => {\n  const escape = (text) => String(text).replace(/([\\\\`*_{}[\\]()#+\\-.!|<>~])/g, '\\\\$1');\n  const entries = diary?.entries ?? [];\n  const counts = {};\n  for (const entry of entries) {\n    for (const trigger of entry.triggers ?? []) {\n      const row = (counts[trigger] = counts[trigger] ?? { count: 0, types: {} });\n      row.count += 1;\n      row.types[entry.type] = (row.types[entry.type] ?? 0) + 1;\n    }\n  }\n  const top = Object.keys(counts).sort((a, b) => counts[b].count - counts[a].count).slice(0, 5);\n  if (top.length === 0) return 'Tick possible triggers when you log, and the most common show up here.';\n  return top.map((trigger) => {\n    const row = counts[trigger];\n    const [type, n] = Object.entries(row.types).sort((a, b) => b[1] - a[1])[0];\n    return `**${escape(trigger)}** before ${row.count} of ${entries.length} [· ${n === row.count ? 'all' : `${n} of them`} ${escape(type)}]{.muted}`;\n  }).join('\\n');\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "diary",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
