      {
        "id": "fast-shrimp-67",
        "name": "Roughness slider",
        "type": "widgetslider",
        "x": 0,
        "y": 1300,
        "width": 200,
        "height": 104,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Initial Value",
            "dataType": "{\"class\":\"NumberType\"}",
            "data": 2,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Min",
            "dataType": "{\"class\":\"NumberType\"}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Max",
            "dataType": "{\"class\":\"NumberType\"}",
            "data": 10,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Decimals",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":10,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Label",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "Roughness: {{value}}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Commit",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"While dragging\"},{\"text\":\"On release\"}],\"showAsButtons\":true}}",
            "data": "While dragging",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Color",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"primary\"},{\"text\":\"secondary\"},{\"text\":\"success\"},{\"text\":\"error\"},{\"text\":\"info\"},{\"text\":\"warning\"}],\"showAsButtons\":true}}",
            "data": "primary",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Size",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Inherit\"},{\"text\":\"XS\"},{\"text\":\"S\"},{\"text\":\"M\"},{\"text\":\"L\"},{\"text\":\"XL\"}],\"showAsButtons\":true}}",
            "data": "XS",
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Out",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
