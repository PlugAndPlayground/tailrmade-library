      {
        "id": "friendly-mayfly-97",
        "name": "Sketch plot",
        "type": "customfunction",
        "x": 520,
        "y": 1060,
        "width": 160,
        "height": 184,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(Plot, svg2roughjs, roughness, data, theme) => {\n  const plot = Plot.plot({\n    width: 360,\n    height: 260,\n    marginTop: 24,\n    marginRight: 8,\n    marginBottom: 28,\n    marginLeft: 36,\n    style: { background: 'transparent' },\n    x: { label: null },\n    y: { label: 'Frequency' },\n    marks: [Plot.barY(data, { x: 'letter', y: 'frequency', fill: 'fill' })],\n  });\n\n  // The sketcher can't read currentColor from a chart that isn't on the page.\n  const ink = theme?.tokens?.['text.primary'] ?? '#888888';\n  ['fill', 'stroke'].forEach((attribute) => {\n    plot.querySelectorAll(`[${attribute}=\"currentColor\"]`).forEach((element) => {\n      element.setAttribute(attribute, ink);\n    });\n  });\n\n  const container = document.createElement('div');\n  const sketcher = new svg2roughjs.Svg2Roughjs(\n    container,\n    svg2roughjs.OutputType.SVG,\n    { roughness, fillStyle: 'hachure' },\n  );\n  sketcher.fontFamily = null;\n  sketcher.svg = plot;\n  return sketcher.sketch().then(() => {\n    const svg = container.querySelector('svg');\n    svg.setAttribute('viewBox', `0 0 ${svg.getAttribute('width')} ${svg.getAttribute('height')}`);\n    svg.removeAttribute('width');\n    svg.removeAttribute('height');\n    svg.style.width = '100%';\n    svg.style.height = 'auto';\n    svg.style.display = 'block';\n    // The sketcher drops the chart's type size and font.\n    svg.querySelectorAll('text').forEach((label) => {\n      label.style.fontSize = '11px';\n      label.style.fill = ink;\n      label.style.fontFamily = 'inherit';\n    });\n    return container;\n  });\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": true,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Plot",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "svg2roughjs",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "roughness",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "data",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "theme",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {}
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Main Thread stays on: svg2roughjs redraws an SVG in the DOM, and neither the DOM nor the package reaches the sandbox."
      },
      {
        "id": "old-sloth-38",
        "name": "Draw cube",
        "type": "customfunction",
        "x": 520,
        "y": 1940,
        "width": 160,
        "height": 184,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(THREE, width, height, depth, theme) => {\n  const color = theme?.tokens?.primary ?? '#888888';\n\n  // One canvas and one animation loop, however often the sliders change.\n  let canvas = window.__drawCubeCanvas;\n  if (canvas) {\n    const { mesh, material } = canvas.__scene;\n    mesh.geometry.dispose();\n    mesh.geometry = new THREE.BoxGeometry(width, height, depth);\n    material.color.set(color);\n    return canvas;\n  }\n\n  const camera = new THREE.PerspectiveCamera(70, 4 / 3, 0.01, 10);\n  camera.position.z = 1;\n\n  const scene = new THREE.Scene();\n  scene.add(new THREE.AmbientLight(0xffffff, 1.2));\n  const light = new THREE.DirectionalLight(0xffffff, 2.5);\n  light.position.set(1, 1, 2);\n  scene.add(light);\n\n  const material = new THREE.MeshStandardMaterial({ color });\n  const mesh = new THREE.Mesh(new THREE.BoxGeometry(width, height, depth), material);\n  scene.add(mesh);\n\n  // Transparent, so the theme's card shows behind the cube.\n  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n  renderer.setSize(400, 300, false);\n  renderer.setAnimationLoop((time) => {\n    mesh.rotation.x = time / 2000;\n    mesh.rotation.y = time / 1000;\n    renderer.render(scene, camera);\n  });\n\n  canvas = renderer.domElement;\n  canvas.style.display = 'block';\n  canvas.__scene = { mesh, material };\n  window.__drawCubeCanvas = canvas;\n  return canvas;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": true,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "THREE",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "width",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "height",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "depth",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "theme",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {}
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
