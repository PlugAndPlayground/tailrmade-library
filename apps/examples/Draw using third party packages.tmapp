            "data": "(label, data, color) => {\n\t\n\tconst bgColor = color.map((c) => {\n\t\treturn c.rgb();\n\t})\n\n\tconst object = label.map((item, index) => ({\n\t\t\"letter\": item,\n\t\t'frequency': data[index],\n\t\t'fill': bgColor[index]\n\t}));\n\n\treturn object;\n}",
