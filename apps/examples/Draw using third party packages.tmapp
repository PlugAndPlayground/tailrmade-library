      {
        "id": "friendly-mayfly-97",
        "name": "",
        "type": "customfunction",
        "x": 1794,
        "y": -174,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(Plot, svg2roughjs, roughness, data) => {\n  const plot = Plot.plot({\n    marginTop: 20,\n    marginRight: 20,\n    marginBottom: 30,\n    marginLeft: 40,\n    grid: true,\n    marks: [\n      Plot.barY(data, {x: \"letter\", y: \"frequency\", fill: \"fill\"}),\n    ]\n  });\n\n  const container = document.createElement('div');\n  container.style.width = '100%';\n  container.style.height = '100%';\n  \n  // Convert to sketchy\n  const sketcher = new svg2roughjs.Svg2Roughjs(container, \n      svg2roughjs.OutputType.SVG,\n  {\n    roughness: roughness,\n    fillStyle: \"hachure\"\n  });\n  sketcher.svg = plot;\n  sketcher.sketch();\n\n  const svg = container.querySelector('svg');\n  const width = svg.getAttribute('width');\n  const height = svg.getAttribute('height');\n  svg.setAttribute('viewBox', `0 0 ${width} ${height}`);\n  svg.removeAttribute('width');\n  svg.removeAttribute('height');\n  svg.style.width = '100%';\n  svg.style.height = '100%';\n\n  \n  return container;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": true,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Plot",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "svg2roughjs",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "roughness",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "data",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
