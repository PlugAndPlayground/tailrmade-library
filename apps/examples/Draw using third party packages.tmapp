      {
        "id": "wet-fish-74",
        "name": "Chart data",
        "type": "customfunction",
        "x": 520,
        "y": 560,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(rows, theme) => {\n  // Bars fade from the theme's primary to its secondary color.\n  const tokens = theme?.tokens ?? {};\n  const primary = tokens.primary ?? '#888888';\n  const secondary = tokens.secondary ?? primary;\n  const toRgb = (hex) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));\n  const isHex = (color) => /^#[0-9a-f]{6}$/i.test(color);\n  const list = Array.isArray(rows) ? rows : [];\n  return list.map((row, index) => {\n    if (!isHex(primary) || !isHex(secondary)) return { ...row, fill: primary };\n    const t = list.length > 1 ? index / (list.length - 1) : 0;\n    const a = toRgb(primary);\n    const b = toRgb(secondary);\n    const [red, green, blue] = a.map((v, i) => Math.round(v + (b[i] - v) * t));\n    return { ...row, fill: `rgb(${red}, ${green}, ${blue})` };\n  });\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "rows",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "theme",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {}
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
