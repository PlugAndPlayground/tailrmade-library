      {
        "id": "old-sloth-38",
        "name": "threejs",
        "type": "customfunction",
        "x": 1790,
        "y": 640,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(THREE, x, y, z) => {\n  // Get or create canvas with Three.js objects attached to it\n  let canvas = window.__threeCanvas;\n  let renderer, scene, camera, mesh;\n\n  if (canvas && canvas.__threeRenderer) {\n    // Reuse existing canvas and its attached objects\n    renderer = canvas.__threeRenderer;\n    scene = canvas.__threeScene;\n    camera = canvas.__threeCamera;\n    mesh = canvas.__threeMesh;\n    \n    // Update the geometry with new parameters\n    mesh.geometry.dispose();\n    mesh.geometry = new THREE.BoxGeometry(x, y, z);\n    \n    return canvas;\n  }\n\n  // First time: create everything\n  const width = 400, height = 300; // Default size\n  \n  camera = new THREE.PerspectiveCamera(70, width / height, 0.01, 10);\n  camera.position.z = 1;\n\n  scene = new THREE.Scene();\n\n  const geometry = new THREE.BoxGeometry(x, y, z);\n  const material = new THREE.MeshNormalMaterial();\n\n  mesh = new THREE.Mesh(geometry, material);\n  scene.add(mesh);\n\n  renderer = new THREE.WebGLRenderer({ antialias: true });\n  renderer.setSize(width, height);\n  \n  canvas = renderer.domElement;\n  \n  // Set CSS to make it responsive (optional)\n  canvas.style.width = '100%';\n  canvas.style.height = '100%';\n  canvas.style.display = 'block';\n  \n  // Store references on the canvas itself instead of window\n  canvas.__threeRenderer = renderer;\n  canvas.__threeScene = scene;\n  canvas.__threeCamera = camera;\n  canvas.__threeMesh = mesh;\n  \n  // Store canvas reference for retrieval\n  window.__threeCanvas = canvas;\n\n  // Animation loop\n  function animation(time) {\n    mesh.rotation.x = time / 2000;\n    mesh.rotation.y = time / 1000;\n    renderer.render(scene, camera);\n  }\n  \n  renderer.setAnimationLoop(animation);\n\n  return canvas;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": true,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "THREE",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "x",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":0,\"maxValue\":1,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}"
          },
          {
            "socketType": "in",
            "name": "y",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":0,\"maxValue\":1,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}"
          },
          {
            "socketType": "in",
            "name": "z",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":0,\"maxValue\":1,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
