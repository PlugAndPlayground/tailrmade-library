      {
        "id": "pink-elephant-73",
        "type": "customfunction",
        "x": 0,
        "y": 2085,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(r) => {\n  const { brand } = r;\n  return `<div class=\"text-gray-900 font-serif p-6 max-w-2xl border-b border-gray-300 bg-white shadow-sm rounded-lg mb-4\">\n    <h2 class=\"text-2xl md:text-3xl font-bold mb-3 text-gray-800\">${brand} Raises $50M Series B to Revolutionize Tech Industry</h2>\n    <p class=\"text-base text-gray-600 mb-4\">The startup's innovative approach has attracted major investors as it plans global expansion</p>\n    <div class=\"text-sm text-gray-500 flex items-center\">\n      <span class=\"font-medium uppercase\">TECH INSIDER</span>\n      <span class=\"mx-2\">•</span>\n      <span>2 HOURS AGO</span>\n    </div>\n  </div>`;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "r",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "name": "News markup"
      },
