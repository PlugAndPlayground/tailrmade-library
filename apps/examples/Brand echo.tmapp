            "data": "(r) => {\n  const { brand } = r;\n  return `<div class=\"text-gray-900 font-sans p-5 bg-white\">\n    <!-- Search Bar -->\n    <div class=\"flex items-center mb-6\">\n      <div class=\"flex items-center flex-grow border border-gray-200 rounded-full px-4 py-2 shadow-sm hover:shadow-md transition-shadow\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-gray-400 mr-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n        </svg>\n        <input type=\"text\" value=\"${brand}\" class=\"flex-grow outline-none text-gray-700\" />\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-blue-500 ml-2\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z\" />\n        </svg>\n      </div>\n    </div>\n    \n    <!-- Tabs -->\n    <div class=\"flex flex-wrap border-b border-gray-200 mb-5 text-sm\">\n      <div class=\"flex items-center text-blue-500 border-b-4 border-blue-500 pb-2 px-3 mr-4\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 mr-1\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n        </svg>\n        All\n      </div>\n      <div class=\"flex items-center text-gray-500 pb-2 px-3 mr-4 hover:text-blue-500 cursor-pointer\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 mr-1\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\" />\n        </svg>\n        Images\n      </div>\n      <div class=\"flex items-center text-gray-500 pb-2 px-3 mr-4 hover:text-blue-500 cursor-pointer\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 mr-1\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z\" />\n        </svg>\n        Videos\n      </div>\n      <div class=\"flex items-center text-gray-500 pb-2 px-3 hover:text-blue-500 cursor-pointer\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 mr-1\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\" />\n        </svg>\n        News\n      </div>\n    </div>\n    \n    <!-- Results Count -->\n    <div class=\"text-sm text-gray-500 mb-5\">About 18,400,000 results (0.62 seconds)</div>\n    \n    <!-- Results -->\n    <div class=\"space-y-8\">\n      <!-- Result 1 -->\n      <div>\n        <div class=\"flex items-start\">\n          <div class=\"flex-grow\">\n            <div class=\"text-sm text-gray-600 mb-1\">${brand.toLowerCase()}.io › home › features</div>\n            <a href=\"#\" class=\"text-xl text-blue-800 hover:underline font-medium mb-1 block\">${brand} - Build Interactive Workflows Without Code</a>\n          </div>\n        </div>\n        <div class=\"text-sm text-gray-700 mb-1\">\n          ${brand} is a visual programming platform that allows users to create workflows, data visualizations, and interactive applications without writing code.\n        </div>\n        <div class=\"flex flex-wrap gap-x-4 gap-y-1 text-sm\">\n          <a href=\"#\" class=\"text-blue-800 hover:underline\">Features</a>\n          <a href=\"#\" class=\"text-blue-800 hover:underline\">Pricing</a>\n          <a href=\"#\" class=\"text-blue-800 hover:underline\">Documentation</a>\n        </div>\n      </div>\n      \n      <!-- Result 2 -->\n      <div>\n        <div class=\"text-sm text-gray-600 mb-1\">github.com › acme › ${brand.toLowerCase()}</div>\n        <a href=\"#\" class=\"text-xl text-blue-800 hover:underline font-medium mb-1 block\">GitHub - Acme/${brand}: Open source visual programming ...</a>\n        <div class=\"text-sm text-gray-700 mb-1\">\n          ${brand} is an open-source visual programming environment for creating data-driven applications. Star: 12.4k · Fork: 2.3k · Last updated: 2 days ago.\n        </div>\n      </div>\n      \n      <!-- Result 3 with rich snippet -->\n      <div class=\"border border-gray-200 rounded-lg overflow-hidden\">\n        <div class=\"p-4\">\n          <div class=\"text-sm text-gray-600 mb-1\">techcrunch.com › 2023/09/15 › ${brand.toLowerCase()}-raises-50m</div>\n          <a href=\"#\" class=\"text-xl text-blue-800 hover:underline font-medium mb-1 block\">${brand} Raises $50M Series B to Revolutionize No-Code Development</a>\n          <div class=\"text-sm text-gray-700 mb-3\">\n            Sep 15, 2023 — ${brand}, the visual programming platform founded in 2020, has secured $50 million in Series B funding led by Accel with participation from...\n          </div>\n          <div class=\"flex items-center text-sm\">\n            <span class=\"text-gray-500 mr-2\">Rating:</span>\n            <div class=\"flex text-yellow-400\">\n              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n            </div>\n            <span class=\"text-gray-500 ml-2\">(128)</span>\n          </div>\n        </div>\n      </div>\n      \n      <!-- Result 4 -->\n      <div>\n        <div class=\"text-sm text-gray-600 mb-1\">medium.com › @techinsider › how-${brand.toLowerCase()}-changed-our-workflow</div>\n        <a href=\"#\" class=\"text-xl text-blue-800 hover:underline font-medium mb-1 block\">How ${brand} Changed Our Team's Productivity Overnight</a>\n        <div class=\"text-sm text-gray-700 mb-1\">\n          May 15, 2023 — When our team first discovered ${brand}, we were skeptical. Another productivity tool in an already crowded market? But after just two weeks...\n        </div>\n      </div>\n      \n      <!-- People also ask -->\n      <div class=\"border border-gray-200 rounded-lg overflow-hidden mb-6\">\n        <div class=\"p-4 bg-gray-50 border-b border-gray-200\">\n          <h3 class=\"font-medium text-gray-900\">People also ask</h3>\n        </div>\n        <div class=\"divide-y divide-gray-200\">\n          <div class=\"p-4 hover:bg-gray-50 cursor-pointer\">\n            <div class=\"flex justify-between items-center\">\n              <p class=\"text-sm text-gray-800\">What is ${brand} used for?</p>\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-gray-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\" />\n              </svg>\n            </div>\n          </div>\n          <div class=\"p-4 hover:bg-gray-50 cursor-pointer\">\n            <div class=\"flex justify-between items-center\">\n              <p class=\"text-sm text-gray-800\">Is ${brand} free to use?</p>\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-gray-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\" />\n              </svg>\n            </div>\n          </div>\n          <div class=\"p-4 hover:bg-gray-50 cursor-pointer\">\n            <div class=\"flex justify-between items-center\">\n              <p class=\"text-sm text-gray-800\">How does ${brand} compare to other no-code tools?</p>\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-gray-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\" />\n              </svg>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <!-- Related searches -->\n      <div class=\"mt-8\">\n        <h3 class=\"text-base font-medium text-gray-900 mb-3\">Related searches</h3>\n        <div class=\"grid grid-cols-2 gap-2 md:grid-cols-3\">\n          <div class=\"flex items-center p-3 bg-gray-50 rounded-lg hover:bg-gray-100 cursor-pointer\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 text-gray-500 mr-2\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n            </svg>\n            <span class=\"text-sm text-gray-800\">${brand} tutorial</span>\n          </div>\n          <div class=\"flex items-center p-3 bg-gray-50 rounded-lg hover:bg-gray-100 cursor-pointer\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 text-gray-500 mr-2\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n            </svg>\n            <span class=\"text-sm text-gray-800\">${brand} vs Zapier</span>\n          </div>\n          <div class=\"flex items-center p-3 bg-gray-50 rounded-lg hover:bg-gray-100 cursor-pointer\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 text-gray-500 mr-2\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n            </svg>\n            <span class=\"text-sm text-gray-800\">${brand} pricing</span>\n          </div>\n        </div>\n      </div>\n      \n      <!-- Pagination -->\n      <div class=\"flex justify-center items-center mt-10 text-sm\">\n        <div class=\"flex items-center\">\n          <span class=\"text-blue-500 font-medium px-3 py-2\">1</span>\n          <a href=\"#\" class=\"text-blue-800 hover:underline px-3 py-2\">2</a>\n          <a href=\"#\" class=\"text-blue-800 hover:underline px-3 py-2\">3</a>\n          <a href=\"#\" class=\"text-blue-800 hover:underline px-3 py-2\">4</a>\n          <a href=\"#\" class=\"text-blue-800 hover:underline px-3 py-2\">5</a>\n          <span class=\"px-3 py-2\">...</span>\n          <a href=\"#\" class=\"text-blue-800 hover:underline px-3 py-2\">Next</a>\n        </div>\n      </div>\n    </div>\n  </div>`;\n}",
