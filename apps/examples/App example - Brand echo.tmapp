            "data": "(brand) => {\n  return `<div class=\"font-serif p-6 max-w-2xl border-b border-gray-300 bg-white shadow-sm rounded-lg mb-4\">\n    <h2 class=\"text-2xl md:text-3xl font-bold mb-3 text-gray-800\">${brand} Raises $50M Series B to Revolutionize Tech Industry</h2>\n    <p class=\"text-base text-gray-600 mb-4\">The startup's innovative approach has attracted major investors as it plans global expansion</p>\n    <div class=\"text-sm text-gray-500 flex items-center\">\n      <span class=\"font-medium uppercase\">TECH INSIDER</span>\n      <span class=\"mx-2\">•</span>\n      <span>2 HOURS AGO</span>\n    </div>\n  </div>`;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
