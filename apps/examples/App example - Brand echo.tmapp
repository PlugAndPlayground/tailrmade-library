            "data": "(brand, noun, url) => {\n  return `<div class=\"font-sans p-5 max-w-2xl border border-gray-200 rounded-lg shadow-sm bg-gray-50 mb-4\">\n    <div class=\"flex items-center mb-4\">\n      <div class=\"w-11 h-11 rounded-full bg-[#E154BB] mr-3 flex items-center justify-center text-white font-bold flex-shrink-0\">\n        ${brand.split(' ').map(word => word[0]).join('')}\n      </div>\n      <div>\n        <div class=\"font-bold text-gray-900 text-base\">${brand}</div>\n        <div class=\"text-gray-500 text-sm\">Community Share</div>\n      </div>\n    </div>\n    <div class=\"mb-4 p-4 bg-white border border-gray-200 rounded-md shadow-sm\">\n      <div class=\"font-medium text-lg mb-2 text-gray-900\">Interactive ${brand} Dashboard</div>\n      <div class=\"text-gray-700 mb-3 text-sm leading-relaxed\">\n        Look at the ${noun} I made with ${brand}! It visualizes data in real-time and connects to multiple APIs. You can filter, sort, and export the results.\n      </div>\n      <div class=\"w-full h-44 bg-gray-100 mb-3 flex items-center justify-center text-gray-500 rounded border border-dashed border-gray-300\">\n        <img src=\"${url}\" alt=\"Real-time results demonstration\" class=\"object-cover w-full h-full\" />\n      </div>\n      <div class=\"flex justify-between items-center\">\n        <div class=\"text-gray-500 text-xs\">Created 2 days ago · 15 nodes · 24 connections</div>\n        <button class=\"px-3 py-1.5 bg-[#E154BB] hover:bg-[#c9399f] text-white rounded text-xs font-medium transition-colors\">\n          Open ${noun}\n        </button>\n      </div>\n    </div>\n    <div class=\"flex justify-between text-sm text-gray-500\">\n      <div>\n        <span class=\"text-[#E154BB] font-medium hover:underline cursor-pointer\">18 Likes</span> · \n        <span class=\"text-[#E154BB] font-medium hover:underline cursor-pointer\">5 Forks</span>\n      </div>\n      <div class=\"space-x-3\">\n        <button class=\"hover:text-gray-700 transition-colors\">Share</button>\n        <button class=\"hover:text-gray-700 transition-colors\">Download</button>\n        <button class=\"hover:text-gray-700 transition-colors\">Report</button>\n      </div>\n    </div>\n  </div>`;\n}",
