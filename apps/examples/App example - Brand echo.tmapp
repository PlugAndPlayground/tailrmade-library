            "data": "(brand) => {\n  return `<div class=\"font-sans p-5 max-w-2xl border border-gray-200 rounded-md shadow-sm bg-white mb-4 hover:border-gray-300\">\n    <div class=\"flex items-center mb-4\">\n      <div class=\"mr-3\">\n        <svg height=\"32\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"32\" aria-hidden=\"true\" class=\"text-gray-500 fill-current\">\n          <path fill-rule=\"evenodd\" d=\"M2 2.5A2.5 2.5 0 014.5 0h8.75a.75.75 0 01.75.75v12.5a.75.75 0 01-.75.75h-2.5a.75.75 0 110-1.5h1.75v-2h-8a1 1 0 00-.714 1.7.75.75 0 01-1.072 1.05A2.495 2.495 0 012 11.5v-9zm10.5-1V9h-8c-.356 0-.694.074-1 .208V2.5a1 1 0 011-1h8zM5 12.25v3.25a.25.25 0 00.4.2l1.45-1.087a.25.25 0 01.3 0L8.6 15.7a.25.25 0 00.4-.2v-3.25a.25.25 0 00-.25-.25h-3.5a.25.25 0 00-.25.25z\"></path>\n        </svg>\n      </div>\n      <div>\n        <h3 class=\"m-0 text-xl font-semibold\">\n          <a href=\"#\" class=\"text-blue-600 hover:underline\">acme/${brand.toLowerCase()}</a>\n        </h3>\n        <p class=\"mt-1 text-gray-600 text-sm\">Modern solution for productivity and workflow automation</p>\n      </div>\n    </div>\n    <div class=\"mb-4 flex items-center\">\n      <span class=\"flex items-center mr-4\">\n        <span class=\"mr-1 text-gray-500\">\n          <svg aria-label=\"star\" height=\"16\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" role=\"img\" class=\"fill-current\">\n            <path fill-rule=\"evenodd\" d=\"M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25zm0 2.445L6.615 5.5a.75.75 0 01-.564.41l-3.097.45 2.24 2.184a.75.75 0 01.216.664l-.528 3.084 2.769-1.456a.75.75 0 01.698 0l2.77 1.456-.53-3.084a.75.75 0 01.216-.664l2.24-2.183-3.096-.45a.75.75 0 01-.564-.41L8 2.694v.001z\"></path>\n          </svg>\n        </span>\n        <span class=\"text-gray-900 font-medium\">