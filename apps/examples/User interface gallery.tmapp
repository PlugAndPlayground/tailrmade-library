      {
        "id": "ai-node-61",
        "name": "Describe the order",
        "type": "customfunction",
        "x": 1830,
        "y": 9946,
        "width": 160,
        "height": 232,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(size, extras, toGo, origin, notes, shop, tags) => {\n\t// Lists need joining, so the sentence is written here and sent to a Text node's Content as Markdown.\n\tconst list = (a) => (Array.isArray(a) && a.length ? a.join(\", \") : \"none\");\n\treturn [\n\t\t\"A **\" + (size || \"Medium\") + \"** coffee from **\" + (origin || \"anywhere\") + \"**, \" + (toGo ? \"to go.\" : \"to drink here.\"),\n\t\t\"Extras: \" + list(extras) + \"  •  Notes: \" + list(notes),\n\t\t\"Pick up at \" + (shop || \"any shop\") + \"  •  Tags: \" + list(tags),\n\t].join(\"\\n\");\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "size",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "extras",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "toGo",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "in",
            "name": "origin",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "notes",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "shop",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "tags",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
