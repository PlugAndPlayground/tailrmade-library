      {
        "id": "ai-node-1",
        "name": "Start here",
        "type": "label",
        "x": 0,
        "y": 0,
        "width": 2369,
        "height": 314,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1280,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Input",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "Start here: this app is a tour of Tailrmade's user interface.\nGroup 1 is the theme, group 2 the navigation, header and footer every page shares.\nGroups 3 to 7 are the five pages, in tab order. The Inputs page (6) holds four smaller pages.\nThe page on the left is a UI surface node: press its tab, then find the node of that name here."
          },
          {
            "socketType": "in",
            "name": "Font size",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":100,\"stepSize\":1,\"showDetails\":false,\"presetValues\":[{\"text\":\"Small\",\"value\":12},{\"text\":\"Normal\",\"value\":16},{\"text\":\"H5\",\"value\":20},{\"text\":\"H4\",\"value\":24},{\"text\":\"H3\",\"value\":28},{\"text\":\"H2\",\"value\":32},{\"text\":\"H1\",\"value\":40}]}}",
            "data": 56,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Text alignment",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Left\",\"value\":\"left\"},{\"text\":\"Center\",\"value\":\"center\"},{\"text\":\"Right\",\"value\":\"right\"}],\"showAsButtons\":true}}",
            "data": "Left",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Font weight",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Regular\",\"value\":\"400\"},{\"text\":\"Bold\",\"value\":\"700\"}],\"showAsButtons\":true}}",
            "data": "Regular",
