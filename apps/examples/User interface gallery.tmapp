      {
        "id": "ai-node-86",
        "name": "Build the stage",
        "type": "customfunction",
        "x": 480,
        "y": 15774,
        "width": 160,
        "height": 232,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(direction, align, justify, gap, emphasis, tone, count) => {\n\t// Writes the Stage surface's Layout JSON: the same tree the layout editor saves.\n\t// ROOT holds one box with the chosen settings, the box holds the numbered items.\n\tconst flex = { start: \"flex-start\", center: \"center\", end: \"flex-end\", stretch: \"stretch\",\n\t\t\"space-between\": \"space-between\", \"space-around\": \"space-around\", \"space-evenly\": \"space-evenly\" };\n\tconst clear = { r: 0, g: 0, b: 0, a: 0 };\n\tconst container = (parent, nodes, props) => ({\n\t\ttype: { resolvedName: \"Container\" }, displayName: \"Container\", isCanvas: true,\n\t\tprops: Object.assign({\n\t\t\tflexDirection: \"column\", alignItems: \"flex-start\", justifyContent: \"flex-start\",\n\t\t\twidth: \"100%\", height: \"auto\", padding: [0, 0, 0, 0], minWidth: \"0px\", minHeight: \"unset\",\n\t\t\tmaxWidth: \"unset\", maxHeight: \"unset\", gap: 0, background: clear, color: \"inherit\",\n\t\t\tmobileBehavior: \"column\", emphasis: \"none\", tone: \"neutral\", customStyles: {},\n\t\t}, props),\n\t\tcustom: {}, hidden: false, parent, nodes, linkedNodes: {},\n\t});\n\tconst text = (parent, content, variant) => ({\n\t\ttype: { resolvedName: \"Text\" }, displayName: \"Text\", isCanvas: false,\n\t\tprops: { content, variant, tone: \"default\", alignment: \"center\", customStyles: {} },\n\t\tcustom: {}, hidden: false, parent, nodes: [], linkedNodes: {},\n\t});\n\t// Different text sizes give the items different heights, so align has something to show.\n\tconst variants = [\"h2\", \"body\", \"h1\", \"caption\", \"h3\", \"body\"];\n\tconst n = Math.max(1, Math.min(6, Math.round(Number(count) || 1)));\n\tconst tree = {};\n\tconst items = [];\n\tfor (let i = 0; i < n; i++) {\n\t\tconst id = \"item\" + (i + 1);\n\t\titems.push(id);\n\t\ttree[id] = container(\"box\", [id + \"-text\"], {\n\t\t\twidth: \"auto\", minWidth: \"56px\", padding: [10, 16, 10, 16],\n\t\t\talignItems: \"center\", justifyContent: \"center\", emphasis: \"strong\", tone: \"neutral\",\n\t\t});\n\t\ttree[id + \"-text\"] = text(id, String(i + 1), variants[i]);\n\t}\n\ttree.box = container(\"ROOT\", items, {\n\t\tflexDirection: direction === \"column\" ? \"column\" : \"row\",\n\t\talignItems: flex[align] || \"center\",\n\t\tjustifyContent: flex[justify] || \"flex-start\",\n\t\tgap: Math.max(0, Number(gap) || 0),\n\t\tpadding: [16, 16, 16, 16],\n\t\tminHeight: \"300px\",\n\t\temphasis: emphasis || \"none\",\n\t\ttone: tone || \"neutral\",\n\t\t// Below 600px the row wraps instead of running off a phone screen.\n\t\tmobileBehavior: \"wrap\",\n\t});\n\tconst root = container(undefined, [\"box\"], {});\n\tdelete root.parent;\n\ttree.ROOT = root;\n\treturn { version: 1, tree };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "direction",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "align",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "justify",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "gap",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "emphasis",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "tone",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "count",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
