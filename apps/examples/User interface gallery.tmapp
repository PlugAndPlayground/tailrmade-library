      {
        "id": "ai-node-74",
        "name": "Colour as hex",
        "type": "customfunction",
        "x": 1780,
        "y": 14706,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(c) => {\n\t// The picker sends r, g and b from 0 to 255, sometimes with decimals.\n\tconst hex = (v) => Math.round(Math.max(0, Math.min(255, Number(v) || 0))).toString(16).padStart(2, \"0\");\n\treturn c ? \"#\" + hex(c.r) + hex(c.g) + hex(c.b) : \"none\";\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "c",
            "dataType": "{\"class\":\"ColorType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
