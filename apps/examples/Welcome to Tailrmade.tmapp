      {
        "id": "ai-node-43",
        "name": "Auto advance tick",
        "type": "customfunction",
        "x": 1300,
        "y": 1372,
        "width": 160,
        "height": 64,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "() => {\n\t// A step number that goes up every 1.2 s. It comes from the clock, so the\n\t// headline advances without writing to storage.\n\treturn Math.floor(Date.now() / 1200);\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": true,
          "intervalFrequency": 1200
        },
        "version": 3,
        "comment": "Every 1.2 s it outputs the next step from the clock, so the headline auto-advances with no storage and no risk."
      }
    ],
