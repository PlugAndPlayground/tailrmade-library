      {
        "id": "ai-node-17",
        "name": "Idea pool (shuffled)",
        "type": "customfunction",
        "x": 1300,
        "y": 1990,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(ideas) => {\n\t// Fisher-Yates shuffled fresh on every visit, and again when the list changes.\n\tconst out = Array.isArray(ideas) ? ideas.slice() : [];\n\tfor (let i = out.length - 1; i > 0; i--) {\n\t\tconst j = Math.floor(Math.random() * (i + 1));\n\t\tconst tmp = out[i];\n\t\tout[i] = out[j];\n\t\tout[j] = tmp;\n\t}\n\treturn out;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "ideas",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Shuffles the list once per page load, so every visit starts on a different word and walks a different order."
      },
      {
