      {
        "id": "curvy-quail-27",
        "name": "Rotating word",
        "type": "customfunction",
        "x": 1560,
        "y": 1970,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(ideas, tick) => {\n\t// The word at the current step in the shuffled pool.\n\tconst pool = Array.isArray(ideas) && ideas.length ? ideas : [\"app\"];\n\tconst idx = Math.max(0, Math.round(Number(tick) || 0)) % pool.length;\n\tconst word = String(pool[idx] ?? \"app\");\n\t// A CSS animation only restarts when its name changes, so the name follows the word.\n\tconst hash = [...word].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 0);\n\tconst name = `heroDrop${Math.abs(hash)}`;\n\treturn {\n\t\tword,\n\t\tanimation: {\n\t\t\t[`@keyframes ${name}`]: {\n\t\t\t\tfrom: { opacity: 0.25, transform: \"translateY(-0.3em)\" },\n\t\t\t\tto: { opacity: 1, transform: \"translateY(0)\" }\n\t\t\t},\n\t\t\tanimation: `${name} 340ms cubic-bezier(0.2,0.8,0.2,1)`\n\t\t}\n\t};\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "ideas",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "tick",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false,
          "intervalFrequency": 50
        },
        "version": 3
      },
