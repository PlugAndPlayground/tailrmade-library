      {
        "id": "ai-node-20",
        "name": "Preset picker",
        "type": "customfunction",
        "x": 1300,
        "y": 640,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(index) => {\n\t// Cycles through the app's built-in theme presets - no custom themes.\n\t// The id goes to the Theme node's Preset input, the name is shown in the caption.\n\tconst presets = [\n\t\t{ id: \"tailrmade\", name: \"Tailrmade\" },\n\t\t{ id: \"cloud\", name: \"Cloud\" },\n\t\t{ id: \"newsprint\", name: \"Newsprint\" },\n\t\t{ id: \"bauhaus\", name: \"Bauhaus\" },\n\t\t{ id: \"terminal\", name: \"Terminal\" },\n\t\t{ id: \"neon\", name: \"Neon\" }\n\t];\n\tconst i = Math.max(0, Math.min(presets.length - 1, Math.round(Number(index) || 0)));\n\treturn presets[i];\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "index",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
