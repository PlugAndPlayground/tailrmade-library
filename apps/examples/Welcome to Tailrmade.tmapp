      {
        "id": "ai-node-41",
        "name": "Pick headline",
        "type": "customfunction",
        "x": 1300,
        "y": 2370,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(ideas, people) => {\n\t// Picks one of two headlines per visit, at random:\n\t// \"Build your own <idea>\" or \"Create a personal app for <person>\".\n\tconst hasPeople = Array.isArray(people) && people.length > 0;\n\tif (hasPeople && Math.random() < 0.5) {\n\t\treturn { lead: \"Create a personal app for\", words: people };\n\t}\n\treturn { lead: \"Build your own\", words: Array.isArray(ideas) ? ideas : [] };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "ideas",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "people",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Flips a coin on each visit: the ideas headline or the people headline."
      },
      {
        "id": "ai-node-42",
        "name": "Headline words",
        "type": "jsonget",
        "x": 1300,
        "y": 2160,
        "width": 160,
        "height": 112,
