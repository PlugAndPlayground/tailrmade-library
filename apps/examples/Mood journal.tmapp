      {
        "id": "ai-node-8",
        "name": "Journal with today",
        "type": "customfunction",
        "x": 1300,
        "y": 1901,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(stored, mood, note, today) => {\n  // The whole journal is one stored object, one entry per day; saving again replaces today.\n  const journal = stored && typeof stored === 'object' && !Array.isArray(stored) ? stored : {};\n  return { ...journal, [today]: { mood: Number(mood) || 0, note: String(note ?? '').trim() } };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "stored",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "mood",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "note",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "today",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-9",
        "name": "Save journal",
        "type": "storagewrite",
        "x": 1600,
        "y": 1901,
        "width": 160,
        "height": 184,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Storage type",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Cloud\",\"disabled\":true},{\"text\":\"IndexedDB\"},{\"text\":\"Local storage\"}],\"showAsButtons\":true}}",
            "data": "IndexedDB",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Location",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "Mood journal example"
          },
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "journal"
          },
          {
            "socketType": "in",
            "name": "Value",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "Non-empty only",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Insert only",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Show Toast Notification",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "trigger",
            "name": "Execute",
            "dataType": "{\"class\":\"TriggerType\"}"
          },
          {
            "socketType": "out",
            "name": "Success",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "out",
            "name": "Error",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": false,
          "update": false,
          "interval": false
        },
        "comment": "Writes only when Save today is pressed. Non-empty only is off, so an empty journal could be written too."
      },
      {
        "id": "ai-node-10",
        "name": "Journal or sample",
        "type": "customfunction",
        "x": 2060,
        "y": 2997,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(stored, today) => {\n  const days = stored && typeof stored === 'object' && !Array.isArray(stored) ? stored : {};\n  if (Object.keys(days).length > 0) return { sample: false, days };\n  // Nothing saved yet: show three weeks of made-up days so the page has something to show.\n  const [y, m, d] = String(today).split('-').map(Number);\n  const notes = ['Long walk by the river', 'Too many meetings', '', 'Pizza with friends', '', 'Slept badly', 'Finished the book'];\n  const sample = {};\n  for (let back = 1; back <= 21; back += 1) {\n    if (back % 5 === 3) continue;\n    const day = new Date(y, m - 1, d - back);\n    const pad = (n) => String(n).padStart(2, '0');\n    const key = `${day.getFullYear()}-${pad(day.getMonth() + 1)}-${pad(day.getDate())}`;\n    sample[key] = { mood: [3, 2, 4, 1, 3, 3, 2][back % 7], note: notes[back % 7] };\n  }\n  return { sample: true, days: sample };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "stored",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "today",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "With nothing saved yet, this makes up three weeks of days so the page is not empty. They are never stored."
      },
      {
        "id": "ai-node-11",
        "name": "Calendar text",
        "type": "customfunction",
        "x": 2360,
        "y": 2997,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(journal, moods, today) => {\n  const days = journal?.days ?? {};\n  const emoji = (i) => String((moods ?? [])[i] ?? '').split(' ')[0];\n  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n  const pad = (n) => String(n).padStart(2, '0');\n  const key = (day) => `${day.getFullYear()}-${pad(day.getMonth() + 1)}-${pad(day.getDate())}`;\n  const [y, m, d] = String(today).split('-').map(Number);\n  const now = new Date(y, m - 1, d);\n  // Four rows of Monday to Sunday, ending with this week.\n  const monday = new Date(y, m - 1, d - ((now.getDay() + 6) % 7) - 21);\n  const rows = [];\n  for (let week = 0; week < 4; week += 1) {\n    const start = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + week * 7);\n    const cells = [];\n    for (let i = 0; i < 7; i += 1) {\n      const day = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);\n      const entry = days[key(day)];\n      if (day > now) break;\n      cells.push(entry ? emoji(entry.mood) : '⬜');\n    }\n    rows.push(`[${pad(start.getDate())} ${months[start.getMonth()]}]{.muted} ${cells.join(' ')}`);\n  }\n  return rows.join('\\n');\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "journal",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "moods",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "today",
            "dataType": "{\"class\":\"StringType\"}"
          },
