{
  "id": "Default/Mood journal",
  "location": "Default",
  "name": "Mood journal",
  "access": "private",
  "graphData": {
    "version": 7,
    "graphSettings": {
      "showExecutionVisualisation": true,
      "viewportCenterPosition": {
