      {
        "id": "ai-node-13",
        "name": "Summary text",
        "type": "customfunction",
        "x": 2360,
        "y": 3213,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(journal, moods, today) => {\n  const days = journal?.days ?? {};\n  const dates = Object.keys(days).sort();\n  if (dates.length === 0) return 'No check-ins yet.';\n  // Current streak: consecutive days with an entry, counting back from today or yesterday.\n  const [y, m, d] = String(today).split('-').map(Number);\n  const pad = (n) => String(n).padStart(2, '0');\n  const key = (day) => `${day.getFullYear()}-${pad(day.getMonth() + 1)}-${pad(day.getDate())}`;\n  let back = days[today] ? 0 : 1;\n  let streak = 0;\n  while (days[key(new Date(y, m - 1, d - back - streak))]) streak += 1;\n  const counts = {};\n  for (const date of dates) counts[days[date].mood] = (counts[days[date].mood] ?? 0) + 1;\n  const top = Object.keys(counts).sort((a, b) => counts[b] - counts[a])[0];\n  const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`;\n  const lead = journal.sample ? '[Sample days]{.secondary}: save your first check-in and they disappear.\\n' : '';\n  return `${lead}**${plural(dates.length, 'day')}** checked in · streak **${plural(streak, 'day')}** · most often **${(moods ?? [])[top] ?? ''}**`;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "journal",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "moods",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "today",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
