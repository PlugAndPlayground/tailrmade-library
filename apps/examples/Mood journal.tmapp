    "nodes": [
      {
        "id": "ai-node-1",
        "name": "Start here",
        "type": "label",
        "x": 0,
        "y": 0,
        "width": 3761,
        "height": 285,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1280,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
