            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Cloud\",\"disabled\":true},{\"text\":\"IndexedDB\"},{\"text\":\"Local storage\"}],\"showAsButtons\":true}}",
            "data": "IndexedDB",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Location",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "Mood journal example"
          },
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "journal"
          },
          {
            "socketType": "in",
            "name": "Fallback value",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {}
          },
          {
            "socketType": "in",
            "name": "Show Toast Notification",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "trigger",
            "name": "Trigger 1",
            "dataType": "{\"class\":\"TriggerType\",\"type\":{\"triggerType\":\"always\",\"customFunctionString\":\"\",\"showDetails\":false}}"
          },
          {
            "socketType": "trigger",
            "name": "Trigger 2",
            "dataType": "{\"class\":\"TriggerType\",\"type\":{\"triggerType\":\"always\",\"customFunctionString\":\"\",\"showDetails\":false}}"
          },
          {
            "socketType": "out",
            "name": "Value",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Error",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "Reads the whole journal from IndexedDB, which stays in this browser between visits. Its triggers re-read it after every save or delete, so the page always shows what is stored."
      },
