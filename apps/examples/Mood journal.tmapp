      {
        "id": "ai-node-15",
        "name": "Notes text",
        "type": "customfunction",
        "x": 2360,
        "y": 3429,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(journal, moods) => {\n  const days = journal?.days ?? {};\n  const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];\n  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n  // Notes are typed by the user and read as Markdown, so escape them.\n  const escape = (text) => text.replace(/\\s+/g, ' ').replace(/([\\\\`*_{}[\\]()#+\\-.!|<>~])/g, '\\\\$1');\n  const lines = Object.keys(days)\n    .sort()\n    .reverse()\n    .slice(0, 7)\n    .map((date) => {\n      const [y, m, d] = date.split('-').map(Number);\n      const day = new Date(y, m - 1, d);\n      const entry = days[date];\n      const note = entry.note ? ` · ${escape(entry.note)}` : '';\n      return `**${weekdays[day.getDay()]} ${d} ${months[m - 1]}** ${(moods ?? [])[entry.mood] ?? ''}${note}`;\n    });\n  return lines.length ? lines.join('\\n') : 'Nothing written yet.';\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "journal",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "moods",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Notes are typed by the user and read as Markdown, so they are escaped first."
      },
