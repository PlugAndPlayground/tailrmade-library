        },
        "version": 3
      },
      {
        "id": "artwork-url",
        "name": "Pick a result",
        "type": "customfunction",
        "x": 1034,
        "y": 2084,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(search) => {\n  const ids = search?.objectIDs ?? [];\n  // Van Gogh's Sunflowers, so a search without results still shows something.\n  const id = ids[Math.floor(Math.random() * ids.length)] ?? 436524;\n  return `https://collectionapi.metmuseum.org/public/collection/v1/objects/${id}`;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "search",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "artwork-values",
        "name": "Artwork values",
        "type": "customfunction",
        "x": 1634,
        "y": 2084,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(search, artwork) => {\n  const image = artwork?.primaryImageSmall ?? '';\n  const notes = [];\n  if (!search?.total) notes.push('Nothing found for that word, so here is one from the collection.');\n  if (!image) notes.push('The Met has no open image of this one. Press the button for another.');\n  return {\n    image,\n    title: artwork?.title ?? '',\n    artist: [artwork?.artistDisplayName, artwork?.objectDate].filter(Boolean).join(', '),\n    note: notes.join(' '),\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "search",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "artwork",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "artwork-picture",
        "name": "Artwork picture",
        "type": "htmlrenderer",
        "x": 1934,
        "y": 2084,
        "width": 320,
        "height": 240,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Html",
            "dataType": "{\"class\":\"HtmlType\"}",
            "data": "{{#if image}}<img src=\"{{image}}\" alt=\"{{title}}\" class=\"block w-full max-h-[480px] object-contain rounded-theme\" />{{/if}}"
          },
          {
            "socketType": "in",
            "name": "Data",
