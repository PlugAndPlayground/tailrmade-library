            "dataType": "{\"class\":\"ColorType\"}",
            "data": {
              "r": 0,
              "g": 0,
              "b": 0,
              "a": 0
            },
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Parsed Html",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "HtmlElement",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "The Met decides the address of the image, so this node keeps its network warning. A plain image tag loads it without asking the server for permission to read the pixels, which the Met does not give."
      },
