      {
        "id": "serious-lizard-51",
        "type": "imageshader",
        "x": 1280,
        "y": 2809,
        "width": 160,
        "height": 208,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Uniforms",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "Images",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "in",
            "name": "WebGL Vertex",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "\nin vec2 aPosition;\nin vec2 aUV;\nout vec2 UV;\n\nuniform mat3 uProjectionMatrix;\nuniform mat3 uWorldTransformMatrix;\n\nuniform mat3 uTransformMatrix;\n\n\nvoid main() {\n    mat3 mvp = uProjectionMatrix * uWorldTransformMatrix * uTransformMatrix;\n    gl_Position = vec4((mvp * vec3(aPosition, 1.0)).xy, 0.0, 1.0);\n\n    UV = aUV;\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "WebGL Fragment",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "in vec2 UV;\nuniform sampler2D Image;\nuniform float time;\nuniform float width;\nuniform float height;\nuniform float gamma;\nuniform float gain;\nuniform float blur;\n\nvoid main() {\n    // Calculate number of samples based on blur radius (clamped between 1 and 10)\n    int samples = int(min(max(floor(blur), 1.0), 10.0));\n    \n    // Dynamic weights calculation\n    float weights[10];\n    float sigma = float(samples) * 0.5;\n    float total = 0.0;\n    \n    // Calculate gaussian weights\n    for (int i = 0; i < 10; i++) {\n        if (i < samples) {\n            float x = float(i);\n            weights[i] = exp(-(x * x) / (2.0 * sigma * sigma));\n            total += (i == 0) ? weights[i] : 2.0 * weights[i];\n        }\n    }\n    \n    // Normalize weights\n    for (int i = 0; i < 10; i++) {\n        if (i < samples) {\n            weights[i] /= total;\n        }\n    }\n\n    vec2 texelSize = vec2(1.0/width, 1.0/height);\n    vec4 color = texture2D(Image, UV) * weights[0]; // Center pixel\n    \n    // Horizontal pass\n    for (int i = 1; i < 10; i++) {\n        if (i < samples) {\n            vec2 offset = vec2(texelSize.x * float(i), 0.0);\n            color += texture2D(Image, UV + offset) * weights[i];\n            color += texture2D(Image, UV - offset) * weights[i];\n        }\n    }\n    \n    // Vertical pass\n    vec4 blurColor = texture2D(Image, UV) * weights[0];\n    for (int i = 1; i < 10; i++) {\n        if (i < samples) {\n            vec2 offset = vec2(0.0, texelSize.y * float(i));\n            blurColor += texture2D(Image, UV + offset) * weights[i];\n            blurColor += texture2D(Image, UV - offset) * weights[i];\n        }\n    }\n    \n    // Combine passes\n    color = (color + blurColor) * 0.5;\n    \n\n    \n    gl_FragColor = color;\n}"
          },
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 500
          },
          {
            "socketType": "in",
            "name": "Height",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 500
          },
