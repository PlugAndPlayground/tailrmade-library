      {
        "id": "calm-penguin-63",
        "type": "imageshader",
        "x": 340,
        "y": 3051,
        "width": 160,
        "height": 208,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Uniforms",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {
              "threshold": {
                "value": 0.5,
                "type": "f32"
              },
              "intensity": {
                "value": 1,
                "type": "f32"
              }
            }
          },
          {
            "socketType": "in",
            "name": "Images",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "in",
            "name": "WebGL Vertex",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "\nin vec2 aPosition;\nin vec2 aUV;\nout vec2 UV;\n\nuniform mat3 uProjectionMatrix;\nuniform mat3 uWorldTransformMatrix;\n\nuniform mat3 uTransformMatrix;\n\n\nvoid main() {\n    mat3 mvp = uProjectionMatrix * uWorldTransformMatrix * uTransformMatrix;\n    gl_Position = vec4((mvp * vec3(aPosition, 1.0)).xy, 0.0, 1.0);\n\n    UV = aUV;\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "WebGL Fragment",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "in vec2 UV;\nuniform sampler2D Image;\nuniform float threshold;\nuniform float intensity;\nuniform float width;\nuniform float height;\n\nvoid main() {\n    // Get center pixel\n    vec4 center = texture2D(Image, UV);\n    \n    vec2 texelSize = vec2(1.0/width, 1.0/height);\n    \n    // Sample the 3x3 neighborhood\n    vec4 tl = texture2D(Image, UV + vec2(-1.0, -1.0) * texelSize);\n    vec4 t  = texture2D(Image, UV + vec2( 0.0, -1.0) * texelSize);\n    vec4 tr = texture2D(Image, UV + vec2( 1.0, -1.0) * texelSize);\n    vec4 l  = texture2D(Image, UV + vec2(-1.0,  0.0) * texelSize);\n    vec4 r  = texture2D(Image, UV + vec2( 1.0,  0.0) * texelSize);\n    vec4 bl = texture2D(Image, UV + vec2(-1.0,  1.0) * texelSize);\n    vec4 b  = texture2D(Image, UV + vec2( 0.0,  1.0) * texelSize);\n    vec4 br = texture2D(Image, UV + vec2( 1.0,  1.0) * texelSize);\n    \n    // Convert to grayscale\n    float c00 = dot(tl.rgb, vec3(0.2126, 0.7152, 0.0722));\n    float c10 = dot(t.rgb,  vec3(0.2126, 0.7152, 0.0722));\n    float c20 = dot(tr.rgb, vec3(0.2126, 0.7152, 0.0722));\n    float c01 = dot(l.rgb,  vec3(0.2126, 0.7152, 0.0722));\n    float c21 = dot(r.rgb,  vec3(0.2126, 0.7152, 0.0722));\n    float c02 = dot(bl.rgb, vec3(0.2126, 0.7152, 0.0722));\n    float c12 = dot(b.rgb,  vec3(0.2126, 0.7152, 0.0722));\n    float c22 = dot(br.rgb, vec3(0.2126, 0.7152, 0.0722));\n    \n    // Sobel operators\n    float sx = c00 + 2.0 * c01 + c02 - c20 - 2.0 * c21 - c22;\n    float sy = c00 + 2.0 * c10 + c20 - c02 - 2.0 * c12 - c22;\n    \n    // Edge intensity\n    float edge = sqrt(sx * sx + sy * sy) * intensity;\n    \n    // Threshold\n    edge = edge > threshold ? 1.0 : 0.0;\n    \n    gl_FragColor = vec4(vec3(edge), center.a);\n}"
          },
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 500
          },
          {
            "socketType": "in",
            "name": "Height",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 500
          },
          {
            "socketType": "in",
            "name": "Angle",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":-180,\"maxValue\":180,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Scale",
            "dataType": "{\"class\":\"TwoDVectorType\"}",
            "data": {
              "x": 1,
              "y": 1
            },
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Offset",
            "dataType": "{\"class\":\"TwoDVectorType\"}",
            "data": {
              "x": 0,
              "y": 0
            },
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Texture",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "out",
            "name": "Graphics",
            "dataType": "{\"class\":\"DeferredPixiType\"}"
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false,
          "intervalFrequency": 16
        },
        "version": 2,
        "name": "Edge detection shader"
      },
      {
        "id": "friendly-sloth-88",
        "type": "imageshader",
        "x": 2065,
        "y": 840,
        "width": 160,
        "height": 208,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Uniforms",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "Images",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "in",
            "name": "WebGL Vertex",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "\nin vec2 aPosition;\nin vec2 aUV;\nout vec2 UV;\n\nuniform mat3 uProjectionMatrix;\nuniform mat3 uWorldTransformMatrix;\n\nuniform mat3 uTransformMatrix;\n\n\nvoid main() {\n    mat3 mvp = uProjectionMatrix * uWorldTransformMatrix * uTransformMatrix;\n    gl_Position = vec4((mvp * vec3(aPosition, 1.0)).xy, 0.0, 1.0);\n\n    UV = aUV;\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "WebGL Fragment",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "in vec2 UV;\nuniform sampler2D Image;\nuniform float saturation;\n\nvoid main() {\n    vec4 color = texture2D(Image, UV);\n    \n    // Convert to grayscale\n    float gray = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));\n    \n    // Mix between grayscale and original color based on saturation\n    vec3 saturated = mix(vec3(gray), color.rgb, saturation);\n    \n    gl_FragColor = vec4(saturated, 1);\n}"
          },
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
