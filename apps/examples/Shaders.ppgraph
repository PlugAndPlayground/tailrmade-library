            "dataType": "{\"class\":\"CodeType\"}",
            "data": "in vec2 aPosition;\nin vec2 aUV;\nout vec2 UV;\n\nuniform mat3 uProjectionMatrix;\nuniform mat3 uWorldTransformMatrix;\nuniform mat3 uTransformMatrix;\n\nvoid main() {\n    mat3 mvp = uProjectionMatrix * uWorldTransformMatrix * uTransformMatrix;\n    gl_Position = vec4((mvp * vec3(aPosition, 1.0)).xy, 0.0, 1.0);\n    UV = aUV;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "WebGL Fragment",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "in vec2 UV;\nuniform sampler2D Image;\nuniform float contrast;\n\nvoid main() {\n    vec4 color = texture2D(Image, UV);\n    \n    // Apply contrast\n    vec3 contrasted = (color.rgb - 0.5) * contrast + 0.5;\n    \n    gl_FragColor = vec4(contrasted, 1);\n}"
          },
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 500
          },
          {
            "socketType": "in",
            "name": "Height",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 500
          },
          {
            "socketType": "in",
            "name": "Angle",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":-180,\"maxValue\":180,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Scale",
            "dataType": "{\"class\":\"TwoDVectorType\"}",
            "data": {
              "x": 1,
              "y": 1
            },
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Offset",
            "dataType": "{\"class\":\"TwoDVectorType\"}",
            "data": {
              "x": 0,
              "y": 0
            },
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Texture",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "out",
            "name": "Graphics",
            "dataType": "{\"class\":\"DeferredPixiType\"}"
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false,
          "intervalFrequency": 16
        },
        "version": 2,
        "name": "Contrast shader"
      },
