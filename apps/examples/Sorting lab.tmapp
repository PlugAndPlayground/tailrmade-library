{
  "id": "Default/Sorting lab",
  "location": "Default",
  "name": "Sorting lab",
  "access": "private",
  "graphData": {
    "version": 12,
    "graphSettings": {
      "showExecutionVisualisation": true,
      "viewportCenterPosition": {
        "x": -980,
        "y": 4777
      },
      "viewportScale": 0.055,
      "defaultUISurfaceNodeId": "ai-node-30",
      "theme": {
        "mode": "system"
      }
    },
    "overlay": {
      "dashboard": {
        "visible": true,
        "fullscreen": false,
        "maximized": false,
        "widthPercentage": 52,
        "locked": false
      }
    },
    "nodes": [
      {
        "id": "ai-node-1",
        "name": "Start here",
        "type": "constant_string",
        "x": 0,
        "y": 0,
        "width": 3547,
        "height": 124,
        "socketArray": [
          {
            "socketType": "in",
            "name": "String",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "Sorting lab: watch sorting algorithms work one step at a time.\nFollow the numbers: 1 picks the algorithms and the numbers, 2 records every compare and swap once, 3 is the play controls and a playhead that moves through the recording, 4 draws the bars at that step, 5 explains the algorithm and 6 charts how the work grows.\nMain page on the right is the app."
          },
          {
            "socketType": "out",
            "name": "String",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        }
      },
      {
        "id": "ai-node-2",
        "name": "Algorithm",
        "type": "widgetdropdown",
        "x": 0,
        "y": 644,
        "width": 250,
        "height": 104,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Fallback Option",
