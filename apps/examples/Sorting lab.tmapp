      {
        "id": "ai-node-22",
        "name": "Bars",
        "type": "shader",
        "x": 5107,
        "y": 4740,
        "width": 160,
        "height": 232,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Uniforms",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "Images",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "in",
            "name": "WebGL Vertex",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "\nin vec2 aPosition;\nin vec2 aUV;\nout vec2 UV;\n\nuniform mat3 uProjectionMatrix;\nuniform mat3 uWorldTransformMatrix;\n\nuniform mat3 uTransformMatrix;\n\n\nvoid main() {\n    mat3 mvp = uProjectionMatrix * uWorldTransformMatrix * uTransformMatrix;\n    gl_Position = vec4((mvp * vec3(aPosition, 1.0)).xy, 0.0, 1.0);\n\n    UV = aUV;\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "WebGL Fragment",
            "dataType": "{\"class\":\"CodeType\"}"
          },
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 800
          },
          {
            "socketType": "in",
            "name": "Height",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 400
          },
          {
            "socketType": "in",
            "name": "Angle",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":-180,\"maxValue\":180,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Scale",
            "dataType": "{\"class\":\"TwoDVectorType\"}",
            "data": {
              "x": 1,
              "y": 1
            },
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Offset",
            "dataType": "{\"class\":\"TwoDVectorType\"}",
            "data": {
              "x": 0,
              "y": 0
            },
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Texture",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "out",
            "name": "Graphics",
            "dataType": "{\"class\":\"DeferredPixiType\"}"
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false,
          "intervalFrequency": 16
        },
        "version": 2,
        "comment": "One bar per number, coloured by what the algorithm is doing to it. With a race, the second algorithm gets the bottom half."
      },
      {
        "id": "ai-node-35",
        "name": "Bar shader code",
        "type": "constant_string",
        "x": 3060,
        "y": 5172,
        "width": 1227,
        "height": 2470,
        "socketArray": [
          {
            "socketType": "in",
            "name": "String",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "in vec2 UV;\nuniform float n;\nuniform float lanes;\nuniform vec4 valuesA[12];\nuniform vec4 marksA[12];\nuniform vec4 valuesB[12];\nuniform vec4 marksB[12];\nuniform float progressA;\nuniform float progressB;\nuniform vec3 paper;\nuniform vec3 bar;\nuniform vec3 compare;\nuniform vec3 change;\nuniform vec3 pivot;\nuniform vec3 done;\nuniform vec3 track;\n\n// WebGL1 can only index a uniform array with a loop counter\nvec2 barAt(int lane, int k) {\n  vec2 result = vec2(0.0);\n  for (int i = 0; i < 12; i++) {\n    if (i == k / 4) {\n      vec4 v = lane == 0 ? valuesA[i] : valuesB[i];\n      vec4 m = lane == 0 ? marksA[i] : marksB[i];\n      int c = k - i * 4;\n      if (c == 0) result = vec2(v.x, m.x);\n      else if (c == 1) result = vec2(v.y, m.y);\n      else if (c == 2) result = vec2(v.z, m.z);\n      else result = vec2(v.w, m.w);\n    }\n  }\n  return result;\n}\n\nvec3 markColour(float mark) {\n  if (mark > 4.5) return mix(bar, paper, 0.65);\n  if (mark > 3.5) return pivot;\n  if (mark > 2.5) return done;\n  if (mark > 1.5) return change;\n  if (mark > 0.5) return compare;\n  return bar;\n}\n\nvoid main() {\n  float count = max(lanes, 1.0);\n  float laneHeight = 1.0 / count;\n  int lane = UV.y < laneHeight ? 0 : 1;\n  float y = (UV.y - float(lane) * laneHeight) / laneHeight;\n  float progress = lane == 0 ? progressA : progressB;\n\n  vec3 colour = paper;\n\n  // the bars sit between 6% and 88% of the lane, growing up from 88%\n  float height = (0.88 - y) / 0.82;\n  float slot = (UV.x - 0.02) / 0.96 * n;\n  int k = int(floor(slot));\n  float inSlot = fract(slot);\n  float gap = n > 32.0 ? 0.1 : 0.16;\n  if (UV.x > 0.02 && UV.x < 0.98 && inSlot > gap && inSlot < 1.0 - gap && height >= 0.0) {\n    vec2 b = barAt(lane, k);\n    if (height <= max(b.x, 0.02)) colour = markColour(b.y);\n  }\n\n  // a thin progress line under each lane\n  if (y > 0.92 && y < 0.95 && UV.x > 0.02 && UV.x < 0.98) {\n    colour = (UV.x - 0.02) / 0.96 <= progress ? compare : track;\n  }\n\n  gl_FragColor = vec4(colour, 1.0);\n}\n"
          },
          {
            "socketType": "out",
            "name": "String",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        }
      },
      {
        "id": "ai-node-36",
        "name": "Shader code",
        "type": "customfunction",
        "x": 4727,
        "y": 4740,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(code, settings) => {\n  // The shader keeps the list of settings it saw on its first draw and\n  // ignores new ones, but it starts over whenever its code changes. The\n  // first line counts the settings, so the code changes exactly when the\n  // full list arrives.\n  return '// ' + Object.keys(settings || {}).length + ' settings\\n' + String(code || '');\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "code",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "settings",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Restarts the shader once all its settings exist. Without it, a first draw before the settings arrive leaves the bars blank."
      },
      {
        "id": "ai-node-23",
        "name": "What's happening",
        "type": "text",
        "x": 4727,
        "y": 4932,
        "width": 240,
        "height": 80,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Content",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
