      {
        "id": "ai-node-24",
        "name": "About the algorithm",
        "type": "customfunction",
        "x": 6207,
        "y": 8386,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(algorithm) => {\n  // Short notes per algorithm. The costs match the table in the\n  // javascript-algorithms README.\n  const notes = {\n    'Bubble sort': {\n      folder: 'bubble-sort',\n      idea: 'Walk along the list and swap every neighbouring pair that is in the wrong order. After each pass the biggest number left has bubbled to the end. When a pass makes no swaps, the list is sorted.',\n      cost: ['n', 'n²', 'n²', '1', 'yes'],\n      tip: 'Try **Nearly sorted**: it stops after a few passes. On **Reversed** every compare is a swap.',\n    },\n    'Selection sort': {\n      folder: 'selection-sort',\n      idea: 'Find the smallest number in the unsorted part and swap it to the front. Repeat for the next position. It always makes about n²/2 compares, but at most n swaps.',\n      cost: ['n²', 'n²', 'n²', '1', 'no'],\n      tip: 'Race it against **Bubble sort**: the same compares, far fewer swaps.',\n    },\n    'Insertion sort': {\n      folder: 'insertion-sort',\n      idea: 'Keep a sorted part on the left. Take the next number and slide it left until it sits next to a smaller one, the way you sort playing cards in your hand.',\n      cost: ['n', 'n²', 'n²', '1', 'yes'],\n      tip: 'Try **Nearly sorted**: each number only slides a little, so it is close to n steps.',\n    },\n    'Merge sort': {\n      folder: 'merge-sort',\n      idea: 'Split the list in half, sort each half the same way, then merge the two sorted halves by repeatedly taking the smaller front number. Merging needs a second list as scratch space.',\n      cost: ['n log n', 'n log n', 'n log n', 'n', 'yes'],\n      tip: 'Its step count hardly changes with the starting order: it does the same splits every time.',\n    },\n    'Quick sort': {\n      folder: 'quick-sort',\n      idea: 'Pick a pivot (here the last number), move everything smaller in front of it and everything bigger behind it, and the pivot is in its final place. Then do the same with the part on each side.',\n      cost: ['n log n', 'n log n', 'n²', 'log n', 'no'],\n      tip: 'Try **Reversed**: the last number is always the smallest or biggest, so each split removes only one number and it is as slow as bubble sort.',\n    },\n    'Heap sort': {\n      folder: 'heap-sort',\n      idea: 'First arrange the numbers as a heap, a tree stored in the list where every parent is bigger than its children, so the biggest is at the front. Swap it to the end, repair the heap, repeat.',\n      cost: ['n log n', 'n log n', 'n log n', '1', 'no'],\n      tip: 'Watch the start: the swaps jump between a position and its children at 2i+1 and 2i+2.',\n    },\n  };\n  const name = notes[algorithm] ? algorithm : 'Quick sort';\n  const note = notes[name];\n  const c = note.cost;\n  return [\n    '## ' + name,\n    note.idea,\n    'Steps for n numbers: best **' + c[0] + '** · average **' + c[1] + '** · worst **' + c[2] + '** · extra memory **' + c[3] + '** · keeps equal numbers in order: **' + c[4] + '**',\n    note.tip,\n    '[Read the code and notes in javascript-algorithms](https://github.com/trekhleb/javascript-algorithms/tree/master/src/algorithms/sorting/' + note.folder + ')',\n  ].join('\\n');\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "algorithm",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "How the chosen algorithm works, its costs from the javascript-algorithms README, and something to try."
      },
