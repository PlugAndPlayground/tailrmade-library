      {
        "id": "ai-node-18",
        "name": "Replay to the playhead",
        "type": "customfunction",
        "x": 3060,
        "y": 4980,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(trace, playhead) => {\n  // Replays each run up to the playhead: the numbers in their current\n  // order, a mark per number, the counts so far and what just happened.\n  const lanes = (trace && trace.lanes) || [];\n  const n = (trace && trace.n) || 0;\n  const sameRun = playhead && playhead.id === (trace && trace.id);\n  const at = sameRun ? Number(playhead.step) || 0 : 0;\n\n  // Marks: 0 waiting, 1 compared, 2 moved, 3 in its final place, 4 pivot or\n  // smallest so far, 5 outside the part being worked on\n  const unpack = (text) => (text ? String(text).split(';').map((row) => row.split(',').map(Number)) : []);\n  const replay = (lane) => {\n    const ops = unpack(lane.ops);\n    const placed = unpack(lane.placed);\n    const upto = Math.min(at, ops.length);\n    const a = lane.start.slice();\n    const final = a.map(() => false);\n    let compares = 0;\n    let moves = 0;\n    let placedAt = 0;\n    const apply = (op) => {\n      if (op[0] === 0) compares++;\n      else if (op[0] === 1) { const t = a[op[1]]; a[op[1]] = a[op[2]]; a[op[2]] = t; moves++; }\n      else { a[op[1]] = op[3]; moves++; }\n    };\n    for (let t = 0; t < upto; t++) {\n      apply(ops[t]);\n      while (placedAt < placed.length && placed[placedAt][0] <= t + 1) {\n        final[placed[placedAt][1]] = true;\n        placedAt++;\n      }\n    }\n    const finished = upto >= ops.length;\n    const op = upto > 0 && !finished ? ops[upto - 1] : null;\n    const marks = a.map((_, i) => {\n      if (finished || final[i]) return 3;\n      if (op && (i === op[1] || i === op[2])) return op[0] === 0 ? 1 : 2;\n      if (op && i === op[7]) return 4;\n      if (op && (i < op[5] || i > op[6])) return 5;\n      return 0;\n    });\n\n    let doing = ' ';\n    if (upto === 0) {\n      doing = 'Ready: ' + n + ' numbers, ' + String(trace.order).toLowerCase() + '. Switch on **Play** or press **Next**.';\n    } else if (finished) {\n      doing = 'Sorted in ' + ops.length + ' steps: ' + compares + ' compares and ' + moves + ' ' + lane.moves + '.';\n    } else {\n      const step = op[0] === 0\n        ? (op[3] === op[4]\n          ? 'compare **' + op[3] + '** with **' + op[4] + '**: the same'\n          : 'compare **' + op[3] + '** with **' + op[4] + '**: ' + Math.max(op[3], op[4]) + ' is bigger')\n        : op[0] === 1\n          ? 'swap **' + op[3] + '** and **' + op[4] + '**'\n          : 'write **' + op[3] + '** into position ' + (op[1] + 1);\n      const phase = lane.phases[op[8]];\n      doing = (phase ? phase + ' — ' : '') + step + '.';\n    }\n    return { name: lane.name, a, marks, compares, moves, movesWord: lane.moves, upto, total: ops.length, finished, doing };\n  };\n\n  return { n, max: (trace && trace.max) || 1, lanes: lanes.map(replay) };\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "trace",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "playhead",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Replays the recording up to the playhead: the numbers in their current order, what each one is doing, and the counts so far."
      },
      {
        "id": "ai-node-19",
        "name": "Bar settings",
        "type": "customfunction",
        "x": 4427,
        "y": 4740,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(replay, theme) => {\n  // Bar heights, marks and theme colours for the shader. Always returns\n  // every uniform: the shader fixes its uniform list on its first draw.\n  const views = (replay && replay.lanes) || [];\n  const n = (replay && replay.n) || 0;\n  const max = (replay && replay.max) || 1;\n  const tokens = (theme && theme.tokens) || {};\n  // Theme colours as 0..1 RGB. A see-through colour is mixed onto the paper.\n  const parse = (color) => {\n    const text = String(color || '');\n    const hex = /^#([0-9a-f]{6})/i.exec(text);\n    if (hex) return [0, 2, 4].map((k) => parseInt(hex[1].slice(k, k + 2), 16) / 255).concat(1);\n    const fn = /rgba?\\(\\s*([\\d.]+)[\\s,]+([\\d.]+)[\\s,]+([\\d.]+)(?:[\\s,/]+([\\d.]+))?/i.exec(text);\n    if (fn) return [fn[1] / 255, fn[2] / 255, fn[3] / 255, fn[4] === undefined ? 1 : Number(fn[4])];\n    return null;\n  };\n  const paper = (parse(tokens['background.paper']) || [0.12, 0.12, 0.12, 1]).slice(0, 3);\n  const onPaper = (color, fallback, fade) => {\n    const c = parse(color) || fallback.concat(1);\n    const keep = c[3] * (1 - (fade || 0));\n    return [0, 1, 2].map((k) => c[k] * keep + paper[k] * (1 - keep));\n  };\n  // The legend above the controls uses the same theme tones\n  const colour = {\n    paper,\n    bar: onPaper(tokens['text.secondary'], [0.6, 0.6, 0.6], 0.35),\n    compare: onPaper(tokens.primary, [0.3, 0.6, 1]),\n    change: onPaper(tokens.warning, [1, 0.6, 0.2]),\n    pivot: onPaper(tokens.secondary, [1, 0.4, 0.6]),\n    done: onPaper(tokens.success, [0.3, 0.8, 0.4]),\n    track: onPaper(tokens.divider, [0.3, 0.3, 0.3]),\n  };\n\n  const pack = (view, key, scale) => {\n    const out = new Array(48).fill(0);\n    if (view) view[key].forEach((v, i) => { out[i] = v / scale; });\n    return { value: out, type: 'vec4<f32>', size: 12 };\n  };\n  const progress = (view) => (view ? view.upto / Math.max(1, view.total) : 0);\n\n  const uniforms = {\n    n: { value: Math.max(1, n), type: 'f32' },\n    lanes: { value: Math.max(1, views.length), type: 'f32' },\n    valuesA: pack(views[0], 'a', max),\n    marksA: pack(views[0], 'marks', 1),\n    valuesB: pack(views[1], 'a', max),\n    marksB: pack(views[1], 'marks', 1),\n    progressA: { value: progress(views[0]), type: 'f32' },\n    progressB: { value: progress(views[1]), type: 'f32' },\n  };\n  Object.keys(colour).forEach((key) => { uniforms[key] = { value: colour[key], type: 'vec3<f32>' }; });\n  return uniforms;\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "replay",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "theme",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Heights, marks and theme colours for the shader. Always returns every setting, even before there is a recording."
      },
      {
        "id": "ai-node-20",
        "name": "Step story",
        "type": "customfunction",
        "x": 4427,
        "y": 4932,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(replay) => {\n  // Two lines per algorithm: the counts so far, then what just happened.\n  const views = (replay && replay.lanes) || [];\n  const count = (k, word) => k + ' ' + (k === 1 ? word.slice(0, -1) : word);\n  const where = views.length > 1 ? ['Top · ', 'Bottom · '] : ['', ''];\n  const lines = views.map((v, k) =>\n    '**' + where[k] + v.name + '** · step ' + v.upto + ' of ' + v.total +\n    ' · ' + count(v.compares, 'compares') + ' · ' + count(v.moves, v.movesWord) + (v.finished ? ' · done' : '') +\n    '\\n' + v.doing);\n  return lines.join('\\n') || '\\u00a0';\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "replay",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "The lines under the bars."
      },
      {
