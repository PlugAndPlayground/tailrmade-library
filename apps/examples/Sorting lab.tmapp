            "data": "purple-squid-95",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "State key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "sorting-lab-shuffles",
            "visible": false
          },
          {
