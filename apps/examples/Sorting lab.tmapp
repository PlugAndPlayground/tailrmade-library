        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "Counts New numbers presses. The count is the seed, so the same count always gives the same numbers."
      },
      {
        "id": "ai-node-8",
        "name": "Record the steps",
        "type": "customfunction",
        "x": 850,
        "y": 2084,
        "width": 160,
        "height": 184,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(algorithm, race, size, order, shuffles) => {\n  // Runs the chosen sorts on the same numbers and writes down every compare,\n  // swap and write, so the page can play them back. After the sorting\n  // algorithms in github.com/trekhleb/javascript-algorithms (MIT).\n  const NAMES = ['Bubble sort', 'Selection sort', 'Insertion sort', 'Merge sort', 'Quick sort', 'Heap sort'];\n  const first = NAMES.includes(algorithm) ? algorithm : 'Quick sort';\n  const second = NAMES.includes(race) && race !== first ? race : null;\n  const n = Math.max(4, Math.min(48, Math.round(Number(size) || 24)));\n  const kind = ['Random', 'Nearly sorted', 'Reversed', 'Few unique values'].includes(order) ? order : 'Random';\n  const seed = Math.round(Number(shuffles) || 0);\n\n  // Seeded random numbers: the same settings always give the same numbers.\n  const randomFrom = (start) => {\n    let s = start >>> 0;\n    return () => {\n      s = (s + 0x6d2b79f5) >>> 0;\n      let t = s;\n      t = Math.imul(t ^ (t >>> 15), t | 1);\n      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  };\n\n  const makeNumbers = (count) => {\n    const random = randomFrom(seed * 7919 + count * 31 + kind.length);\n    const values = Array.from({ length: count }, (_, i) => i + 1);\n    if (kind === 'Reversed') return values.reverse();\n    if (kind === 'Few unique values') {\n      return values.map(() => (1 + Math.floor(random() * 4)) * Math.ceil(count / 4));\n    }\n    if (kind === 'Nearly sorted') {\n      for (let k = 0; k < Math.max(1, Math.round(count / 10)); k++) {\n        const i = Math.floor(random() * count);\n        const j = Math.min(count - 1, i + 1 + Math.floor(random() * 3));\n        [values[i], values[j]] = [values[j], values[i]];\n      }\n      return values;\n    }\n    for (let i = count - 1; i > 0; i--) {\n      const j = Math.floor(random() * (i + 1));\n      [values[i], values[j]] = [values[j], values[i]];\n    }\n    return values;\n  };\n\n  // One run of one algorithm. With keep = false it only counts, for the chart.\n  // An op is [kind, i, j, x, y, lo, hi, marker, phase]:\n  // (lo..hi is the part being worked on, marker the pivot or smallest so far)\n  // kind 0 compares positions i and j (x and y are the values compared),\n  // kind 1 swaps i and j, kind 2 writes x into i.\n  const run = (name, start, keep) => {\n    const a = start.slice();\n    const count = a.length;\n    const ops = [];\n    const phases = [];\n    const placed = [];\n    let total = 0;\n    let lo = 0;\n    let hi = count - 1;\n    let marker = -1;\n    let phase = -1;\n    const say = (text) => { if (keep) { phases.push(text); phase = phases.length - 1; } };\n    const op = (k, i, j, x, y) => {\n      total++;\n      if (keep) ops.push([k, i, j, x, y, lo, hi, marker, phase]);\n    };\n    const compare = (i, j) => { op(0, i, j, a[i], a[j]); return a[i] - a[j]; };\n    const swap = (i, j) => { op(1, i, j, a[i], a[j]); const t = a[i]; a[i] = a[j]; a[j] = t; };\n    const write = (i, value) => { op(2, i, -1, value, a[i]); a[i] = value; };\n    const place = (i) => { if (keep) placed.push([ops.length, i]); };\n\n    if (name === 'Bubble sort') {\n      for (let pass = 0; pass < count - 1; pass++) {\n        say('Pass ' + (pass + 1) + ': the biggest number left bubbles to the end');\n        let swapped = false;\n        for (let j = 0; j < count - 1 - pass; j++) {\n          if (compare(j, j + 1) > 0) { swap(j, j + 1); swapped = true; }\n        }\n        place(count - 1 - pass);\n        if (!swapped) break;\n      }\n    } else if (name === 'Selection sort') {\n      for (let i = 0; i < count - 1; i++) {\n        say('Find the smallest number for position ' + (i + 1));\n        marker = i;\n        for (let j = i + 1; j < count; j++) {\n          if (compare(j, marker) < 0) marker = j;\n        }\n        if (marker !== i) swap(i, marker);\n        marker = -1;\n        place(i);\n      }\n    } else if (name === 'Insertion sort') {\n      for (let i = 1; i < count; i++) {\n        say('Slide ' + a[i] + ' left into the sorted part');\n        hi = i;\n        for (let j = i; j > 0; j--) {\n          if (compare(j - 1, j) > 0) swap(j - 1, j); else break;\n        }\n      }\n    } else if (name === 'Merge sort') {\n      const sort = (from, to) => {\n        if (from >= to) return;\n        const mid = Math.floor((from + to) / 2);\n        sort(from, mid);\n        sort(mid + 1, to);\n        lo = from; hi = to;\n        const span = (x, y) => (x === y ? 'position ' + (x + 1) : 'positions ' + (x + 1) + '–' + (y + 1));\n        say('Merge ' + span(from, mid) + ' with ' + span(mid + 1, to));\n        const left = a.slice(from, mid + 1);\n        const right = a.slice(mid + 1, to + 1);\n        let i = 0;\n        let j = 0;\n        let k = from;\n        while (i < left.length && j < right.length) {\n          // the value at k may already be overwritten, so record the values compared\n          op(0, k, mid + 1 + j, left[i], right[j]);\n          if (left[i] <= right[j]) write(k++, left[i++]); else write(k++, right[j++]);\n        }\n        while (i < left.length) write(k++, left[i++]);\n        while (j < right.length) write(k++, right[j++]);\n      };\n      sort(0, count - 1);\n    } else if (name === 'Quick sort') {\n      // In place, with the last number as the pivot (Lomuto)\n      const sort = (from, to) => {\n        if (from > to) return;\n        if (from === to) { place(from); return; }\n        lo = from; hi = to; marker = to;\n        say('Split positions ' + (from + 1) + '–' + (to + 1) + ' around the pivot ' + a[to]);\n        let border = from;\n        for (let j = from; j < to; j++) {\n          if (compare(j, to) < 0) {\n            if (border !== j) swap(border, j);\n            border++;\n          }\n        }\n        if (border !== to) swap(border, to);\n        marker = -1;\n        place(border);\n        sort(from, border - 1);\n        sort(border + 1, to);\n      };\n      sort(0, count - 1);\n    } else {\n      const sink = (i, end) => {\n        hi = end - 1;\n        while (true) {\n          const left = 2 * i + 1;\n          const right = left + 1;\n          let largest = i;\n          if (left < end && compare(left, largest) > 0) largest = left;\n          if (right < end && compare(right, largest) > 0) largest = right;\n          if (largest === i) return;\n          swap(i, largest);\n          i = largest;\n        }\n      };\n      say('Build a heap: every parent bigger than its children');\n      for (let i = Math.floor(count / 2) - 1; i >= 0; i--) sink(i, count);\n      for (let end = count - 1; end > 0; end--) {\n        say('Move the biggest (the top of the heap) to the end, then repair the heap');\n        lo = 0; hi = end;\n        swap(0, end);\n        place(end);\n        sink(0, end);\n      }\n    }\n    const sorted = a.every((value, i) => i === 0 || a[i - 1] <= value);\n    // Packed as text: the page reads the recording 20 times a second, and\n    // one string crosses into the sandbox far faster than thousands of arrays.\n    const pack = (rows) => rows.map((row) => row.join(',')).join(';');\n    return keep\n      ? { name, start, ops: pack(ops), phases, placed: pack(placed), total, sorted, moves: name === 'Merge sort' ? 'writes' : 'swaps' }\n      : total;\n  };\n\n  const start = makeNumbers(n);\n  const lanes = [first, second].filter(Boolean).map((name) => run(name, start, true));\n\n  // Steps for growing amounts of numbers, for the chart\n  const sizes = [8, 16, 32, 64, 128, 256];\n  const growth = {\n    sizes,\n    lines: NAMES.map((name) => ({ name, steps: sizes.map((count) => run(name, makeNumbers(count), false)) })),\n  };\n\n  const id = [first, second, n, kind, seed].join('|');\n  const total = Math.max(...lanes.map((lane) => lane.total));\n  return {\n    // all the playhead needs\n    run: { id, total },\n    id,\n    n,\n    order: kind,\n    max: Math.max(...start),\n    total,\n    lanes,\n    growth,\n  };\n}\n",
            "visible": false
