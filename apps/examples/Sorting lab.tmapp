      {
        "id": "ai-node-31",
        "name": "Read the playhead",
        "type": "storageread",
        "x": 1310,
        "y": 3980,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Storage type",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Cloud\",\"disabled\":true},{\"text\":\"IndexedDB\"},{\"text\":\"Session\"}],\"showAsButtons\":true}}",
            "data": "Session",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Location",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "sorting-lab"
          },
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "playhead"
          },
          {
            "socketType": "in",
            "name": "Fallback value",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {}
          },
          {
            "socketType": "in",
            "name": "Show Toast Notification",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Value",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Error",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 2,
        "comment": "Where the playhead was. Updates by itself whenever Save the playhead writes. Session storage lasts until the tab closes and is never sent anywhere."
      },
      {
        "id": "ai-node-16",
        "name": "Move the playhead",
        "type": "customfunction",
        "x": 2000,
        "y": 2868,
        "width": 160,
        "height": 208,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(stored, run, playing, speed, steps, restarts) => {\n  // Works out where the playhead is now, from where it was 50 ms ago.\n  // Its memory lives in session storage: \"Read the playhead\" reads it,\n  // this moves it, \"Save the playhead\" writes it back. Function globals\n  // can't hold it, because each run may land on a different worker.\n  const id = run && run.id;\n  const total = Number(run && run.total) || 0;\n  const stepCount = Number(steps) || 0;\n  const restartCount = Number(restarts) || 0;\n  const perSecond = { Slow: 3, Normal: 10, Fast: 30, Fastest: 100 }[speed] || 30;\n  const now = Date.now();\n\n  const before = stored && typeof stored === 'object' && stored.id === id && Number.isFinite(stored.at) ? stored : null;\n  // new numbers or a new algorithm: start from the beginning\n  const s = before\n    ? Object.assign({}, before)\n    : { id, at: 0, steps: stepCount, restarts: restartCount, last: now, playing: false };\n\n  if (restartCount !== s.restarts) {\n    s.restarts = restartCount;\n    s.at = 0;\n  }\n  if (stepCount !== s.steps) {\n    s.at = Math.floor(s.at) + (stepCount - s.steps);\n    s.steps = stepCount;\n  }\n  if (playing) {\n    // switching Play on at the end plays it again\n    if (!s.playing && s.at >= total) s.at = 0;\n    s.at += (Math.max(0, Math.min(now - s.last, 250)) / 1000) * perSecond;\n  }\n  s.playing = Boolean(playing);\n  s.last = now;\n  s.at = Math.max(0, Math.min(total, s.at));\n  s.total = total;\n  s.step = Math.floor(s.at);\n  return s;\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "stored",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "run",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "playing",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "in",
            "name": "speed",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "steps",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "restarts",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": false,
          "interval": true,
          "intervalFrequency": 50
        },
        "version": 3,
        "comment": "Runs every 50 ms. While Play is on it moves forward at the chosen speed; Next, Back and Restart move it by hand. Changes to its inputs wait for the next tick."
      },
      {
        "id": "ai-node-32",
        "name": "Playhead time",
        "type": "jsonget",
        "x": 2300,
        "y": 2868,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "JSON",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "Path",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "last"
          },
          {
            "socketType": "out",
