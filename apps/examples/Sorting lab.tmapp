      {
        "id": "ai-node-26",
        "name": "Chart the growth",
        "type": "customfunction",
        "x": 7047,
        "y": 9074,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(trace, theme) => {\n  // One line per algorithm: steps needed as the amount of numbers grows.\n  // The algorithms on screen get thick lines.\n  const tokens = (theme && theme.tokens) || {};\n  const ink = tokens['text.secondary'] || '#9e9e9e';\n  const growth = (trace && trace.growth) || { sizes: [], lines: [] };\n  const shown = ((trace && trace.lanes) || []).map((lane) => lane.name);\n  const colours = [tokens.primary || '#4f8cff', tokens.secondary || '#ff6699'];\n\n  const traces = growth.lines.map((line) => {\n    const k = shown.indexOf(line.name);\n    return {\n      type: 'scatter',\n      mode: 'lines+markers',\n      name: line.name,\n      x: growth.sizes,\n      y: line.steps,\n      line: { color: k >= 0 ? colours[k] : ink, width: k >= 0 ? 4 : 1.5 },\n      marker: { size: k >= 0 ? 7 : 4 },\n      opacity: k >= 0 ? 1 : 0.45,\n      hovertemplate: '%{y} steps for %{x} numbers<extra>' + line.name + '</extra>',\n    };\n  });\n\n  const axis = (title) => ({\n    title: { text: title },\n    color: ink,\n    gridcolor: tokens.divider || 'rgba(128,128,128,0.25)',\n    zeroline: false,\n  });\n  const layout = {\n    paper_bgcolor: 'rgba(0,0,0,0)',\n    plot_bgcolor: 'rgba(0,0,0,0)',\n    font: { color: ink, family: tokens.fontFamily || 'inherit' },\n    margin: { l: 56, r: 12, t: 12, b: 48 },\n    // doubling the numbers is one step to the right\n    xaxis: Object.assign(axis('Numbers to sort (' + String((trace && trace.order) || 'random').toLowerCase() + ')'), { type: 'log', tickvals: growth.sizes, ticktext: growth.sizes.map(String) }),\n    yaxis: axis('Steps'),\n    legend: { orientation: 'h', y: -0.3 },\n    hovermode: 'closest',\n  };\n  return { traces, layout };\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "trace",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "theme",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Turns the step counts into one chart line per algorithm. The ones on screen get the bar colours."
      },
