            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "k-means in Lab color space, so the groups match how different colors look to us. Main Thread stays on: it reads the pixels with Image and a canvas, which the sandbox does not have."
      },
      {
        "id": "ai-node-10",
        "name": "Palette details",
        "type": "customfunction",
        "x": 2500,
        "y": 2815,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(palette) => ({\n  colors: (palette?.colors ?? []).map((color) => {\n    const share = color.share * 100;\n    // Pick black or white text, whichever reads better on the color.\n    const channel = (at) => {\n      const value = parseInt(color.hex.slice(at, at + 2), 16) / 255;\n      return value <= 0.03928 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;\n    };\n    const luminance = 0.2126 * channel(1) + 0.7152 * channel(3) + 0.0722 * channel(5);\n    return {\n      hex: color.hex,\n      percent: share < 1 ? '<1%' : `${Math.round(share)}%`,\n      weight: Math.max(share, 0.5).toFixed(2),\n      ink: luminance > 0.18 ? '#000000' : '#ffffff',\n    };\n  }),\n})",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
