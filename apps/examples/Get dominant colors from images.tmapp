      {
        "id": "ai-node-16",
        "name": "Palette theme",
        "type": "customfunction",
        "x": 4100,
        "y": 3763,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(palette, on) => {\n  // An empty object hands the page back to the app's saved theme.\n  const found = palette?.colors ?? [];\n  if (!on || found.length === 0) return {};\n\n  const toRgb = (hex) => [1, 3, 5].map((at) => parseInt(hex.slice(at, at + 2), 16) / 255);\n  const toHsl = ([r, g, b]) => {\n    const max = Math.max(r, g, b);\n    const min = Math.min(r, g, b);\n    const l = (max + min) / 2;\n    if (max === min) return [0, 0, l];\n    const d = max - min;\n    const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);\n    let h;\n    if (max === r) h = (g - b) / d + (g < b ? 6 : 0);\n    else if (max === g) h = (b - r) / d + 2;\n    else h = (r - g) / d + 4;\n    return [h * 60, s, l];\n  };\n  const toHex = (h, s, l) => {\n    const a = s * Math.min(l, 1 - l);\n    const f = (n) => {\n      const k = (n + h / 30) % 12;\n      const value = l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));\n      return Math.round(Math.max(0, Math.min(1, value)) * 255).toString(16).padStart(2, '0');\n    };\n    return `#${f(0)}${f(8)}${f(4)}`;\n  };\n  const luminance = (hex) => {\n    const [r, g, b] = toRgb(hex).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));\n    return 0.2126 * r + 0.7152 * g + 0.0722 * b;\n  };\n  const contrast = (a, b) => {\n    const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);\n    return (hi + 0.05) / (lo + 0.05);\n  };\n  // Lightens (step > 0) or darkens a color until it reads on the background.\n  const readable = ([h, s, l], background, step) => {\n    let lightness = l;\n    let hex = toHex(h, s, lightness);\n    for (let tries = 0; tries < 40 && contrast(hex, background) < 4.5; tries += 1) {\n      lightness = Math.max(0, Math.min(1, lightness + step));\n      hex = toHex(h, s, lightness);\n    }\n    return hex;\n  };\n  const hueGap = (a, b) => {\n    const d = Math.abs(a - b) % 360;\n    return Math.min(d, 360 - d);\n  };\n\n  const colors = found.map((color) => ({ ...color, hsl: toHsl(toRgb(color.hex)) }));\n  // The accent is the most colorful color that covers a real part of the image.\n  const vividness = (c) => c.hsl[1] * (1 - Math.abs(c.hsl[2] - 0.5) * 2) * Math.sqrt(c.share);\n  const byVividness = [...colors].sort((a, b) => vividness(b) - vividness(a));\n  const accent = byVividness[0];\n  const second = byVividness.find((c) => hueGap(c.hsl[0], accent.hsl[0]) > 40) ?? byVividness[1] ?? accent;\n  // Backgrounds take the hue of the color that covers most of the image,\n  // passing over near-greys so a grey sky does not wash the page out.\n  const base = colors.find((c) => c.hsl[1] > 0.15) ?? colors[0];\n  const [darkHue, darkSat] = base.hsl;\n  const [lightHue, lightSat] = base.hsl;\n  // Text gets a hint of the background's hue, none for a grey image.\n  const darkTint = Math.min(darkSat, 0.15);\n  const lightTint = Math.min(lightSat, 0.15);\n  const darkPaper = toHex(darkHue, Math.min(darkSat, 0.45), 0.14);\n  const lightPaper = toHex(lightHue, Math.min(lightSat, 0.4), 0.98);\n\n  return {\n    byMode: {\n      dark: {\n        primary: readable(accent.hsl, darkPaper, 0.03),\n        secondary: readable(second.hsl, darkPaper, 0.03),\n        'background.default': toHex(darkHue, Math.min(darkSat, 0.45), 0.08),\n        'background.paper': darkPaper,\n        'text.primary': toHex(darkHue, darkTint, 0.95),\n        'text.secondary': toHex(darkHue, darkTint, 0.74),\n        divider: toHex(darkHue, darkTint, 0.26),\n      },\n      light: {\n        primary: readable(accent.hsl, lightPaper, -0.03),\n        secondary: readable(second.hsl, lightPaper, -0.03),\n        'background.default': toHex(lightHue, Math.min(lightSat, 0.4), 0.93),\n        'background.paper': lightPaper,\n        'text.primary': toHex(lightHue, lightTint, 0.1),\n        'text.secondary': toHex(lightHue, lightTint, 0.36),\n        divider: toHex(lightHue, lightTint, 0.84),\n      },\n    },\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "palette",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "on",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Turns the palette into theme overrides for light and dark mode. The most colorful color becomes primary, adjusted until it reads on the background."
      },
