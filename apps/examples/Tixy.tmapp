      {
        "id": "ai-node-4",
        "name": "Example code",
        "type": "customfunction",
        "x": 390,
        "y": 805,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(choice) => {\n  // [name, tixy's comment, code], in tixy's order\n  const examples = [\n   [\n    \"Basics: 0 or 1\",\n    \"for every dot return 0 or 1 to change the visibility\",\n    \"Math.random() < 0.1\"\n   ],\n   [\n    \"Basics: size from 0 to 1\",\n    \"use a float between 0 and 1 to define the size\",\n    \"Math.random()\"\n   ],\n   [\n    \"Basics: t is time\",\n    \"parameter `t` is the time in seconds\",\n    \"Math.sin(t)\"\n   ],\n   [\n    \"Basics: i is the index\",\n    \"param `i` is the index of the dot (0..255)\",\n    \"i / 256\"\n   ],\n   [\n    \"Basics: x is the column\",\n    \"`x` is the column index from 0 to 15\",\n    \"x / 16\"\n   ],\n   [\n    \"Basics: y is the row\",\n    \"`y` is the row also from 0 to 15\",\n    \"y / 16\"\n   ],\n   [\n    \"Basics: negative is red\",\n    \"positive numbers are white, negatives are red\",\n    \"y - 7.5\"\n   ],\n   [\n    \"Basics: animate with t\",\n    \"use the time to animate values\",\n    \"y - t\"\n   ],\n   [\n    \"Basics: speed up time\",\n    \"multiply the time to change the speed\",\n    \"y - t*4\"\n   ],\n   [\n    \"Basics: colour patterns\",\n    \"create patterns using different color\",\n    \"[1, 0, -1][i%3]\"\n   ],\n   [\n    \"Basics: skip Math.\",\n    \"skip `Math.` to use methods and props like `sin` or `PI`\",\n    \"sin(t-sqrt((x-7.5)**2+(y-6)**2))\"\n   ],\n   [\n    \"Sine scroll\",\n    \"more examples ...\",\n    \"sin(y/8 + t)\"\n   ],\n   [\n    \"Simple triangle\",\n    \"simple triangle\",\n    \"y - x\"\n   ],\n   [\n    \"Quarter triangle\",\n    \"quarter triangle\",\n    \"(y > x) && (14-x < y)\"\n   ],\n   [\n    \"Pattern\",\n    \"pattern\",\n    \"i%4 - y%4\"\n   ],\n   [\n    \"Grid\",\n    \"grid\",\n    \"x%4 && y%4\"\n   ],\n   [\n    \"Square\",\n    \"square\",\n    \"x>3 & y>3 & x<12 & y<12\"\n   ],\n   [\n    \"Animated square\",\n    \"animated square\",\n    \"-(x>t & y>t & x<15-t & y<15-t)\"\n   ],\n   [\n    \"Mondrian squares\",\n    \"mondrian squares\",\n    \"(y-6) * (x-6)\"\n   ],\n   [\n    \"Moving cross\",\n    \"moving cross\",\n    \"(y-4*t|0) * (x-2-t|0)\"\n   ],\n   [\n    \"Sierpinski\",\n    \"sierpinski\",\n    \"4 * t & i & x & y\"\n   ],\n   [\n    \"Binary clock\",\n    \"binary clock\",\n    \"(t*10) & (1<<x) && y==8\"\n   ],\n   [\n    \"Random noise\",\n    \"random noise\",\n    \"random() * 2 - 1\"\n   ],\n   [\n    \"Static smooth noise\",\n    \"static smooth noise\",\n    \"sin(i ** 2)\"\n   ],\n   [\n    \"Animated smooth noise\",\n    \"animated smooth noise\",\n    \"cos(t + i + x * y)\"\n   ],\n   [\n    \"Waves\",\n    \"waves\",\n    \"sin(x/2) - sin(x-t) - y+6\"\n   ],\n   [\n    \"Bloop bloop bloop\",\n    \"bloop bloop bloop by @v21\",\n    \"(x-8)*(y-8) - sin(t)*64\"\n   ],\n   [\n    \"Fireworks\",\n    \"fireworks by @p_malin and @aemkei\",\n    \"-.4/(hypot(x-t%10,y-t%8)-t%2*9)\"\n   ],\n   [\n    \"Ripples\",\n    \"ripples by @thespite\",\n    \"Math.sin(t-Math.sqrt(x*x+y*y))\"\n   ],\n   [\n    \"Scrolling TIXY font\",\n    \"scrolling TIXY font by @atesgoral\",\n    \"[5463,2194,2386][y+t*9&7]&1<<x-1\"\n   ],\n   [\n    \"3D checker board\",\n    \"3d checker board by @p_malin\",\n    \"(((x-8)/y+t*5)&1^1/y*8&1)*y/5\"\n   ],\n   [\n    \"Sticky blood\",\n    \"sticky blood by @joeytwiddle\",\n    \"y-t*3+9+3*cos(x*3-t)-5*sin(x*7)\"\n   ],\n   [\n    \"3D starfield\",\n    \"3d starfield by @p_malin\",\n    \"d=y*y%5.9+1,!((x+t*50/d)&15)/d\"\n   ],\n   [\n    \"Dialogue with an alien\",\n    \"dialogue with an alien by @chiptune\",\n    \"1/32*tan(t/64*x*tan(i-x))\"\n   ],\n   [\n    \"Space invader\",\n    \"space invader by @keithclarkcouk + @zozuar\",\n    \"'p}¶¼<¼¶}p'.charCodeAt(x)&2**y\"\n   ],\n   [\n    \"Hungry pac man\",\n    \"hungry pac man by @p_malin and @aemkei\",\n    \"hypot(x-=t%4*5,y-=8)<6&&x<y|y<-x\"\n   ],\n   [\n    \"Spectrum analyser\",\n    \"spectrum analyser by @joeytwiddle\",\n    \"x&y<9&y>4+sin(8*t+x*x)+x/4\"\n   ],\n   [\n    \"Diagonals\",\n    \"diagonals\",\n    \"y == x || -(15-x == y)\"\n   ],\n   [\n    \"Frame\",\n    \"frame\",\n    \"x==0 | x==15 | y==0 | y==15\"\n   ],\n   [\n    \"Drop\",\n    \"drop\",\n    \"8*t%13 - hypot(x-7.5, y-7.5)\"\n   ],\n   [\n    \"Rotation\",\n    \"rotation\",\n    \"sin(2*atan((y-7.5)/(x-7.5))+5*t)\"\n   ],\n   [\n    \"Wipe\",\n    \"wipe\",\n    \"(x-y) - sin(t) * 16\"\n   ],\n   [\n    \"Soft wipe\",\n    \"soft wipe\",\n    \"(x-y)/24 - sin(t)\"\n   ],\n   [\n    \"Disco\",\n    \"disco\",\n    \"sin(t*5) * tan(t*7)\"\n   ],\n   [\n    \"The 32 character limit\",\n    \"input is limited to 32 characters!\",\n    \"(x-5)**2 + (y-5)**2 - 99*sin(t)\"\n   ],\n   [\n    \"Your own\",\n    \"now type your own\",\n    \"'HAVE FUN!'\"\n   ]\n  ];\n  const [name, comment, code] = examples.find(([n]) => n === choice) ?? examples[0];\n  return { name, comment, code };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "choice",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "The examples from tixy.land. The names must match the Examples dropdown's options."
      },
      {
