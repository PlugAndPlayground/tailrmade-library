      {
        "id": "ai-node-11",
        "name": "Dot grid",
        "type": "shader",
        "x": 7700,
        "y": 8157,
        "width": 160,
        "height": 232,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Uniforms",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "Images",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "in",
            "name": "WebGL Vertex",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "\nin vec2 aPosition;\nin vec2 aUV;\nout vec2 UV;\n\nuniform mat3 uProjectionMatrix;\nuniform mat3 uWorldTransformMatrix;\n\nuniform mat3 uTransformMatrix;\n\n\nvoid main() {\n    mat3 mvp = uProjectionMatrix * uWorldTransformMatrix * uTransformMatrix;\n    gl_Position = vec4((mvp * vec3(aPosition, 1.0)).xy, 0.0, 1.0);\n\n    UV = aUV;\n}\n",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "WebGL Fragment",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "in vec2 UV;\nuniform vec4 cells[64];\nuniform vec3 paper;\nuniform vec3 ink;\nuniform vec3 negative;\nuniform float width;\nuniform float shape;\n\n// 0 circle, 1 square, 2 diamond, 3 ring: distance from the dot's centre in that shape\nfloat shapeDistance(vec2 p) {\n    vec2 a = abs(p);\n    if (shape > 2.5) return length(p);\n    if (shape > 1.5) return a.x + a.y;\n    if (shape > 0.5) return max(a.x, a.y);\n    return length(p);\n}\n\n// tixy's grid: 16 dots of 16 units with 1 unit between them\nconst float CELL = 17.0;\nconst float SIZE = 271.0;\n\nvoid main() {\n    vec2 p = UV * SIZE;\n    vec2 cell = min(floor(p / CELL), vec2(15.0));\n    vec2 local = p - cell * CELL - 8.0;\n    int index = int(cell.y) * 16 + int(cell.x);\n    // WebGL1 shaders can only index arrays by a loop counter\n    vec4 group = vec4(0.0);\n    for (int k = 0; k < 64; k++) {\n        if (k == index / 4) group = cells[k];\n    }\n    int lane = index - (index / 4) * 4;\n    float value = dot(group, vec4(equal(ivec4(lane), ivec4(0, 1, 2, 3))));\n    float radius = abs(value) * 8.0;\n    float edge = SIZE / width;\n    float d = shapeDistance(local);\n    float inside = 1.0 - smoothstep(radius - edge, radius + edge * 0.5, d);\n    // a ring is a circle with its middle cut out\n    if (shape > 2.5) inside -= 1.0 - smoothstep(radius * 0.6 - edge, radius * 0.6 + edge * 0.5, d);\n    inside *= step(0.001, radius);\n    vec3 dotColor = value < 0.0 ? negative : ink;\n    gl_FragColor = vec4(mix(paper, dotColor, inside), 1.0);\n}\n"
          },
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 542
          },
          {
            "socketType": "in",
            "name": "Height",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":1,\"maxValue\":1000,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 542
          },
          {
            "socketType": "in",
            "name": "Angle",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":-180,\"maxValue\":180,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Scale",
            "dataType": "{\"class\":\"TwoDVectorType\"}",
            "data": {
              "x": 1,
              "y": 1
            },
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Offset",
            "dataType": "{\"class\":\"TwoDVectorType\"}",
            "data": {
              "x": 0,
              "y": 0
            },
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Texture",
            "dataType": "{\"class\":\"ImageResourceMapType\"}"
          },
          {
            "socketType": "out",
            "name": "Graphics",
            "dataType": "{\"class\":\"DeferredPixiType\"}"
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false,
          "intervalFrequency": 16
        },
        "version": 2,
        "comment": "Draws all 256 dots on the GPU from the values; no main-thread code, so no risk warning."
      },
