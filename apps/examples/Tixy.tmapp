{
  "id": "Default/Tixy",
  "location": "Default",
  "name": "Tixy",
  "access": "private",
  "graphData": {
    "version": 12,
    "graphSettings": {
      "showExecutionVisualisation": true,
      "viewportCenterPosition": {
        "x": -732,
        "y": 2288
      },
      "viewportScale": 0.099,
      "defaultUISurfaceNodeId": "ai-node-12",
      "theme": {
        "mode": "dark"
      }
