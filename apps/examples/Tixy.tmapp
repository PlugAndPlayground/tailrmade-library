            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Regular\",\"value\":\"400\"},{\"text\":\"Bold\",\"value\":\"700\"}],\"showAsButtons\":true}}",
            "data": "Regular",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Text color",
            "dataType": "{\"class\":\"ColorType\"}",
            "data": {
              "r": 12,
              "g": 12,
              "b": 12,
              "a": 1
            },
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Background color",
            "dataType": "{\"class\":\"ColorType\"}",
            "data": {
              "r": 255,
              "g": 255,
              "b": 255,
              "a": 1
            },
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Output",
            "dataType": "{\"class\":\"StringType\"}",
            "visible": false
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        }
      },
      {
