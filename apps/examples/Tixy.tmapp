        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(mode, theme, background, positive, negative, shape) => {\n  // the shader draws shape 0 circle, 1 square, 2 diamond, 3 ring\n  const shapeIndex = Math.max(0, ['Circle', 'Square', 'Diamond', 'Ring'].indexOf(shape));\n  const fromPicker = (c, fallback) =>\n    c && typeof c.r === 'number' ? [c.r / 255, c.g / 255, c.b / 255] : fallback;\n  const fromToken = (color, fallback) => {\n    const text = String(color ?? '');\n    let hex = /^#([0-9a-f]{3}|[0-9a-f]{6})\\b/i.exec(text)?.[1];\n    if (hex && hex.length === 3) hex = hex.replace(/./g, '$&$&');\n    if (hex) return [0, 2, 4].map((at) => parseInt(hex.slice(at, at + 2), 16) / 255);\n    const parts = /rgba?\\(([^)]*)\\)/i.exec(text)?.[1].split(',').map(Number);\n    return parts?.length >= 3 ? parts.slice(0, 3).map((v) => v / 255) : fallback;\n  };\n  const classic = { paper: [0, 0, 0], ink: [1, 1, 1], negative: [1, 0.133, 0.267] };\n  if (mode === 'Tixy classic') return { ...classic, shape: shapeIndex };\n  if (mode === 'Custom') {\n    return {\n      paper: fromPicker(background, classic.paper),\n      ink: fromPicker(positive, classic.ink),\n      negative: fromPicker(negative, classic.negative),\n      shape: shapeIndex,\n    };\n  }\n  const tokens = theme?.tokens ?? {};\n  return {\n    paper: fromToken(tokens['background.paper'], classic.paper),\n    ink: fromToken(tokens['text.primary'], classic.ink),\n    negative: fromToken(tokens.error, classic.negative),\n    shape: shapeIndex,\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "mode",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "theme",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "background",
            "dataType": "{\"class\":\"ColorType\"}"
          },
          {
            "socketType": "in",
            "name": "positive",
            "dataType": "{\"class\":\"ColorType\"}"
          },
          {
            "socketType": "in",
            "name": "negative",
            "dataType": "{\"class\":\"ColorType\"}"
          },
          {
            "socketType": "in",
            "name": "shape",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Colours and shape for the shader. Theme follows the page; Tixy classic is the original black, white and red; Custom uses the three pickers. Theme colours update on load, not on a live preset switch."
      },
