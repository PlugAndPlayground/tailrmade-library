      {
        "id": "ai-node-4",
        "name": "Example code",
        "type": "customfunction",
        "x": 2690,
        "y": 2477,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(rows, choice, link) => {\n  if (choice === 'From the link' && link?.code) {\n    return { name: choice, comment: 'shared with you. Pick an example to leave it', code: link.code };\n  }\n  const list = (Array.isArray(rows) ? rows : []).filter((row) => String(row?.name ?? '').trim());\n  // a renamed or deleted example falls back to the first row\n  const row = list.find((r) => String(r.name).trim() === choice) ?? list[0] ?? {};\n  return {\n    name: String(row.name ?? '').trim(),\n    comment: String(row.comment ?? ''),\n    code: String(row.code ?? ''),\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "rows",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "choice",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "link",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Finds the picked row in the examples table, or the code from a shared link."
      },
