      {
        "id": "ai-node-6",
        "name": "Restart the clock",
        "type": "customfunction",
        "x": 2510,
        "y": 3189,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(code) => {\n  return Date.now();\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "code",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Like tixy, t counts the seconds since the code last changed."
      },
      {
        "id": "ai-node-9",
        "name": "Work out every dot",
        "type": "customfunction",
        "x": 2810,
        "y": 2949,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(code, startedAt, theme) => {\n  const rgb = (color, fallback) => {\n    const text = String(color ?? '');\n    let hex = /^#([0-9a-f]{3}|[0-9a-f]{6})\\b/i.exec(text)?.[1];\n    if (hex && hex.length === 3) hex = hex.replace(/./g, '$&$&');\n    if (hex) return [0, 2, 4].map((at) => parseInt(hex.slice(at, at + 2), 16) / 255);\n    const parts = /rgba?\\(([^)]*)\\)/i.exec(text)?.[1].split(',').map(Number);\n    return parts?.length >= 3 ? parts.slice(0, 3).map((v) => v / 255) : fallback;\n  };\n  const tokens = theme?.tokens ?? {};\n\n  // the same function tixy builds: Math is in scope, and a throw draws nothing\n  let fn = () => 0;\n  try {\n    fn = new Function('t', 'i', 'x', 'y',\n      'try { with (Math) { return ' + String(code ?? '') + '; } } catch (error) { return 0; }');\n  } catch (error) {}\n\n  const t = (Date.now() - (Number(startedAt) || Date.now())) / 1000;\n  const cells = [];\n  for (let i = 0; i < 256; i++) {\n    const value = Number(fn(t, i, i % 16, Math.floor(i / 16)));\n    cells.push(Number.isFinite(value) ? Math.max(-1, Math.min(1, value)) : 0);\n  }\n  return {\n    // 64 vec4s hold 256 values and fit any GPU's uniform limit\n    cells: { value: cells, type: 'vec4<f32>', size: 64 },\n    paper: { value: rgb(tokens['background.paper'], [0, 0, 0]), type: 'vec3<f32>' },\n    ink: { value: rgb(tokens['text.primary'], [1, 1, 1]), type: 'vec3<f32>' },\n    negative: { value: rgb(tokens.error, [1, 0.13, 0.27]), type: 'vec3<f32>' },\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "code",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "startedAt",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "theme",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": true,
          "intervalFrequency": 33
        },
        "version": 3,
        "comment": "Runs every 33 ms (about 30 frames a second) in the sandbox, so typed code never touches the page. Values are clamped to -1..1."
      },
      {
        "id": "ai-node-10",
