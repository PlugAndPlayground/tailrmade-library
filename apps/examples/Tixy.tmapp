      {
        "id": "ai-node-6",
        "name": "Restart the clock",
        "type": "customfunction",
        "x": 6640,
        "y": 7421,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(code) => {\n  return Date.now();\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "code",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Like tixy, t counts the seconds since the code last changed."
      },
      {
        "id": "ai-node-9",
        "name": "Work out every dot",
        "type": "customfunction",
        "x": 6940,
        "y": 7421,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(code, startedAt, colours) => {\n\n  // the same function tixy builds: Math is in scope, and a throw draws nothing\n  let fn = () => 0;\n  try {\n    fn = new Function('t', 'i', 'x', 'y',\n      'try { with (Math) { return ' + String(code ?? '') + '; } } catch (error) { return 0; }');\n  } catch (error) {}\n\n  const t = (Date.now() - (Number(startedAt) || Date.now())) / 1000;\n  const cells = [];\n  for (let i = 0; i < 256; i++) {\n    const value = Number(fn(t, i, i % 16, Math.floor(i / 16)));\n    cells.push(Number.isFinite(value) ? Math.max(-1, Math.min(1, value)) : 0);\n  }\n  return {\n    // 64 vec4s hold 256 values and fit any GPU's uniform limit\n    cells: { value: cells, type: 'vec4<f32>', size: 64 },\n    paper: { value: colours?.paper ?? [0, 0, 0], type: 'vec3<f32>' },\n    ink: { value: colours?.ink ?? [1, 1, 1], type: 'vec3<f32>' },\n    negative: { value: colours?.negative ?? [1, 0.13, 0.27], type: 'vec3<f32>' },\n    shape: { value: colours?.shape ?? 0, type: 'f32' },\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "code",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "startedAt",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "colours",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": true,
          "intervalFrequency": 33
        },
        "version": 3,
        "comment": "Runs every 33 ms (about 30 frames a second) in the sandbox, so typed code never touches the page. Values are clamped to -1..1."
      },
      {
        "id": "ai-node-32",
        "name": "Make the share link",
        "type": "customfunction",
        "x": 5800,
        "y": 6589,
        "width": 160,
        "height": 232,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(code, shape, colours, background, positive, negative, appLink) => {\n  // appLink is for the app link the URL Parameter node will offer; until then links point\n  // to the published example. Change APP if you share your own copy of the app.\n  const APP = String(appLink ?? '').trim().split('#')[0] || 'https://tailrmade.app/?loadGraph=publicUser;;Tixy;;Default';\n  // percent-encode everything but letters and digits, so the link survives Markdown and chat apps\n  const enc = (s) => Array.from(String(s)).map((ch) => /[A-Za-z0-9_.~-]/.test(ch) ? ch\n    : encodeURIComponent(ch).replace(/[!'()*]/g, (c) => '%' + c.charCodeAt(0).toString(16).toUpperCase())).join('');\n  const hex = (c) => [c?.r, c?.g, c?.b].map((v) => Math.round(Number(v) || 0).toString(16).padStart(2, '0')).join('');\n  const text = String(code ?? '').trim();\n  if (!text) return '\\u00a0';\n  const parts = ['code=' + enc(text)];\n  if (shape && shape !== 'Circle') parts.push('shape=' + enc(shape));\n  if (colours && colours !== 'Theme') parts.push('colours=' + enc(colours));\n  if (colours === 'Custom') parts.push('palette=' + [background, positive, negative].map(hex).join('-'));\n  return '[Share link to this pattern](' + APP + '#' + parts.join('&') + ')';\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "code",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "shape",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "colours",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "background",
            "dataType": "{\"class\":\"ColorType\"}"
          },
          {
            "socketType": "in",
            "name": "positive",
            "dataType": "{\"class\":\"ColorType\"}"
          },
          {
            "socketType": "in",
            "name": "negative",
            "dataType": "{\"class\":\"ColorType\"}"
          },
          {
            "socketType": "in",
            "name": "appLink",
            "dataType": "{\"class\":\"StringType\"}",
            "data": ""
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "The code, shape and colours go after # in the link; section 1 reads them back when someone opens it."
      },
      {
        "id": "ai-node-33",
        "name": "Share link",
        "type": "text",
        "x": 6100,
        "y": 6589,
        "width": 240,
        "height": 80,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Content",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "Variant",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"display\",\"value\":\"display\"},{\"text\":\"h1\",\"value\":\"h1\"},{\"text\":\"h2\",\"value\":\"h2\"},{\"text\":\"h3\",\"value\":\"h3\"},{\"text\":\"body\",\"value\":\"body\"},{\"text\":\"caption\",\"value\":\"caption\"},{\"text\":\"label\",\"value\":\"label\"},{\"text\":\"stat\",\"value\":\"stat\"}],\"showAsButtons\":false}}",
            "data": "body",
            "visible": false
          },
          {
