      {
        "id": "ai-node-13",
        "name": "Get the code",
        "type": "jsonget",
        "x": 690,
        "y": 805,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "JSON",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "Path",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "code"
          },
          {
            "socketType": "out",
            "name": "Value",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        }
      },
      {
        "id": "ai-node-7",
        "name": "Check the code",
        "type": "customfunction",
        "x": 1670,
        "y": 2237,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(code, example) => {\n  const text = String(code ?? '');\n  // the message is Markdown, so escape what the user typed\n  const esc = (s) => s.replace(/[\\\\`*_{}\\[\\]()#+\\-.!|<>~]/g, '\\\\$&');\n  const line = (s, tone) => (tone ? '[' + esc(s) + ']{.' + tone + '}' : esc(s));\n  if (!text.trim()) return line('// type a function of t, i, x and y');\n  let fn;\n  try {\n    fn = new Function('t', 'i', 'x', 'y', 'with (Math) { return ' + text + '; }');\n    for (let i = 0; i < 256; i++) fn(0, i, i % 16, Math.floor(i / 16));\n  } catch (error) {\n    return line('// ' + error.name + ': ' + error.message, 'error');\n  }\n  if (text.length > 32) return line('// ' + text.length + ' characters: tixy asks for 32 or less', 'warning');\n  if (text === example?.code) return line('// ' + example.comment);\n  return line('// your own function. Pick an example for ideas');\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "code",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "example",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Runs the code once for every dot at t = 0, so typos and unknown names show here instead of a blank grid."
      },
      {
        "id": "ai-node-8",
        "name": "Comment line",
        "type": "text",
        "x": 1970,
        "y": 2237,
        "width": 240,
        "height": 80,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Content",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "Variant",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"display\",\"value\":\"display\"},{\"text\":\"h1\",\"value\":\"h1\"},{\"text\":\"h2\",\"value\":\"h2\"},{\"text\":\"h3\",\"value\":\"h3\"},{\"text\":\"body\",\"value\":\"body\"},{\"text\":\"caption\",\"value\":\"caption\"},{\"text\":\"label\",\"value\":\"label\"},{\"text\":\"stat\",\"value\":\"stat\"}],\"showAsButtons\":false}}",
            "data": "body",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Tone",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"default\",\"value\":\"default\"},{\"text\":\"muted\",\"value\":\"muted\"},{\"text\":\"primary\",\"value\":\"primary\"},{\"text\":\"secondary\",\"value\":\"secondary\"},{\"text\":\"success\",\"value\":\"success\"},{\"text\":\"warning\",\"value\":\"warning\"},{\"text\":\"error\",\"value\":\"error\"}],\"showAsButtons\":false}}",
            "data": "muted",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Alignment",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"left\",\"value\":\"left\"},{\"text\":\"center\",\"value\":\"center\"},{\"text\":\"right\",\"value\":\"right\"},{\"text\":\"justify\",\"value\":\"justify\"}],\"showAsButtons\":false}}",
            "data": "left",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Custom styles",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {
              "fontFamily": "monospace"
            },
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Output",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
