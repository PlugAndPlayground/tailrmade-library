      {
        "id": "ai-node-7",
        "name": "Check the code",
        "type": "customfunction",
        "x": 3970,
        "y": 4197,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(code, example) => {\n  const text = String(code ?? '');\n  // the message is Markdown, so escape what the user typed\n  const esc = (s) => s.replace(/[\\\\`*_{}\\[\\]()#+\\-.!|<>~]/g, '\\\\$&');\n  const line = (s, tone) => (tone ? '[' + esc(s) + ']{.' + tone + '}' : esc(s));\n  if (!text.trim()) return line('// type a function of t, i, x and y');\n  let fn;\n  try {\n    fn = new Function('t', 'i', 'x', 'y', 'with (Math) { return ' + text + '; }');\n    for (let i = 0; i < 256; i++) fn(0, i, i % 16, Math.floor(i / 16));\n  } catch (error) {\n    return line('// ' + error.name + ': ' + error.message, 'error');\n  }\n  if (text.length > 32) return line('// ' + text.length + ' characters: tixy asks for 32 or less', 'warning');\n  if (text === example?.code) return line('// ' + (example.comment || example.name));\n  return line('// your own function. Pick an example for ideas');\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "code",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "example",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Runs the code once for every dot at t = 0, so typos and unknown names show here instead of a blank grid."
      },
