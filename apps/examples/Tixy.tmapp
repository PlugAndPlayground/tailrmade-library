      {
        "id": "ai-node-14",
        "name": "Examples table",
        "type": "table2",
        "x": 1060,
        "y": 2477,
        "width": 800,
        "height": 400,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Data",
            "dataType": "{\"class\":\"JSONArrayType\"}",
            "data": [
              {
                "name": "Basics: 0 or 1",
                "comment": "for every dot return 0 or 1 to change the visibility",
                "code": "Math.random() < 0.1"
              },
              {
                "name": "Basics: size from 0 to 1",
                "comment": "use a float between 0 and 1 to define the size",
                "code": "Math.random()"
              },
              {
                "name": "Basics: t is time",
                "comment": "parameter `t` is the time in seconds",
                "code": "Math.sin(t)"
              },
              {
                "name": "Basics: i is the index",
                "comment": "param `i` is the index of the dot (0..255)",
                "code": "i / 256"
              },
              {
                "name": "Basics: x is the column",
                "comment": "`x` is the column index from 0 to 15",
                "code": "x / 16"
              },
              {
                "name": "Basics: y is the row",
                "comment": "`y` is the row also from 0 to 15",
                "code": "y / 16"
              },
              {
                "name": "Basics: negative is red",
                "comment": "positive numbers are white, negatives are red",
                "code": "y - 7.5"
              },
              {
                "name": "Basics: animate with t",
                "comment": "use the time to animate values",
                "code": "y - t"
              },
              {
                "name": "Basics: speed up time",
                "comment": "multiply the time to change the speed",
                "code": "y - t*4"
              },
              {
                "name": "Basics: colour patterns",
                "comment": "create patterns using different color",
                "code": "[1, 0, -1][i%3]"
              },
              {
                "name": "Basics: skip Math.",
                "comment": "skip `Math.` to use methods and props like `sin` or `PI`",
                "code": "sin(t-sqrt((x-7.5)**2+(y-6)**2))"
              },
              {
                "name": "Sine scroll",
                "comment": "more examples ...",
                "code": "sin(y/8 + t)"
              },
              {
                "name": "Simple triangle",
                "comment": "simple triangle",
                "code": "y - x"
              },
              {
                "name": "Quarter triangle",
                "comment": "quarter triangle",
                "code": "(y > x) && (14-x < y)"
              },
              {
                "name": "Pattern",
                "comment": "pattern",
                "code": "i%4 - y%4"
              },
              {
                "name": "Grid",
                "comment": "grid",
                "code": "x%4 && y%4"
              },
              {
                "name": "Square",
                "comment": "square",
                "code": "x>3 & y>3 & x<12 & y<12"
              },
              {
                "name": "Animated square",
                "comment": "animated square",
                "code": "-(x>t & y>t & x<15-t & y<15-t)"
              },
              {
                "name": "Mondrian squares",
                "comment": "mondrian squares",
                "code": "(y-6) * (x-6)"
              },
              {
                "name": "Moving cross",
                "comment": "moving cross",
                "code": "(y-4*t|0) * (x-2-t|0)"
              },
              {
                "name": "Sierpinski",
                "comment": "sierpinski",
                "code": "4 * t & i & x & y"
              },
              {
                "name": "Binary clock",
                "comment": "binary clock",
                "code": "(t*10) & (1<<x) && y==8"
              },
              {
                "name": "Random noise",
                "comment": "random noise",
                "code": "random() * 2 - 1"
              },
              {
                "name": "Static smooth noise",
                "comment": "static smooth noise",
                "code": "sin(i ** 2)"
              },
              {
                "name": "Animated smooth noise",
                "comment": "animated smooth noise",
                "code": "cos(t + i + x * y)"
              },
              {
                "name": "Waves",
                "comment": "waves",
                "code": "sin(x/2) - sin(x-t) - y+6"
              },
              {
                "name": "Bloop bloop bloop",
                "comment": "bloop bloop bloop by @v21",
                "code": "(x-8)*(y-8) - sin(t)*64"
              },
              {
                "name": "Fireworks",
                "comment": "fireworks by @p_malin and @aemkei",
                "code": "-.4/(hypot(x-t%10,y-t%8)-t%2*9)"
              },
              {
                "name": "Ripples",
                "comment": "ripples by @thespite",
                "code": "Math.sin(t-Math.sqrt(x*x+y*y))"
              },
              {
                "name": "Scrolling TIXY font",
                "comment": "scrolling TIXY font by @atesgoral",
                "code": "[5463,2194,2386][y+t*9&7]&1<<x-1"
              },
              {
                "name": "3D checker board",
                "comment": "3d checker board by @p_malin",
                "code": "(((x-8)/y+t*5)&1^1/y*8&1)*y/5"
              },
              {
                "name": "Sticky blood",
                "comment": "sticky blood by @joeytwiddle",
                "code": "y-t*3+9+3*cos(x*3-t)-5*sin(x*7)"
              },
              {
                "name": "3D starfield",
                "comment": "3d starfield by @p_malin",
                "code": "d=y*y%5.9+1,!((x+t*50/d)&15)/d"
              },
              {
                "name": "Dialogue with an alien",
                "comment": "dialogue with an alien by @chiptune",
                "code": "1/32*tan(t/64*x*tan(i-x))"
              },
              {
                "name": "Space invader",
                "comment": "space invader by @keithclarkcouk + @zozuar",
                "code": "'p}¶¼<¼¶}p'.charCodeAt(x)&2**y"
              },
              {
                "name": "Hungry pac man",
                "comment": "hungry pac man by @p_malin and @aemkei",
                "code": "hypot(x-=t%4*5,y-=8)<6&&x<y|y<-x"
              },
              {
                "name": "Spectrum analyser",
                "comment": "spectrum analyser by @joeytwiddle",
                "code": "x&y<9&y>4+sin(8*t+x*x)+x/4"
              },
              {
                "name": "Diagonals",
                "comment": "diagonals",
                "code": "y == x || -(15-x == y)"
              },
              {
                "name": "Frame",
                "comment": "frame",
                "code": "x==0 | x==15 | y==0 | y==15"
              },
              {
                "name": "Drop",
                "comment": "drop",
                "code": "8*t%13 - hypot(x-7.5, y-7.5)"
              },
              {
                "name": "Rotation",
                "comment": "rotation",
                "code": "sin(2*atan((y-7.5)/(x-7.5))+5*t)"
              },
              {
                "name": "Wipe",
                "comment": "wipe",
                "code": "(x-y) - sin(t) * 16"
              },
              {
                "name": "Soft wipe",
                "comment": "soft wipe",
                "code": "(x-y)/24 - sin(t)"
              },
              {
                "name": "Disco",
                "comment": "disco",
                "code": "sin(t*5) * tan(t*7)"
              },
              {
                "name": "The 32 character limit",
                "comment": "input is limited to 32 characters!",
                "code": "(x-5)**2 + (y-5)**2 - 99*sin(t)"
              },
              {
                "name": "Your own",
                "comment": "now type your own",
                "code": "'HAVE FUN!'"
              }
            ]
          },
          {
            "socketType": "in",
            "name": "Column Meta",
            "dataType": "{\"class\":\"JSONType\"}",
            "data": {},
            "visible": false
          },
          {
            "socketType": "out",
            "name": "JSON Array",
            "dataType": "{\"class\":\"JSONArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Selected Row",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":10000,\"stepSize\":1,\"showDetails\":false,\"presetValues\":[]}}",
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Selected Column",
            "dataType": "{\"class\":\"StringType\"}",
            "visible": false
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "One row per example: name is what the menu shows, comment appears above the code. Edits here are saved with the app."
      },
      {
        "id": "ai-node-15",
        "name": "Example names",
        "type": "customfunction",
        "x": 2000,
        "y": 2477,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(rows, link) => {\n  const names = (Array.isArray(rows) ? rows : [])\n    .map((row) => String(row?.name ?? '').trim())\n    .filter(Boolean);\n  // a shared link's code gets its own entry at the top\n  return link?.code ? ['From the link', ...names] : names;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "rows",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "link",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "The menu lists every row that has a name."
      },
      {
        "id": "ai-node-3",
        "name": "Examples",
        "type": "widgetdropdown",
        "x": 2300,
        "y": 2477,
        "width": 250,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Fallback Option",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "",
            "visible": false
          },
          {
            "socketType": "in",
