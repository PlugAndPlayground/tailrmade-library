{
  "id": "Default/Tixy",
  "location": "Default",
  "name": "Tixy",
  "access": "private",
  "graphData": {
    "version": 12,
    "graphSettings": {
      "showExecutionVisualisation": true,
      "viewportCenterPosition": {
        "x": -953,
        "y": 4428
      },
      "viewportScale": 0.056,
      "defaultUISurfaceNodeId": "ai-node-12",
      "theme": {
        "mode": "dark"
      }
    },
    "overlay": {
      "dashboard": {
        "visible": true,
        "fullscreen": false,
        "maximized": false,
        "widthPercentage": 52,
        "locked": false
      }
    },
    "nodes": [
      {
        "id": "ai-node-1",
        "name": "Start here",
        "type": "label",
        "x": 0,
        "y": 0,
        "width": 3305,
        "height": 285,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Width",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":0,\"maxValue\":1280,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Input",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "A remake of tixy.land by Martin Kleppe.\nFollow the numbers: a shared link can set the code and look, the examples come from the table in section 2,\nthe code is checked, run for all 256 dots 30 times a second, and a shader draws it. Section 6 builds the share link."
          },
          {
            "socketType": "in",
            "name": "Font size",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":100,\"stepSize\":1,\"showDetails\":false,\"presetValues\":[{\"text\":\"Small\",\"value\":12},{\"text\":\"Normal\",\"value\":16},{\"text\":\"H5\",\"value\":20},{\"text\":\"H4\",\"value\":24},{\"text\":\"H3\",\"value\":28},{\"text\":\"H2\",\"value\":32},{\"text\":\"H1\",\"value\":40}]}}",
            "data": 64,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Text alignment",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Left\",\"value\":\"left\"},{\"text\":\"Center\",\"value\":\"center\"},{\"text\":\"Right\",\"value\":\"right\"}],\"showAsButtons\":true}}",
            "data": "Left",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Font weight",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"Regular\",\"value\":\"400\"},{\"text\":\"Bold\",\"value\":\"700\"}],\"showAsButtons\":true}}",
            "data": "Regular",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Text color",
            "dataType": "{\"class\":\"ColorType\"}",
            "data": {
              "r": 12,
              "g": 12,
              "b": 12,
              "a": 1
            },
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Background color",
            "dataType": "{\"class\":\"ColorType\"}",
            "data": {
              "r": 255,
              "g": 255,
              "b": 255,
              "a": 1
            },
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Output",
            "dataType": "{\"class\":\"StringType\"}",
            "visible": false
          },
          {
            "socketType": "out",
            "name": "ReactUI",
            "dataType": "{\"class\":\"DeferredReactType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        }
      },
      {
        "id": "ai-node-23",
        "name": "Read the link",
        "type": "urlparameter",
        "x": 0,
        "y": 805,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": ""
          },
          {
            "socketType": "in",
            "name": "Default",
            "dataType": "{\"class\":\"AnyType\"}",
            "data": ""
          },
          {
            "socketType": "out",
            "name": "Value",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "out",
            "name": "Found",
            "dataType": "{\"class\":\"BooleanType\"}"
          },
          {
            "socketType": "out",
            "name": "App link",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "With no Key it returns every parameter after # (or ?) in the address, e.g. #code=sin(t)&shape=Ring."
      },
      {
        "id": "ai-node-24",
        "name": "Settings from the link",
        "type": "customfunction",
        "x": 300,
        "y": 805,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(params) => {\n  // what a link without these parameters gets\n  const DEFAULTS = {\"background\": {\"r\": 16, \"g\": 18, \"b\": 38, \"a\": 1}, \"positive\": {\"r\": 255, \"g\": 196, \"b\": 0, \"a\": 1}, \"negative\": {\"r\": 0, \"g\": 190, \"b\": 255, \"a\": 1}};\n  const p = params && typeof params === 'object' ? params : {};\n  const one = (v) => (Array.isArray(v) ? v[v.length - 1] : v);\n  const pick = (v, options, fallback) => (options.includes(one(v)) ? one(v) : fallback);\n  const code = String(one(p.code) ?? '').trim();\n  const hex = (h, fallback) => {\n    const m = /^([0-9a-f]{6})$/i.exec(String(h ?? ''));\n    if (!m) return fallback;\n    const n = parseInt(m[1], 16);\n    return { r: n >> 16, g: (n >> 8) & 255, b: n & 255, a: 1 };\n  };\n  const palette = String(one(p.palette) ?? '').split('-');\n  return {\n    code,\n    example: code ? 'From the link' : \"Basics: skip Math.\",\n    shape: pick(p.shape, ['Circle', 'Square', 'Diamond', 'Ring'], 'Circle'),\n    colours: pick(p.colours, ['Theme', 'Tixy classic', 'Custom'], 'Theme'),\n    background: hex(palette[0], DEFAULTS.background),\n    positive: hex(palette[1], DEFAULTS.positive),\n    negative: hex(palette[2], DEFAULTS.negative),\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "params",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Anything missing or unknown in the link falls back to the normal opening: the ripple example, circles, theme colours."
      },
