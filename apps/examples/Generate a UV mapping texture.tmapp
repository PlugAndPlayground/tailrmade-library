      {
        "id": "ai-node-5",
        "name": "Draw texture",
        "type": "customfunction",
        "x": 640,
        "y": 1863,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(tiles, palette, size) => {\n  const n = Math.max(2, Math.min(16, Math.round(tiles) || 8));\n  const px = Math.max(256, Math.min(4096, Math.round(size) || 1024));\n  const canvas = document.createElement('canvas');\n  canvas.width = px;\n  canvas.height = px;\n  const ctx = canvas.getContext('2d');\n  const tile = px / n;\n  // Hue changes across and lightness down, so no two tiles look alike.\n  const color = (col, row) => {\n    const t = row / (n - 1);\n    if (palette === 'Grey') return `hsl(0 0% ${(col + row) % 2 ? 72 - 20 * t : 52 - 20 * t}%)`;\n    if (palette === 'Pastel') return `hsl(${(360 * col) / n} 70% ${86 - 14 * t}%)`;\n    return `hsl(${(360 * col) / n} 75% ${64 - 24 * t}%)`;\n  };\n  const letters = 'ABCDEFGHIJKLMNOP';\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.font = `bold ${Math.round(tile * 0.3)}px sans-serif`;\n  ctx.lineJoin = 'round';\n  for (let row = 0; row < n; row += 1) {\n    for (let col = 0; col < n; col += 1) {\n      const x = col * tile;\n      const y = row * tile;\n      ctx.fillStyle = color(col, row);\n      ctx.fillRect(x, y, tile, tile);\n      // A 2 x 2 checker inside each tile shows where the texture stretches.\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.12)';\n      ctx.fillRect(x + tile / 2, y, tile / 2, tile / 2);\n      ctx.fillRect(x, y + tile / 2, tile / 2, tile / 2);\n      ctx.strokeStyle = 'rgba(0, 0, 0, 0.35)';\n      ctx.lineWidth = Math.max(1, px / 1024);\n      ctx.strokeRect(x, y, tile, tile);\n      // A1 sits bottom left, where UV coordinates start. Mirrored text shows a flipped face.\n      const label = `${letters[col]}${n - row}`;\n      ctx.lineWidth = tile * 0.06;\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.9)';\n      ctx.strokeText(label, x + tile / 2, y + tile / 2);\n      ctx.fillStyle = '#111111';\n      ctx.fillText(label, x + tile / 2, y + tile / 2);\n    }\n  }\n  return canvas.toDataURL('image/png');\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": true,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "tiles",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "palette",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "size",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Draws the checker on a canvas at the chosen size. Main Thread stays on: the sandbox has no canvas."
      },
