      {
        "id": "ai-node-10",
        "name": "Wrap the shape",
        "type": "customfunction",
        "x": 2080,
        "y": 2783,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(THREE, texture, shape) => {\n  // Waits for Load three.js; until then there is nothing to draw.\n  if (!THREE?.WebGLRenderer) return undefined;\n  // One canvas and one animation loop, however often the inputs change.\n  let canvas = window.__uvPreviewCanvas;\n  if (!canvas) {\n    const scene = new THREE.Scene();\n    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 20);\n    camera.position.set(0, 0, 3.6);\n    scene.add(new THREE.AmbientLight(0xffffff, 1.6));\n    const light = new THREE.DirectionalLight(0xffffff, 1.4);\n    light.position.set(2, 2, 3);\n    scene.add(light);\n    const material = new THREE.MeshStandardMaterial({ roughness: 0.8 });\n    const mesh = new THREE.Mesh(new THREE.BoxGeometry(1.4, 1.4, 1.4), material);\n    mesh.rotation.x = 0.45;\n    scene.add(mesh);\n    // Transparent, so the theme's card shows behind the shape.\n    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    renderer.setSize(480, 480, false);\n    canvas = renderer.domElement;\n    Object.assign(canvas.style, { display: 'block', width: '100%', height: 'auto', touchAction: 'none', cursor: 'grab' });\n    // Drag to turn the shape; left alone, it keeps turning slowly.\n    const drag = { active: false, x: 0, y: 0 };\n    canvas.addEventListener('pointerdown', (event) => {\n      drag.active = true;\n      drag.x = event.clientX;\n      drag.y = event.clientY;\n      canvas.setPointerCapture(event.pointerId);\n    });\n    canvas.addEventListener('pointermove', (event) => {\n      if (!drag.active) return;\n      mesh.rotation.y += (event.clientX - drag.x) * 0.01;\n      mesh.rotation.x += (event.clientY - drag.y) * 0.01;\n      drag.x = event.clientX;\n      drag.y = event.clientY;\n    });\n    canvas.addEventListener('pointerup', () => {\n      drag.active = false;\n    });\n    renderer.setAnimationLoop(() => {\n      if (!drag.active) mesh.rotation.y += 0.004;\n      renderer.render(scene, camera);\n    });\n    canvas.__scene = { mesh, material, shape: 'Cube', texture: '' };\n    window.__uvPreviewCanvas = canvas;\n  }\n  const state = canvas.__scene;\n  if (state.shape !== shape) {\n    state.mesh.geometry.dispose();\n    if (shape === 'Sphere') state.mesh.geometry = new THREE.SphereGeometry(1, 64, 32);\n    else if (shape === 'Torus') state.mesh.geometry = new THREE.TorusGeometry(0.85, 0.38, 48, 96);\n    else state.mesh.geometry = new THREE.BoxGeometry(1.4, 1.4, 1.4);\n    state.shape = shape;\n  }\n  if (texture && state.texture !== texture) {\n    const map = new THREE.TextureLoader().load(texture);\n    map.colorSpace = THREE.SRGBColorSpace;\n    map.anisotropy = 8;\n    if (state.material.map) state.material.map.dispose();\n    state.material.map = map;\n    state.material.needsUpdate = true;\n    state.texture = texture;\n  }\n  return canvas;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": true,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "THREE",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "texture",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "shape",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Keeps one three.js canvas and swaps the shape and texture in place. Main Thread stays on: three.js draws to a canvas, and neither the DOM nor the package reaches the sandbox."
