            "dataType": "{\"class\":\"JSONType\"}",
            "data": {
              "backgroundColor": "#050805",
              "color": "#33ff66",
              "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
              "fontSize": "13px",
              "lineHeight": 1.4,
              "padding": "16px",
              "borderRadius": "8px",
              "height": "62vh",
              "overflow": "hidden",
