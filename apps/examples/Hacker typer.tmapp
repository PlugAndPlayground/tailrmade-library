      {
        "id": "ai-node-1",
        "name": "Start here",
        "type": "constant_string",
        "x": 0,
        "y": 0,
        "width": 1841,
        "height": 193,
        "socketArray": [
          {
            "socketType": "in",
            "name": "String",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "Hacker typer: press any key and code pours onto the screen, like in the movies.\n1. The Any key node hears every key on the page. On a phone, the Hack button does the same job.\n2. Each key adds to Keys pressed. Times Characters per key, that says how much code to show.\n3. Show the typed code cuts Code to type at that point and keeps the last lines for the terminal. Paste your own code into Code to type.\n4. Secret keys: Alt three times opens Access granted, Caps Lock three times opens Access denied. Any other key closes it."
          },
          {
            "socketType": "out",
            "name": "String",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        }
      },
