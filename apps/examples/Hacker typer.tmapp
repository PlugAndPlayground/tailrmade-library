      {
        "id": "ai-node-9",
        "name": "Code to type",
        "type": "constant_string",
        "x": 1560,
        "y": 2888,
        "width": 1142,
        "height": 4436,
        "socketArray": [
          {
            "socketType": "in",
            "name": "String",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "/*\n * breach.c - mainframe access toolkit v4.2\n * \"if you can read this, you are already in\"\n */\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include \"firewall.h\"\n#include \"quantum_tunnel.h\"\n\n#define MAX_HOPS        7\n#define KEY_BITS        4096\n#define PAYLOAD_SIZE    0x2000\n#define MAGIC_COOKIE    0xDEADBEEF\n\ntypedef struct proxy_node {\n    uint32_t addr;\n    uint16_t port;\n    uint8_t  latency_ms;\n    struct proxy_node *next;\n} proxy_node_t;\n\nstatic proxy_node_t *chain_head = NULL;\nstatic uint8_t session_key[KEY_BITS / 8];\n\nstatic int bounce_signal(proxy_node_t *node, const uint8_t *buf, size_t len)\n{\n    int hops = 0;\n    while (node && hops < MAX_HOPS) {\n        if (firewall_probe(node->addr, node->port) != FW_OPEN) {\n            node = node->next;\n            continue;\n        }\n        tunnel_send(node->addr, node->port, buf, len);\n        node = node->next;\n        hops++;\n    }\n    return hops;\n}\n\nstatic void scramble_key(uint8_t *key, size_t len, uint32_t seed)\n{\n    for (size_t i = 0; i < len; i++) {\n        seed ^= seed << 13;\n        seed ^= seed >> 17;\n        seed ^= seed << 5;\n        key[i] ^= (uint8_t)(seed & 0xFF);\n    }\n}\n\nint crack_password_hash(const char *hash, char *out, size_t out_len)\n{\n    static const char alphabet[] =\n        \"abcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*\";\n    size_t n = strlen(alphabet);\n    char guess[16] = \"\";\n\n    for (size_t len = 1; len < sizeof(guess); len++) {\n        for (uint64_t i = 0; i < ipow(n, len); i++) {\n            make_guess(guess, len, i, alphabet, n);\n            if (strcmp(sha256_hex(guess), hash) == 0) {\n                strncpy(out, guess, out_len);\n                return 1;\n            }\n        }\n    }\n    return 0;\n}\n\nstatic int download_the_internet(const char *target)\n{\n    uint8_t *payload = malloc(PAYLOAD_SIZE);\n    if (!payload)\n        return -1;\n\n    memset(payload, 0x90, PAYLOAD_SIZE);\n    *(uint32_t *)payload = MAGIC_COOKIE;\n    scramble_key(session_key, sizeof(session_key), MAGIC_COOKIE);\n\n    printf(\"[*] uploading payload to %s\\n\", target);\n    int hops = bounce_signal(chain_head, payload, PAYLOAD_SIZE);\n    printf(\"[+] signal bounced through %d proxies\\n\", hops);\n\n    free(payload);\n    return hops > 0 ? 0 : -1;\n}\n\nint enhance(image_t *img, int factor)\n{\n    /* zoom. enhance. zoom. enhance. */\n    for (int pass = 0; pass < factor; pass++) {\n        img = upscale(img, 2);\n        img = sharpen(img, 0.8f);\n    }\n    return img->width;\n}\n\nvoid reroute_mainframe(mainframe_t *mf)\n{\n    mf->gibson.firewall = FW_DISABLED;\n    mf->gibson.trace_level = 0;\n    for (int core = 0; core < mf->cores; core++) {\n        mf->core[core].owner = getuid();\n        mf->core[core].mode = MODE_GOD;\n    }\n    log_erase(mf->audit_log, LOG_ALL);\n}\n\nint main(int argc, char **argv)\n{\n    const char *target = argc > 1 ? argv[1] : \"mainframe.local\";\n    char password[32];\n\n    chain_head = proxy_chain_build(MAX_HOPS);\n    if (!crack_password_hash(fetch_shadow(target), password, sizeof(password))) {\n        fprintf(stderr, \"[-] hash resisted. trying harder\\n\");\n        return EXIT_FAILURE;\n    }\n\n    printf(\"[+] password: %s\\n\", password);\n    reroute_mainframe(mainframe_connect(target, password));\n    download_the_internet(target);\n    printf(\"[+] I'm in.\\n\");\n    return EXIT_SUCCESS;\n}\n\n"
          },
          {
            "socketType": "out",
            "name": "String",
            "dataType": "{\"class\":\"StringType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        }
      },
      {
        "id": "ai-node-10",
        "name": "Show the typed code",
        "type": "customfunction",
        "x": 2842,
        "y": 2888,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(code, chars) => {\n  const banner = [\n    'tailrmade@mainframe:~$ ./breach',\n    '[ok] loading exploit kit',\n    '[ok] spoofing MAC address',\n    '[ok] proxy chain: 7 hops',\n    '[ok] firewall: asleep',\n    '[..] waiting for the operator',\n    '',\n    'Press any key to hack.',\n    'On a phone, tap Hack.',\n    '',\n    '',\n  ].join('\\n');\n  const source = code && code.length ? code : '// Code to type is empty\\n';\n  const typed = Math.max(0, Math.floor(Number(chars) || 0));\n  const loops = Math.floor(typed / source.length);\n  // after two passes the banner is long gone, so two copies are enough\n  const text =\n    (loops > 1 ? '' : banner) +\n    source.repeat(Math.min(loops, 2)) +\n    source.slice(0, typed % source.length);\n  const lines = text.split('\\n').slice(-40).join('\\n');\n  return '```\\n' + lines + '█\\n```';\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "code",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "chars",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Starts again from the top when the code runs out, and keeps only the last lines so the newest code is always at the bottom."
      },
