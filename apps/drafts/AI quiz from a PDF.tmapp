      {
        "id": "ai-node-13",
        "name": "Prompt",
        "type": "customfunction",
        "x": 2520,
        "y": 1926,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(doc, level) => {\n  const levels = [\n    'Easy: facts the document states directly.',\n    'Medium: details, numbers and conditions.',\n    'Hard: combine facts from different pages, or apply a rule to a situation the document does not spell out.',\n  ];\n  const pages = Array.isArray(doc?.pages) ? doc.pages : [];\n  const body = pages.map((p) => `--- Page ${p.pageNumber} ---\\n${p.text}`).join('\\n\\n');\n  // Asking for JSON is what makes this an app and not a chat: the page turns it into buttons and a score.\n  return [\n    'Write a multiple-choice quiz about the document below.',\n    'Reply with JSON only, no Markdown fences, in exactly this shape:',\n    '{\"document\": \"<the document title exactly as given>\", \"questions\": [{\"question\": \"...\", \"choices\": [\"...\", \"...\", \"...\", \"...\"], \"answer\": 0, \"page\": 1, \"why\": \"...\"}]}',\n    'Rules:',\n    '- Exactly 5 questions, each answerable from the document alone.',\n    '- Exactly 4 choices per question, all plausible, of similar length, under 60 characters each. Exactly one is right.',\n    '- \"answer\" is the index (0-3) of the right choice. Vary its position between questions.',\n    '- \"page\" is the page the answer is on.',\n    '- \"why\" explains the answer in one sentence, close to the document\\'s own words.',\n    `- Difficulty: ${levels[Number(level)] ?? levels[1]}`,\n    '',\n    `Document title: ${doc?.title ?? ''}`,\n    '',\n    body,\n  ].join('\\n');\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "doc",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "level",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Asks for the quiz as JSON in a fixed shape. That is the trick of this app: the answer is data the page can use, not text to read."
      },
      {
        "id": "ai-node-14",
        "name": "Write the quiz",
        "type": "ainode",
        "x": 2820,
        "y": 1758,
        "width": 160,
        "height": 256,
        "socketArray": [
          {
            "socketType": "in",
