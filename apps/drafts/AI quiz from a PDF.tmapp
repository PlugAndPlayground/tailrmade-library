      {
        "id": "ai-node-16",
        "name": "Sample quiz",
        "type": "customfunction",
        "x": 3580,
        "y": 3186,
        "width": 160,
        "height": 64,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "() => ({\n  // Written by hand for the sample manual, so the page opens with a quiz to play before any AI is connected.\n  document: 'Model K-17 kettle manual',\n  madeBy: 'hand',\n  questions: [\n    { question: 'How much water does the kettle hold at most?', choices: ['1.0 litre', '1.5 litres', '1.7 litres', '2.0 litres'], answer: 2, page: 1, why: 'The MAX mark is at 1.7 litres.' },\n    { question: 'Your water is hard. How often should you descale the kettle?', choices: ['Every week', 'Every 4 weeks', 'Every 3 months', 'Once a year'], answer: 1, page: 2, why: 'Descale every 4 weeks if your water is hard, or every 3 months if it is soft.' },\n    { question: 'You switched the kettle on while it was empty and it turned off. What now?', choices: ['Fill it with cold water at once', 'Unplug the base for a day', 'Wait 10 minutes, then fill it', 'Descale it overnight'], answer: 2, page: 2, why: 'Dry-boil protection turned it off. Let it cool for 10 minutes before you fill it again.' },\n    { question: 'The kettle switches off before the water boils. What is the likely cause?', choices: ['The lid is open', 'It needs descaling', 'It is overfilled', 'The cable is too long'], answer: 1, page: 3, why: 'The troubleshooting list says the kettle needs descaling.' },\n    { question: 'Which of these does the warranty cover?', choices: ['Damage from dropping it', 'Damage from limescale', 'A fault in manufacturing', 'Using it on another base'], answer: 2, page: 3, why: 'It covers faults in materials and manufacturing, not drops, limescale or other bases.' },\n  ],\n})",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-17",
        "name": "Quiz to play",
        "type": "customfunction",
        "x": 3880,
        "y": 2802,
        "width": 160,
        "height": 160,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(response, content, sample, doc) => {\n  const read = () => {\n    if (content?.error) return { state: 'error', message: String(content.message ?? '') };\n    const text = String(response ?? '').trim();\n    if (!text) return { state: 'none' };\n    let data;\n    try {\n      // Models sometimes wrap JSON in fences or a sentence, so take the outermost object.\n      data = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1));\n    } catch (e) {\n      return { state: 'bad' };\n    }\n    const questions = (Array.isArray(data?.questions) ? data.questions : [])\n      .filter((q) => typeof q?.question === 'string' && Array.isArray(q.choices) && q.choices.length === 4)\n      .map((q) => ({\n        question: q.question.trim(),\n        choices: q.choices.map((c) => String(c).trim()),\n        answer: Number(q.answer),\n        page: Number(q.page) || null,\n        why: String(q.why ?? '').trim(),\n      }))\n      .filter((q) => Number.isInteger(q.answer) && q.answer >= 0 && q.answer < 4)\n      .slice(0, 8);\n    if (questions.length === 0) return { state: 'bad' };\n    // Play the AI's quiz only if it was made for the document on the page now.\n    if (String(data.document ?? '') !== doc?.title) return { state: 'other' };\n    return { state: 'ok', quiz: { madeBy: 'AI', questions } };\n  };\n  const ai = read();\n  const quiz = ai.quiz ?? (doc?.isSample ? sample : null);\n  const title = doc?.title ?? '';\n  if (!quiz) return { id: `none:${title}`, title, ai, madeBy: null, questions: [] };\n  // A short fingerprint of the questions tells this quiz's answers apart from earlier ones.\n  let hash = 5381;\n  for (const ch of quiz.questions.map((q) => q.question).join('|')) hash = ((hash * 33) ^ ch.charCodeAt(0)) >>> 0;\n  return { id: `q${hash.toString(36)}`, title, ai, madeBy: quiz.madeBy, questions: quiz.questions };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "response",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "content",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "sample",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "doc",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Checks the AI's reply before the page uses it: questions without 4 choices or a valid answer are dropped, and a quiz made for another document is ignored."
      },
      {
        "id": "ai-node-18",
        "name": "Quiz status",
        "type": "customfunction",
        "x": 4180,
        "y": 2802,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(quiz, doc) => {\n  const made = quiz?.ai ?? {};\n  const escape = (s) => String(s).replace(/[\\\\`*_{}\\[\\]<>#|]/g, '\\\\$&');\n  const title = `*${escape(doc?.title ?? 'the document')}*`;\n  if (made.state === 'error') {\n    // Turn the errors a first-time visitor will hit into the step that fixes them.\n    const message = String(made.message ?? '');\n    const key = (message.match(/[A-Z]+_API_KEY/) ?? [])[0];\n    if (key) return `**The Companion has no ${key} yet.**\\nOpen the Companion's **Settings**, add your key as ${key} and try again, or pick a provider you have a key for.`;\n    if (/logged in/i.test(message)) return \"**AI isn't connected yet.**\\nSign in, or use your own key through the Companion. See **Connect AI** below.\";\n    if (/fetch|network|load failed|refused/i.test(message)) return \"**Couldn't reach the Tailrmade Companion on this computer.**\\nStart the Companion, or sign in to Tailrmade. See **Connect AI** below.\";\n    if (/token|limit|quota/i.test(message)) return \"**Today's AI allowance is used up.**\\nTry again tomorrow, or use your own key through the Companion. See **Connect AI** below.\";\n    return `**The AI request failed.**\\n${escape(message)}`;\n  }\n  if (made.state === 'bad') return \"**The AI's reply wasn't a quiz this time.** Press **Make a quiz** to try again.\";\n  if (quiz?.madeBy === 'AI') return `[New quiz ready.]{.success} ${quiz.questions.length} questions on ${title}, written by AI. Press **Make a quiz** for another one.`;\n  if (quiz?.madeBy === 'hand') return 'The quiz above was written by hand. Press **Make a quiz** and an AI writes a new one at the level you pick. It takes 10 to 30 seconds.';\n  return `Press **Make a quiz** to turn ${title} into a quiz. It takes 10 to 30 seconds.`;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "quiz",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "doc",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Also turns the AI node's errors into the step that fixes them, because a first visit usually has no AI connected yet."
      },
      {
        "id": "ai-node-19",
        "name": "Status text",
        "type": "text",
        "x": 4480,
        "y": 2802,
        "width": 240,
        "height": 80,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Content",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "in",
            "name": "Variant",
            "dataType": "{\"class\":\"EnumType\",\"type\":{\"options\":[{\"text\":\"display\",\"value\":\"display\"},{\"text\":\"h1\",\"value\":\"h1\"},{\"text\":\"h2\",\"value\":\"h2\"},{\"text\":\"h3\",\"value\":\"h3\"},{\"text\":\"body\",\"value\":\"body\"},{\"text\":\"caption\",\"value\":\"caption\"},{\"text\":\"label\",\"value\":\"label\"},{\"text\":\"stat\",\"value\":\"stat\"}],\"showAsButtons\":false}}",
            "data": "body",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Tone",
