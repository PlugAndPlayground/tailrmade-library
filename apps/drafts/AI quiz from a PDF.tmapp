      {
        "id": "ai-node-29",
        "name": "Read presses",
        "type": "stateread",
        "x": 5020,
        "y": 4034,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "AI quiz from a PDF: presses"
          },
          {
            "socketType": "in",
            "name": "Fallback value",
            "dataType": "{\"class\":\"ArrayType\"}",
            "data": []
          },
          {
            "socketType": "out",
            "name": "Value",
            "dataType": "{\"class\":\"AnyType\"}"
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "comment": "Presses go out through Save presses and come back here, with no link between them. A link would make a loop: the buttons show the current question, which depends on the presses, which depend on the buttons."
      },
      {
        "id": "ai-node-44",
        "name": "Add press",
        "type": "customfunction",
        "x": 6640,
        "y": 3850,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(presses, down) => {\n  // The list with the buttons that are down added. Save presses stores it only when Press signal fires.\n  const list = Array.isArray(presses) ? presses : [];\n  return [...list, ...(Array.isArray(down) ? down : [])].slice(-200);\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "presses",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "down",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-25",
        "name": "Press signal",
        "type": "customfunction",
        "x": 6940,
        "y": 3850,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(next, down) => {\n  // Changes whenever a button goes down, so Save presses fires once for each press, even a quick one.\n  // It is empty when no button is down, which is also its saved value, so it does not fire on load.\n  // next is wired only so this runs after Add press has its new list ready.\n  const list = Array.isArray(down) ? down : [];\n  return list.length ? list.map((p) => `${p.question ?? ''}#${p.pick}`).join('|') : null;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "next",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "down",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"AnyType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-26",
        "name": "Save presses",
        "type": "statewrite",
        "x": 7240,
        "y": 3850,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "AI quiz from a PDF: presses"
          },
          {
            "socketType": "in",
            "name": "Value",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "trigger",
            "name": "Execute",
            "dataType": "{\"class\":\"TriggerType\",\"type\":{\"triggerType\":\"change\",\"customFunctionString\":\"\",\"showDetails\":false}}"
          }
        ],
        "updateBehaviour": {
          "load": false,
          "update": false,
          "interval": false
        }
      },
      {
        "id": "ai-node-30",
        "name": "Current question",
        "type": "customfunction",
        "x": 5360,
        "y": 3850,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(quiz, picks) => {\n  // Presses are never cleared. A press counts when it answers the question being asked, so a new quiz\n  // starts fresh by itself, and Start over (pick 4) starts this one again.\n  const questions = Array.isArray(quiz?.questions) ? quiz.questions : [];\n  let answers = [];\n  for (const p of Array.isArray(picks) ? picks : []) {\n    if (p?.pick === 4) answers = [];\n    else if (answers.length < questions.length && p?.question === questions[answers.length].question) answers.push(p.pick);\n  }\n  const index = answers.length;\n  return {\n    total: questions.length,\n    index,\n    answers,\n    done: questions.length > 0 && index >= questions.length,\n    question: questions[index] ?? null,\n    right: answers.filter((p, i) => p === questions[i].answer).length,\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "quiz",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "picks",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-31",
        "name": "Choice A label",
        "type": "customfunction",
        "x": 5660,
