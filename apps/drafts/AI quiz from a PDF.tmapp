      {
        "id": "ai-node-3",
        "name": "Newest PDF",
        "type": "customfunction",
        "x": 300,
        "y": 878,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(files) => {\n  // Every drop adds a file; the newest one is the one to ask about.\n  const list = Array.isArray(files) ? files.filter(Boolean) : [];\n  return list.length > 0 ? String(list[list.length - 1]) : '';\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "files",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-4",
        "name": "Read the PDF",
        "type": "pdfreader",
        "x": 600,
        "y": 878,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "PDF File",
            "dataType": "{\"class\":\"FileType\",\"type\":{\"filterExtensions\":[\"pdf\"]}}"
          },
          {
            "socketType": "in",
            "name": "Start Page",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":100,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 1,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "End Page",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":true,\"minValue\":1,\"maxValue\":100,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Page Scale",
            "dataType": "{\"class\":\"NumberType\",\"type\":{\"round\":false,\"minValue\":0.1,\"maxValue\":5,\"stepSize\":0.01,\"showDetails\":false,\"presetValues\":[]}}",
            "data": 0.1,
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Pages",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Metadata",
            "dataType": "{\"class\":\"JSONType\"}",
            "visible": false
          },
          {
            "socketType": "out",
            "name": "Outline",
            "dataType": "{\"class\":\"JSONType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": false,
          "update": true,
          "interval": false
        },
        "comment": "Turns the PDF into text, one entry per page. It also draws a picture of each page, which this app does not use, so Page Scale is as small as it goes."
      },
      {
        "id": "ai-node-5",
        "name": "Sample manual",
        "type": "customfunction",
        "x": 0,
        "y": 1094,
        "width": 160,
        "height": 64,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "() => {\n  // Shown until a PDF is dropped, so the page opens with something to ask.\n  // A PDF can't ship inside an app file, so the sample is text in the same shape the PDF Reader returns.\n  const pages = [\n    [\n      'Model K-17 electric kettle, 1.7 litres',\n      'User manual',\n      'Safety',\n      'Only use the kettle with the base it came with. Place the base on a dry, flat surface away from the edge of the counter.',\n      'Never fill the kettle above the MAX mark (1.7 litres) or below the MIN mark (0.5 litres). Overfilled kettles can spit boiling water.',\n      'Do not open the lid while the water is boiling. Lift the kettle off the base before filling it, never fill it from a tap while it stands on the base.',\n      'Children under 8 should not use the kettle. Keep the kettle and its cable out of their reach.',\n      'Parts',\n      '1. Lid with release button  2. Limescale filter (removable)  3. Water window with MIN and MAX marks  4. On/off switch with light  5. Power base with 75 cm cable',\n    ],\n    [\n      'Using the kettle',\n      'Before the first use, boil a full kettle twice and pour the water away.',\n      'Fill the kettle, close the lid until it clicks and press the switch down. The light comes on. The kettle switches off by itself when the water boils, after about 4 minutes for a full kettle.',\n      'If you switch the kettle on while it is empty, the dry-boil protection turns it off. Let it cool for 10 minutes before you fill it again.',\n      'Cleaning',\n      'Unplug the base and let the kettle cool. Wipe the outside with a damp cloth. Never put the kettle or the base in water or in a dishwasher.',\n      'Rinse the limescale filter under the tap once a week.',\n      'Descaling',\n      'Descale the kettle every 4 weeks if your water is hard, or every 3 months if it is soft. Limescale makes the kettle slower and louder.',\n      'Fill the kettle to the MIN mark with a mix of half water and half white vinegar, or use 2 tablespoons of citric acid in 0.5 litres of water. Boil it, then leave it to stand overnight.',\n      'In the morning, pour it away and boil clean water twice, pouring it away each time.',\n    ],\n    [\n      'Troubleshooting',\n      'The kettle does not switch on: check that it sits fully on the base and that the lid is closed. Dry-boil protection may still be active, so wait 10 minutes.',\n      'The kettle switches off before the water boils: the kettle needs descaling (see page 2).',\n      'White flakes float in the water: this is limescale. It is harmless. Descale the kettle and clean the filter.',\n      'Water leaks from the bottom: stop using the kettle and contact customer service.',\n      'Warranty',\n      'The kettle has a 2-year warranty from the date of purchase. Keep your receipt.',\n      'The warranty covers faults in materials and manufacturing. It does not cover damage from dropping the kettle, from limescale, from using it with another base, or from repairs by anyone other than our service partners.',\n      'Disposal',\n      'Do not put the kettle in household waste. Take it to a collection point for electrical appliances.',\n    ],\n  ];\n  return {\n    title: 'Model K-17 kettle manual',\n    isSample: true,\n    totalPages: pages.length,\n    sentPages: pages.length,\n    pages: pages.map((lines, i) => ({ pageNumber: i + 1, text: lines.join('\\n') })),\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-6",
        "name": "Document to ask",
        "type": "customfunction",
        "x": 900,
        "y": 878,
        "width": 160,
        "height": 136,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(pages, info, sample) => {\n  const read = Array.isArray(pages) ? pages : [];\n  if (read.length === 0) return sample;\n  const files = Array.isArray(info) ? info : [];\n  const name = String(files[files.length - 1]?.name ?? 'Your PDF');\n  // About 120,000 characters (roughly 30,000 tokens) goes in one question; longer PDFs send their first pages.\n  const limit = 120000;\n  let used = 0;\n  const kept = [];\n  for (const page of read) {\n    const text = String(page?.text ?? '');\n    if (kept.length > 0 && used + text.length > limit) break;\n    kept.push({ pageNumber: page.pageNumber, text: text.slice(0, limit) });\n    used += text.length;\n  }\n  return {\n    title: name.replace(/\\.pdf$/i, ''),\n    isSample: false,\n    totalPages: read.length,\n    sentPages: kept.length,\n    pages: kept,\n  };\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "pages",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "info",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "in",
            "name": "sample",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3,
        "comment": "Uses the dropped PDF once it has pages, otherwise the sample. Long PDFs are cut to their first pages so they fit in one AI request."
      },
      {
        "id": "ai-node-7",
        "name": "Document summary",
        "type": "customfunction",
        "x": 1200,
        "y": 878,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(doc) => {\n  const pages = Array.isArray(doc?.pages) ? doc.pages : [];\n  const escape = (s) => String(s).replace(/[\\\\`*_{}\\[\\]<>#|]/g, '\\\\$&');\n  const words = pages.reduce((n, p) => n + (String(p.text).match(/\\S+/g) ?? []).length, 0);\n  const group = (n) => String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n  const total = Number(doc?.totalPages) || pages.length;\n  const lines = [\n    `**${escape(doc?.title ?? '')}**`,\n    `[${total} page${total === 1 ? '' : 's'} · ${group(words)} words]{.muted}`,\n  ];\n  if (doc?.isSample) {\n    lines.push('A sample manual written for this example. Drop a PDF above to be quizzed on your own.');\n  } else if (words === 0) {\n    lines.push('[This PDF has no text to read, probably because it is a scan.]{.warning}');\n  } else if (doc.sentPages < total) {\n    lines.push(`[Only the first ${doc.sentPages} of ${total} pages fit in one question.]{.warning}`);\n  }\n  return lines.join('\\n');\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "doc",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
      {
        "id": "ai-node-8",
