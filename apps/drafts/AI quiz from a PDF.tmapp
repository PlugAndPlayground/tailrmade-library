      {
        "id": "ai-node-36",
        "name": "Quiz card",
        "type": "customfunction",
        "x": 5660,
        "y": 4858,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(quiz, current) => {\n  const escape = (s) => String(s).replace(/[\\\\`*_{}\\[\\]<>#|]/g, '\\\\$&');\n  const questions = Array.isArray(quiz?.questions) ? quiz.questions : [];\n  if (questions.length === 0) return `No quiz for *${escape(quiz?.title ?? 'this document')}* yet. Make one below.`;\n  const list = current.answers;\n  const page = (q) => (q.page ? ` [(p. ${q.page})]{.secondary}` : '');\n  const verdict = (q, pick) =>\n    pick === q.answer\n      ? `[✓ Right:]{.success} ${escape(q.choices[q.answer])}.`\n      : `[✗ Not quite.]{.error} You picked ${escape(q.choices[pick] ?? '?')}. It's ${escape(q.choices[q.answer])}.`;\n  if (current.done) {\n    const lines = [`**You got ${current.right} of ${current.total} right.**`];\n    questions.forEach((q, i) => {\n      lines.push(`${i + 1}. ${escape(q.question)}`);\n      lines.push(`${verdict(q, list[i])} ${escape(q.why)}${page(q)}`);\n    });\n    lines.push('[Press Start over to try again, or make a new quiz below.]{.muted}');\n    return lines.join('\\n');\n  }\n  const lines = [`[Question ${current.index + 1} of ${current.total} · ${current.right} right so far]{.muted}`];\n  if (current.index > 0) {\n    // Feedback for the answer just given sits above the next question.\n    const prev = questions[current.index - 1];\n    lines.push(`${verdict(prev, list[current.index - 1])} ${escape(prev.why)}${page(prev)}`);\n  }\n  lines.push(`**${escape(current.question.question)}**`);\n  return lines.join('\\n');\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "quiz",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "in",
            "name": "current",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"StringType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
