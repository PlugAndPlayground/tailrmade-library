            "dataType": "{\"class\":\"JSONType\"}"
          }
        ],
        "updateBehaviour": {
          "load": false,
          "update": false,
          "interval": false
        },
        "version": 2,
        "comment": "Runs only when Make a quiz is pressed. Where it goes depends on the AI setting: Tailrmade's cloud when signed in, or the Companion on this computer with your own key. The key never appears in this app."
      },
      {
        "id": "ai-node-15",
        "name": "Save AI reply text",
        "type": "statewrite",
        "x": 3120,
        "y": 1758,
        "width": 160,
        "height": 112,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Key",
            "dataType": "{\"class\":\"StringType\"}",
            "data": "AI quiz from a PDF: reply text"
          },
          {
            "socketType": "in",
