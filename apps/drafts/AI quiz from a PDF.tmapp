      {
        "id": "ai-node-10",
        "name": "Provider buttons",
        "type": "widgetbuttongroup",
        "x": 2040,
        "y": 1928,
        "width": 340,
        "height": 90,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Button Options",
            "dataType": "{\"class\":\"ArrayType\"}",
            "data": [
              "Anthropic",
              "Google",
              "OpenAI"
            ],
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Toggle Mode",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": true,
            "visible": false
          },
