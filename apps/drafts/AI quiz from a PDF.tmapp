            "dataType": "{\"class\":\"JSONType\"}",
            "data": {
              "max_tokens": 2500
            }
          },
          {
            "socketType": "in",
            "name": "Images",
            "dataType": "{\"class\":\"ArrayType\"}",
            "data": []
          },
          {
            "socketType": "in",
            "name": "Persistant conversation",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "trigger",
            "name": "Trigger 1",
            "dataType": "{\"class\":\"TriggerType\"}"
          },
          {
            "socketType": "out",
