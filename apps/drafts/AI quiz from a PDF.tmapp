      {
        "id": "ai-node-35",
        "name": "Show answer buttons",
        "type": "customfunction",
        "x": 5660,
        "y": 4690,
        "width": 160,
        "height": 88,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(current) => Boolean(current?.question) && !current.done",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "current",
            "dataType": "{\"class\":\"JSONType\"}"
          },
          {
