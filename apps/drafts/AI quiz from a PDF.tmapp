      {
        "id": "ai-node-24",
        "name": "Pressed answer",
        "type": "customfunction",
        "x": 6340,
        "y": 3850,
        "width": 160,
        "height": 184,
        "socketArray": [
          {
            "socketType": "in",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "data": "(a, b, c, d, restart) => {\n  // While pressed, an answer button sends the question it answers, and 0 after; Start over sends 'restart'.\n  // A quick second press can arrive while the last button is still down, so this lists every button that is down.\n  // Current question ignores presses that don't answer the question being asked, so extras do no harm.\n  const down = [a, b, c, d]\n    .map((v, pick) => (typeof v === 'string' && v !== '' ? { question: v, pick } : null))\n    .filter(Boolean);\n  if (restart === 'restart') down.push({ pick: 4 });\n  return down;\n}",
            "visible": false
          },
          {
            "socketType": "in",
            "name": "Main Thread",
            "dataType": "{\"class\":\"BooleanType\"}",
            "data": false,
            "visible": false
          },
          {
            "socketType": "in",
            "name": "a",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "b",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "c",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "d",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "in",
            "name": "restart",
            "dataType": "{\"class\":\"NumberType\"}"
          },
          {
            "socketType": "out",
            "name": "OutData",
            "dataType": "{\"class\":\"ArrayType\"}"
          },
          {
            "socketType": "out",
            "name": "Code",
            "dataType": "{\"class\":\"CodeType\"}",
            "visible": false
          }
        ],
        "updateBehaviour": {
          "load": true,
          "update": true,
          "interval": false
        },
        "version": 3
      },
